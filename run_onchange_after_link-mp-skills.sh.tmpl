#!/bin/bash
{{- if .claudecfg }}
# Link a curated subset of Matt Pocock's skills into ~/.claude/skills.
#
# The clone itself is a chezmoi external (see .chezmoiexternal.toml); this script
# only makes the symlinks. Links, not copies, so the `git pull` that refreshes the
# external moves every skill with it.
#
# Why a subset. His promoted set is 25. Four are skipped because they collide with
# what this machine already has: `wayfinder`, `to-tickets`, `to-spec` and
# `implement` duplicate the wf map spine (which ships from the wf package, see
# run_onchange_after_link-wf-skills.sh), and `code-review` collides by name with
# Claude Code's own built-in skill of that name. From misc/ only the git guardrails
# are taken; in-progress/ is unshipped upstream and left alone.
#
# Not managed files. The targets point inside the external's clone, which is not
# this repo's business, and chezmoi would report drift on them forever. Same call
# as the wf link script, for the same reason.
#
# Do NOT replace this with upstream's scripts/link-skills.sh. That script `rm -rf`s
# any non-symlink sitting in a target path, links every bucket including the
# unshipped ones, and its own header says it is unsupported and will not take
# modifications.

set -euo pipefail

REPO="$HOME/.claude/mp-skills"
DEST="$HOME/.claude/skills"

if [ ! -d "$REPO/skills" ]; then
    echo "mp-skills clone is not present yet, skipping its links (chezmoi apply -R fetches it)"
    exit 0
fi

ENGINEERING="ask-matt codebase-design diagnosing-bugs domain-modeling grill-with-docs
             improve-codebase-architecture prototype research resolving-merge-conflicts
             setup-matt-pocock-skills tdd triage wizard"
PRODUCTIVITY="grill-me grilling handoff teach to-questionnaire wait-what writing-for-agents"
MISC="git-guardrails-claude-code"

mkdir -p "$DEST"
linked=0
blocked=()

link_bucket() {
    local bucket=$1; shift
    for name in "$@"; do
        local src="$REPO/skills/$bucket/$name"
        local target="$DEST/$name"
        if [ ! -f "$src/SKILL.md" ]; then
            blocked+=("$name (gone from upstream $bucket/)")
            continue
        fi
        # Never clobber a real directory: that is either a hand-written skill of
        # ours or a leftover, and deleting it silently is how work disappears.
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            blocked+=("$name (a real directory is in the way)")
            continue
        fi
        ln -sfn "../mp-skills/skills/$bucket/$name" "$target"
        linked=$((linked + 1))
    done
}

link_bucket engineering $ENGINEERING
link_bucket productivity $PRODUCTIVITY
link_bucket misc $MISC

echo "mp-skills: linked $linked skills into ~/.claude/skills"

if [ ${#blocked[@]} -gt 0 ]; then
    echo
    echo "Not linked:"
    printf '  %s\n' "${blocked[@]}"
    echo
    echo "A skill blocked by a real directory needs a decision, not an rm: check"
    echo "whether it is one of ours before removing it."
fi
{{- else }}
# No-op: chezmoi does not own ~/.claude on this machine (claudecfg=false), so
# linking into it would write this machine's paths through a bind mount onto the
# host's real config. See run_onchange_after_link-wf-skills.sh for the full
# reasoning.
exit 0
{{- end }}
