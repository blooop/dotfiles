#!/bin/bash
{{ if .heavy -}}
# Configure devpod to use dotfiles
# Only runs on profiles that install devpod (.heavy), not within devpod environments

if command -v devpod >/dev/null 2>&1; then
    devpod context set-options \
        -o DOTFILES_URL=https://github.com/blooop/dotfiles
    echo "Configured devpod dotfiles context"
else
    echo "devpod not found, skipping configuration"
fi
{{ else -}}
# Skipping devpod configuration (profile: {{ .profile }}, no heavy toolchain)
{{ end -}}
