" Enable relative line numbers
set relativenumber
set number

" Install vim-plug if not already installed
let data_dir = has('nvim') ? stdpath('data') . '/site' : '~/.vim'
if empty(glob(data_dir . '/autoload/plug.vim'))
  silent execute '!curl -fLo '.data_dir.'/autoload/plug.vim --create-dirs  https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

" Plugins
call plug#begin()
Plug 'tpope/vim-commentary'
call plug#end()

" VSCode-style comment toggle with Ctrl+/
" Note: In most terminals, Ctrl+/ is sent as Ctrl+_
nnoremap <C-_> :Commentary<CR>
vnoremap <C-_> :Commentary<CR>
inoremap <C-_> <Esc>:Commentary<CR>a


" Open a herdr scrollback dump at the bottom
"
" herdr's F5 writes the pane scrollback to /tmp/herdr-scrollback-*.txt and runs
" `${EDITOR:-vi} <file>` with no `+<line>`, so it opens on line 1 rather than at
" the output that was on screen. Zellij opened near the bottom; this restores
" that. The Neovim config carries the same autocmd, with the full reasoning.
augroup herdr_scrollback
  autocmd!
  autocmd BufReadPost *herdr-scrollback-* normal! G
augroup END
