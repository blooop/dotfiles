#!/bin/bash
# ~/.claude/settings.json is owned by two writers, and a plain managed file put
# them in a fight: Claude Code rewrites the file at runtime (switching model in
# the UI writes "model" back; /sync rewrites the lot), and every apply stomped
# those edits back to the committed copy, so chezmoi status showed the file
# permanently modified and somebody always lost. A modify_ script ends the fight
# by merging instead of replacing: chezmoi hands the target's current contents
# on stdin and takes the desired contents from stdout.
#
# Three tiers of key:
#   - MANAGED (env, attribution, hooks, statusLine): this repo's, enforced on
#     every apply. Editing them here changes every machine; deleting one here
#     leaves the old value in the target (a merge cannot see an absence), so a
#     genuine removal needs a one-off cleanup alongside the edit.
#   - DEFAULTS (model, theme, tui, and the other UI preferences): seeded when
#     the key is absent — a fresh machine comes up configured — and never
#     touched again, so a runtime change to any of them survives every apply.
#   - everything else: Claude Code's alone; passes through untouched.
#
# jq rather than python3, because jq is in the eight-env pixi floor on every
# profile and python3 is not (a devcontainer has none — that is why the old
# python status line died). The floor still syncs *after* the first apply of a
# fresh machine, hence the fallback: with no jq and an empty target, emit the
# composed fresh document (pure string assembly, no parser needed — MANAGED and
# DEFAULTS are disjoint); with no jq and a non-empty target, pass it through
# unchanged rather than fail the apply, and the next apply after the sync
# converges it.
#
# The merge preserves the TARGET's key order and appends only genuinely new
# keys, which is what makes an apply a no-op rather than a reformat. This was
# `jq -S` (sorted) for one day and that was wrong in a way worth recording:
# sorting is deterministic, but Claude Code writes the file back in its own
# order, so every runtime settings write left the file permanently "modified"
# against chezmoi with identical values on both sides. That is the same
# unwinnable fight the modify_ script was written to end, reduced to
# whitespace. Order-preserving output reproduces Claude Code's own bytes
# exactly (verified byte-for-byte against a file it had just written), so the
# only thing an apply changes is a value that actually disagrees. Reassigning
# an existing key in jq keeps its original position, so duplicates in the key
# list are harmless.

#
# Two hooks per event, not one, and they are deliberately not merged into a
# single command. The `zellij pipe` half marks the tab of the session you are
# attached to; the `wq note` half records the same fact at machine scope, which
# is the half that survives the two places the first one cannot reach: a session
# you are *not* attached to, and a devlaunch container, where `$ZELLIJ` is unset
# and a pipe would find the container's own zellij rather than the host's.
#
# Kept as separate array entries so that neither can take the other down. A
# `zellij` that hangs, or a `wq` that is not on PATH yet on a freshly bootstrapped
# machine, costs its own hook and not the pair -- and both end in `|| true` for
# the same reason, because a non-zero hook is surfaced to the agent as an error
# and none of this is worth interrupting a turn over.
#
# Both redirect stdin from /dev/null, which is load-bearing and not tidiness:
# Claude Code writes the hook's JSON event to stdin, `zellij pipe` reads its
# payload from stdin when none is given, and a non-empty payload blocks until a
# plugin releases it -- which zellij-attention never does, since the pipe name
# carries the whole message. Without the redirect every hook hung until the
# timeout (~60s per turn). `wq note` does not read stdin at all; it gets the same
# redirect so that the two lines cannot drift into looking different for a reason
# nobody remembers.

set -euo pipefail

managed_body=$(cat <<'EOF'
  "env": {
    "CLAUDE_CODE_SANDBOXED": "1"
  },
  "attribution": {
    "commit": ""
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ZELLIJ\" ] && zellij pipe --name \"zellij-attention::waiting::$ZELLIJ_PANE_ID\" </dev/null || true"
          },
          {
            "type": "command",
            "command": "WORKQ_SOURCE=claude wq note waiting </dev/null >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ZELLIJ\" ] && zellij pipe --name \"zellij-attention::completed::$ZELLIJ_PANE_ID\" </dev/null || true"
          },
          {
            "type": "command",
            "command": "WORKQ_SOURCE=claude wq note done </dev/null >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude/statusline.sh\""
  }
EOF
)

defaults_body=$(cat <<'EOF'
  "model": "opus",
  "enabledPlugins": {},
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
EOF
)

input="$(cat)"

if command -v jq >/dev/null 2>&1; then
    printf '%s' "${input:-{\}}" |
        jq --argjson d "{$defaults_body}" --argjson m "{$managed_body}" '
            . as $in
            | (($d + $in) + $m) as $merged
            | reduce (($in | keys_unsorted) + ($merged | keys_unsorted))[] as $k
                ({}; .[$k] = $merged[$k])
        '
elif [ -z "$input" ]; then
    printf '{\n%s,\n%s\n}\n' "$defaults_body" "$managed_body"
else
    echo "modify_settings.json: no jq yet — leaving ~/.claude/settings.json as it is until the next apply" >&2
    printf '%s' "$input"
fi
