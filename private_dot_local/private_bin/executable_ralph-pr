#!/usr/bin/env bash
# ralph-pr: Portable PR feedback loop powered by ralph-orchestrator
#
# Checks for PR comments and CI failures, addresses them, performs self-review,
# and repeats until the PR is clean. Works in any repo with a PR.
#
# Usage:
#   ralph-pr [PR_NUMBER]              # defaults to current branch's PR
#   ralph-pr --dry-run 123            # show what would be done
#   ralph-pr --max-iterations 20      # override iteration limit (default: 30)
#   ralph-pr --no-tui                 # disable TUI
#   ralph-pr --continue               # resume interrupted loop
#
# Requires: ralph (ralph-orchestrator), gh, jq

set -euo pipefail

MAX_ITERATIONS=""
DRY_RUN=false
PR_NUMBER=""
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; EXTRA_ARGS+=(--dry-run); shift ;;
    --max-iterations) MAX_ITERATIONS="$2"; shift 2 ;;
    --no-tui) EXTRA_ARGS+=(--no-tui); shift ;;
    --continue) EXTRA_ARGS+=(--continue); shift ;;
    --autonomous|-a) EXTRA_ARGS+=(--autonomous); shift ;;
    --verbose|-v) EXTRA_ARGS+=(--verbose); shift ;;
    --quiet|-q) EXTRA_ARGS+=(--quiet); shift ;;
    --help|-h)
      sed -n '2,/^$/s/^# //p' "$0"
      exit 0
      ;;
    -*) EXTRA_ARGS+=("$1"); shift ;;
    *) PR_NUMBER="$1"; shift ;;
  esac
done

# --- Preflight ---
for cmd in ralph gh jq; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "error: $cmd is required but not found" >&2
    exit 1
  fi
done

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  echo "error: not inside a git repository" >&2
  exit 1
fi

# --- Resolve PR ---
if [[ -z "$PR_NUMBER" ]]; then
  PR_NUMBER=$(gh pr view --json number -q .number 2>/dev/null || true)
  if [[ -z "$PR_NUMBER" ]]; then
    echo "error: no PR found for current branch. Pass a PR number or push a PR first." >&2
    exit 1
  fi
fi

PR_URL=$(gh pr view "$PR_NUMBER" --json url -q .url 2>/dev/null || echo "PR #${PR_NUMBER}")
PR_BRANCH=$(gh pr view "$PR_NUMBER" --json headRefName -q .headRefName 2>/dev/null || git branch --show-current)

echo "=== ralph-pr: ${PR_URL} on branch ${PR_BRANCH} ==="

# --- Generate config with PR number baked in ---
CONFIG_DIR=$(mktemp -d)
CONFIG_FILE="${CONFIG_DIR}/ralph-pr.yml"
trap 'rm -rf "$CONFIG_DIR"' EXIT

cat > "$CONFIG_FILE" <<YAML_EOF
# ralph-pr: generated config for PR #${PR_NUMBER}

event_loop:
  completion_promise: LOOP_COMPLETE
  max_iterations: 30
  max_runtime_seconds: 7200
  starting_event: gather.start

cli:
  backend: claude

core:
  guardrails:
    - "Fresh context each iteration - re-read the PR state every cycle."
    - "Commit after each fix. Never amend previous commits."
    - "Keep changes minimal and focused on the feedback. Do not refactor unrelated code."
    - "Always push after committing so CI can re-run."
    - "Reply concisely on the PR after addressing feedback."

hats:
  gatherer:
    name: "Gatherer"
    description: "Checks for PR comments, review requests, and CI failures."
    triggers: ["gather.start", "push.done"]
    publishes: ["feedback.found", "LOOP_COMPLETE"]
    default_publishes: "LOOP_COMPLETE"
    instructions: |
      ## GATHERER: Assess current PR state for PR #${PR_NUMBER}

      ### Step 1: Fetch PR comments and reviews

      \`\`\`bash
      # Inline review comments (not replies)
      gh api "repos/{owner}/{repo}/pulls/${PR_NUMBER}/comments" \\
        --paginate --jq '
        [.[] | select(.in_reply_to_id == null) |
        { id: .id, path: .path, line: (.line // .original_line // .position),
          body: .body, user: .user.login }]'

      # Review-level comments
      gh api "repos/{owner}/{repo}/pulls/${PR_NUMBER}/reviews" \\
        --paginate --jq '
        [.[] | select(.state == "CHANGES_REQUESTED" or
          (.state == "COMMENTED" and .body != "" and .body != null)) |
        { id: .id, state: .state, body: .body, user: .user.login }]'
      \`\`\`

      ### Step 2: Check CI status

      \`\`\`bash
      gh pr checks ${PR_NUMBER} --json name,state,description,detailsUrl 2>/dev/null | \\
        jq '[.[] | select(.state == "FAILURE" or .state == "ERROR")]'
      \`\`\`

      If there are failing checks, fetch logs:
      \`\`\`bash
      RUN_ID=\$(gh run list --branch "${PR_BRANCH}" --status failure --limit 1 --json databaseId -q '.[0].databaseId')
      if [ -n "\$RUN_ID" ]; then
        gh run view "\$RUN_ID" --log-failed 2>/dev/null | tail -200
      fi
      \`\`\`

      ### Step 3: Check for pending CI (if no other work)

      If there are no comments and no failures, check if CI is still running:
      \`\`\`bash
      gh pr checks ${PR_NUMBER} --json name,state | \\
        jq '[.[] | select(.state == "PENDING" or .state == "QUEUED")]'
      \`\`\`

      If checks are still pending, wait 30 seconds and re-check (up to 3 times).

      ### Step 4: Decide

      If there are comments OR CI failures:
      - Write a summary of all findings to the scratchpad
      - Emit \`feedback.found\` with a brief summary

      If there are NO comments AND NO CI failures (and nothing pending):
      - Emit \`LOOP_COMPLETE\`

      ### IMPORTANT
      - Exclude bot comments (github-actions, dependabot, etc.) unless they report errors
      - Exclude your own previous "addressed feedback" comments
      - For CI, distinguish between failures and pending — only act on actual failures

  fixer:
    name: "Fixer"
    description: "Addresses PR review comments and CI failures."
    triggers: ["feedback.found", "self_review.changes_needed"]
    publishes: ["fix.done"]
    default_publishes: "fix.done"
    instructions: |
      ## FIXER: Address feedback for PR #${PR_NUMBER}

      Read the scratchpad for the current feedback summary.

      ### For review comments:
      1. Read each comment and the relevant file
      2. Make the requested changes — be precise and minimal
      3. If a comment is unclear, make a reasonable interpretation
      4. Commit with: \`fix: address review feedback — <brief summary>\`

      ### For CI failures:
      1. Analyze the failure logs in the scratchpad
      2. Read the relevant source and test files
      3. Fix the root cause — if a test fails, fix the code (not the test) unless the test is clearly wrong
      4. For lint/format issues, apply the required formatting
      5. Commit with: \`fix: resolve CI failure — <brief summary>\`

      ### For self-review issues:
      1. Read the issues noted in the scratchpad
      2. Fix each genuine issue
      3. Commit with: \`fix: self-review — <brief summary>\`

      ### Rules
      - One commit per logical fix (don't squash everything)
      - Only change what's needed — no drive-by refactors
      - Do NOT push — the pusher hat handles that

  self_reviewer:
    name: "Self Reviewer"
    description: "Reviews the PR diff for bugs, security issues, and correctness."
    triggers: ["fix.done"]
    publishes: ["self_review.clean", "self_review.changes_needed"]
    default_publishes: "self_review.clean"
    instructions: |
      ## SELF REVIEWER: Check your own work on PR #${PR_NUMBER}

      ### Step 1: Get the full PR diff
      \`\`\`bash
      gh pr diff ${PR_NUMBER}
      \`\`\`

      ### Step 2: Review for genuine issues only
      Check for:
      - Bugs and logic errors
      - Security issues (injection, XSS, path traversal, etc.)
      - Missing error handling that could cause crashes
      - Obvious performance issues (N+1 queries, unbounded loops)
      - Inconsistency with surrounding codebase patterns

      ### Step 3: Decide

      If you find real issues:
      - Note them in the scratchpad under "## Self-Review Issues"
      - Emit \`self_review.changes_needed\`

      If everything looks good:
      - Emit \`self_review.clean\`

      ### IMPORTANT
      - Do NOT nitpick style, comments, or naming
      - Do NOT suggest refactors of working code
      - Do NOT add type annotations, docstrings, or tests unless they fix a bug
      - Only flag things that are genuinely broken or dangerous
      - This review should be fast — spend most time on the new/changed code

  pusher:
    name: "Pusher"
    description: "Pushes changes and replies on the PR."
    triggers: ["self_review.clean"]
    publishes: ["push.done"]
    default_publishes: "push.done"
    instructions: |
      ## PUSHER: Push and reply on PR #${PR_NUMBER}

      ### Step 1: Push
      \`\`\`bash
      git push origin "${PR_BRANCH}"
      \`\`\`

      ### Step 2: Reply on the PR

      Write a concise comment summarizing what was fixed. Reference specific feedback.

      \`\`\`bash
      gh pr comment ${PR_NUMBER} --body "<your concise summary>"
      \`\`\`

      Keep it brief (2-4 sentences max). Example:
      > Addressed review feedback: renamed \`foo\` to \`bar\` per @reviewer's suggestion,
      > fixed the off-by-one in pagination, and resolved the CI lint failure.

      ### Step 3: Emit
      Wait 15 seconds for CI to start, then emit \`push.done\`:
      \`\`\`bash
      sleep 15
      \`\`\`
YAML_EOF

# --- Build ralph command ---
RALPH_ARGS=(
  run
  -c "$CONFIG_FILE"
  -p "Work on PR #${PR_NUMBER} (${PR_URL}). Branch: ${PR_BRANCH}. Address all review comments, fix CI failures, self-review, and push. Loop until the PR is clean."
)

if [[ -n "$MAX_ITERATIONS" ]]; then
  RALPH_ARGS+=(--max-iterations "$MAX_ITERATIONS")
fi

RALPH_ARGS+=("${EXTRA_ARGS[@]}")

echo "Starting ralph orchestration loop..."
exec ralph "${RALPH_ARGS[@]}"
