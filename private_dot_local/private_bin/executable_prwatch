# settings

@dataclass(frozen=True)
class Settings:
    owner: str
    name: str
    base: str
    mode: Mode
    backend: Backend
    interval: int
    stale_days: int
    round_budget: int
    max_workers: int
    rerun: bool
    model: str
    workspace: str | None
    worker_timeout_s: int
    startup_timeout_s: int
    keep_worktrees: bool

    @property
    def repo(self) -> str:
        return f"{self.owner}/{self.name}"

    @property
    def state_dir(self) -> Path:
        return STATE_ROOT / self.owner / self.name

    @property
    def state_file(self) -> Path:
        return self.state_dir / "state.json"

    @property
    def queue_file(self) -> Path:
        return self.state_dir / "queue.json"

    @property
    def trans_file(self) -> Path:
        return self.state_dir / "transitions.json"

    @property
    def raw(self) -> Path:
        return self.state_dir / "raw"

    @property
    def logs(self) -> Path:
        return self.state_dir / "logs"

    @property
    def workers(self) -> Path:
        return self.state_dir / "workers"

    @property
    def worktrees(self) -> Path:
        return self.state_dir / "worktrees"


def resolve_repo(arg: str) -> tuple[str, Path | None]:
    """OWNER/NAME as given, or a local clone whose remote names the repo (and
    which is then the clone worktrees are cut from)."""
    p = Path(arg).expanduser()
    if p.is_dir() and (p / ".git").exists():
        r = run(["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"], cwd=p)
        if r.returncode != 0 or "/" not in r.stdout:
            die(f"{p} is a git checkout but gh cannot name its GitHub repo: {r.stderr.strip()}")
        return r.stdout.strip(), p
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", arg):
        die(f"repo must be OWNER/NAME or a path to a clone, not {arg!r}")
    return arg, None


def settings_from_args(a: argparse.Namespace) -> Settings:
    repo, clone_from_path = resolve_repo(a.repo)
    owner, name = repo.split("/")
    clone = Path(a.clone).expanduser() if a.clone else clone_from_path
    s = Settings(
        owner=owner, name=name, base=a.base,
        mode=Mode.DRY_RUN if a.dry_run else Mode.LIVE,
        backend=Worktree(clone) if clone else Devcontainer(),
        interval=a.interval, stale_days=a.stale_days, round_budget=a.round_budget,
        max_workers=a.max_workers, rerun=a.rerun, model=a.model, workspace=a.workspace,
        worker_timeout_s=a.worker_timeout, startup_timeout_s=a.startup_timeout,
        keep_worktrees=a.keep_worktrees,
    )
    for d in (s.raw, s.logs, s.workers, s.worktrees):
        d.mkdir(parents=True, exist_ok=True)
    return s


# ---------------------------------------------------------------------------
# worker markers: a file per PR naming the tab a worker opened for it. The tab
# outlives the turn and the prwatch process: the human ends it, so a marker is
# live while its pane exists, not while a PID does. `busy` is true for the
# length of one prompted turn, which is what the worker cap counts.

@dataclass(frozen=True)
class Marker:
    tab: TabHandle
    stage: str
    started: str
    busy: bool
    adopted: bool = False       # the tab was already the human's; prwatch did not open it
    outcome: str | None = None  # how the last turn here ended; None while one is running
    dispatched_at: dict | None = None  # the PR's fingerprint when this turn was sent
    no_change_turns: int = 0    # consecutive turns that ended having changed nothing here

    def to_json(self) -> dict:
        return {"tab_id": self.tab.tab_id, "pane_id": self.tab.pane_id, "stage": self.stage,
                "started": self.started, "busy": self.busy, "adopted": self.adopted,
                "outcome": self.outcome, "dispatched_at": self.dispatched_at,
                "no_change_turns": self.no_change_turns}

    @staticmethod
    def from_json(d: dict) -> Marker:
        # `adopted` and `outcome` postdate the first marker files; missing ones
        # read as False and None, which is what every earlier marker meant.
        return Marker(TabHandle(d["tab_id"], d["pane_id"]), d["stage"], d["started"],
                      bool(d["busy"]), bool(d.get("adopted")), d.get("outcome"),
                      d.get("dispatched_at"), int(d.get("no_change_turns") or 0))

    @property
    def unfinished(self) -> bool:
        """A turn ran here and did not work the PR, so the next poll should come
        back to it. Nothing about the PR changed, so no transition will."""
        if self.busy or self.outcome is None:
            return False
        with contextlib.suppress(ValueError):
            return Outcome(self.outcome).owed_a_retry
        return False  # an outcome written by a version that had other names

    def changed_nothing(self, pr: PR) -> bool:
        """The turn ended cleanly and left the PR exactly as it found it. That
        reads as success everywhere else -- the marker says `finished`, so
        `unfinished` is False -- but the PR is not fixed and no transition will
        ever come back for it: a `ci_red` with the same head and the same red
        set produces the same fingerprint however long it waits. Seen for real
        on a worker that read its failing check, judged it a flake in a test
        the branch did not touch, and pushed nothing.
        """
        if self.busy or self.outcome != Outcome.FINISHED.value or self.dispatched_at is None:
            return False
        return self.dispatched_at == pr.fingerprint.to_json()

    @property
    def gave_up_twice(self) -> bool:
        """Two turns in a row ended here having changed nothing. The prompt
        sanctions exactly that answer -- a failure that reproduces on the base
        branch is not this PR's to fix, and saying so beats patching over it --
        so a second identical verdict is a result, not a miss. Retrying past it
        spends the whole day's budget re-deciding what two workers already
        decided, and the PR needs a human instead.

        `no_change_turns` counts the turns *before* the one this marker
        describes, so one of those plus this one is the two."""
        return self.no_change_turns >= 1


def pane_list() -> list[dict]:
    r = run(["herdr", "pane", "list"])
    if r.returncode != 0:
        raise RuntimeError(f"herdr pane list failed: {r.stderr.strip() or r.stdout.strip()}")
    try:
        return json.loads(r.stdout)["result"]["panes"]
    except (ValueError, KeyError, TypeError) as e:
        raise RuntimeError(f"herdr pane list returned no panes: {e}") from e


def pane_agent_status(p: dict) -> str:
    return (p.get("agent_status") or "unknown") if p.get("agent") else "none"


def agent_status(pane: str) -> str:
    """herdr's status word for the agent in a pane; `none` for a pane at a
    shell with no agent, `gone` for a pane that no longer exists. Read from
    `pane list`: `agent get` answers agent_not_found to both of the last two."""
    for p in pane_list():
        if p.get("pane_id") == pane:
            return pane_agent_status(p)
    return "gone"


def interactive_ready(pane: str) -> bool | None:
    """herdr's own word for "this agent's UI will accept a submitted prompt",
    which is a later moment than "an agent is here".

    Only agents herdr started itself report it. `pane list` never carries the
    field at all, and a Claude that dl started inside a devcontainer answers
    None -- so None means no opinion, not "not ready", and the caller waits
    rather than treating it as a refusal."""
    r = run(["herdr", "agent", "get", pane])
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)["result"]["agent"].get("interactive_ready")
    except (ValueError, KeyError, TypeError):
        return None


DL_BRANCH_CHARS = 31  # `ci/bench-selection-by-changed-file` -> `ci-bench-selection-by-changed-f`


def devlaunch_label(repo_name: str, branch: str) -> str:
    """The name `dl` gives a workspace's tab: `<repo>@<branch>`, each slugged to
    alphanumerics and `-`, with the branch cut to 31 characters.

    Reproduced here rather than read off dl, because the workspace does not
    exist until dl makes it, and until then the tab carries whatever prwatch
    called it. `PR #10708` for the eighty seconds of a container build is the
    one thing a worker tab should not be called: the whole point of adopting a
    tab is that a worker's and one opened with `aid` are the same kind of
    thing, and a tab named after the PR advertises the difference.

    Guessing is safe *here* in a way it is not in the adoption matcher: dl
    renames the tab itself once the workspace is up, so a slug that drifts from
    theirs is corrected within the minute rather than believed forever. The PR
    number is not lost with the old label -- it is on the pane's own metadata,
    which is what the agents sidebar reads."""
    def slug(s: str) -> str:
        return re.sub(r"-{2,}", "-", re.sub(r"[^A-Za-z0-9]", "-", s)).strip("-").lower()
    return f"{slug(repo_name)}@{slug(branch)[:DL_BRANCH_CHARS].rstrip('-')}"


def clear_composer(pane: str) -> None:
    """Empty the agent's input box before submitting into it.

    `herdr agent prompt` appends to whatever is already typed there and submits
    the concatenation, so an unsent line becomes part of the prompt:

        > my own half-written note about the auth bugFix the failing CI on #9519

    On an adopted tab that is the human's draft; on a retry it is the previous
    prompt. Either way it silently becomes instructions to a worker running
    with permissions skipped, which is a correctness problem and not a cosmetic
    one. ctrl+u is the only clear herdr accepts (ctrl-u, C-u and ^u are all
    invalid_key) and, unlike ctrl+c, it has no second meaning."""
    run(["herdr", "agent", "send-keys", pane, "ctrl+u"])


def write_marker(s: Settings, num: int, m: Marker) -> None:
    write_json(s.workers / str(num), m.to_json())


def live_marker(s: Settings, num: int) -> Marker | None:
    """The PR's marker if its tab is still there. A marker whose pane is gone
    is the human having ended the tab: it is dropped, and on the worktree
    backend the worktree goes with it if it holds nothing unpushed."""
    f = s.workers / str(num)
    d = read_json(f)
    if not d:
        return None
    try:
        m = Marker.from_json(d)
    except (KeyError, TypeError):
        f.unlink(missing_ok=True)
        return None
    if agent_status(m.tab.pane_id) != "gone":
        return m
    f.unlink(missing_ok=True)
    if not m.adopted:
        remove_clean_worktree(s, num)
    return None


def marker_numbers(s: Settings) -> list[int]:
    return sorted(int(f.name) for f in s.workers.iterdir() if f.name.isdigit())


def busy_workers(s: Settings) -> int:
    return sum(1 for n in marker_numbers(s) if (m := live_marker(s, n)) and m.busy)


def claimed_panes(s: Settings) -> frozenset[str]:
    """Panes a marker already names, read from the files alone: this runs
    before the adoption scan, and must not ask herdr anything to do it."""
    out = {d["pane_id"] for n in marker_numbers(s)
           if (d := read_json(s.workers / str(n))) and d.get("pane_id")}
    return frozenset(out)


# ---------------------------------------------------------------------------
# adoption: the tabs that were already the human's.
#
# A branch is usually open before prwatch ever sees its PR -- `aid
# blooop/bencher@rerun_drop` in one tab, `dl` in the next. A second tab on the
# same branch is not just clutter: on the devcontainer backend the worker's
# `dl ... --rm` attaches to the workspace that is already running and arms the
# delete on it, so the human's workspace goes when the worker's Claude exits.
# So a poll asks what is open before it opens anything, and prompts into the
# tab that is there.
#
# The match is on the branch, never on the tab's name. `dl` titles the terminal
# `<repo>@<branch>` and the tab-title hook copies that to the label, but the
# slug is lossy and one-way: `rerun_drop` and `rerun-drop` both render as
# `rerun-drop`, and a long branch is cut (`test/10633-gate-and-load-bearing-
# coupling` -> `test-10633-gate-and-load-bearin`). Reading a branch back out of
# a label would be a guess. Both backends have an exact source instead:
#
#   devlaunch  `dl --ls --json` reports every workspace's repo and branch
#              verbatim, next to the id the title was slugged from. The chain
#              is title -> workspace -> branch, so the lossy step is only ever
#              checked, never inverted.
#   worktree   the pane's cwd is a checkout, and git names its branch.
#
# An adopted tab is the human's in a way an opened one is not: prwatch never
# closes it, never removes what it sits in, and never prompts it while somebody
# is mid-turn there.

# `unknown` is an agent herdr knows about but has no status for yet, which is
# what a Claude looks like for the ~minute `dl` takes to bring it up. Counting
# it busy is what stops prwatch opening a second agent on a branch a human just
# launched one on: the tab is recognised as theirs, held, and never prompted
# mid-startup. Without it there is a startup-long window where the branch looks
# free and a worker lands on top of them.
BUSY_AGENT = frozenset({"working", "blocked", "unknown"})


@dataclass(frozen=True)
class OpenTabs:
    """What is open on this repo right now, read once a poll."""
    by_branch: dict[str, TabHandle]
    occupied: frozenset[str]
    agentless: frozenset[str]
    checkouts: dict[str, Path]

    def busy(self, m: Marker) -> bool:
        return m.busy or m.tab.pane_id in self.occupied

    def promptable(self, m: Marker) -> bool:
        """A marker is only good for a prompt while its pane still holds an
        agent. `tidy` cannot be the one to notice: it leaves adopted tabs alone
        by design, and on the devcontainer backend it does nothing at all, so a
        pane that outlived its Claude would be prompted every poll forever --
        `herdr agent prompt` answers agent_not_found, which costs a round each
        time. Busy is exempt: a worker mid-build has a tab and no agent yet."""
        return m.busy or m.tab.pane_id not in self.agentless


def tab_list() -> list[dict]:
    r = run(["herdr", "tab", "list"])
    if r.returncode != 0:
        return []
    try:
        return json.loads(r.stdout)["result"]["tabs"]
    except (ValueError, KeyError, TypeError):
        return []


def dl_workspaces(repo: str) -> list[dict]:
    """This repo's devlaunch workspaces, each with its branch as `dl` recorded
    it. Absent or unhappy `dl` is not fatal: adoption falls back to cwd."""
    if not shutil.which("dl"):
        return []
    r = run(["dl", "--ls", "--json"])
    if r.returncode != 0:
        log(f"dl --ls --json failed; not adopting devlaunch tabs this poll: {r.stderr.strip()[:120]}")
        return []
    try:
        ws = json.loads(r.stdout)
    except ValueError:
        return []
    return [w for w in ws if isinstance(w, dict)
            and (w.get("repo") or "").lower() == repo.lower() and w.get("branch")]


def title_names_workspace(title: str, ws_id: str) -> bool:
    """`dl` titles the terminal `<repo-slug>@<branch-slug>` and names the
    workspace `<repo-slug>-<branch-slug>-<suffix>` from that same slug, so a
    title with its one `@` put back to a `-` is the workspace id minus the
    suffix. Checked against the id, not re-derived: the slug is dl's, and the
    day it changes this goes quiet rather than matching the wrong branch."""
    if title.count("@") != 1:
        return False
    stem = title.replace("@", "-")
    return ws_id.startswith(stem) and re.fullmatch(r"-\w+", ws_id[len(stem):]) is not None


def checkout_branch(path: Path, repo: str) -> str | None:
    """The branch checked out at `path`, if `path` is a clone of `repo`."""
    url = run(["git", "-C", str(path), "remote", "get-url", "origin"]).stdout.strip()
    if not url or not re.sub(r"\.git$", "", url).lower().endswith("/" + repo.lower()):
        return None
    return run(["git", "-C", str(path), "rev-parse", "--abbrev-ref", "HEAD"]).stdout.strip() or None


def worktree_branches(clone: Path) -> dict[str, Path]:
    """Every branch this clone has checked out, worktrees included.

    A branch can be yours without having a tab: `~/kinisi/kinisi_ros.worktrees/
    wf10705` sits on a PR's head with nothing open on it, and a worker that
    pushes from a devcontainer leaves it quietly behind. There is no register of
    a person's clones to consult, so the one asked here is a clone prwatch has
    already been shown -- the `--clone` it was given, or one a pane is sitting
    in. `git worktree list` on it then names every branch that clone holds,
    including the ones nothing is open on."""
    r = run(["git", "-C", str(clone), "worktree", "list", "--porcelain"])
    if r.returncode != 0:
        return {}
    out: dict[str, Path] = {}
    path: Path | None = None
    for line in r.stdout.splitlines():
        if line.startswith("worktree "):
            path = Path(line[len("worktree "):])
        elif line.startswith("branch ") and path is not None:
            out.setdefault(re.sub(r"^refs/heads/", "", line[len("branch "):]), path)
    return out


def scan_open_tabs(s: Settings) -> OpenTabs:
    try:
        panes = pane_list()
    except RuntimeError as e:
        log(f"cannot read herdr panes; adopting nothing this poll: {e}")
        return OpenTabs({}, frozenset(), frozenset(), {})
    occupied = frozenset(p["pane_id"] for p in panes
                         if p.get("pane_id") and pane_agent_status(p) in BUSY_AGENT)
    agentless = frozenset(p["pane_id"] for p in panes
                          if p.get("pane_id") and pane_agent_status(p) == "none")

    per_tab: dict[str, list[dict]] = {}
    for p in panes:
        per_tab.setdefault(p.get("tab_id") or "", []).append(p)
    labels = {t.get("tab_id"): t.get("label") or "" for t in tab_list()}
    workspaces = dl_workspaces(s.repo)
    claimed, mine, home = claimed_panes(s), os.environ.get("HERDR_PANE_ID"), Path.home()

    by_branch: dict[str, TabHandle] = {}
    for tab_id, ps in per_tab.items():
        # One pane per tab: a split holds two agents and no single one to prompt.
        if len(ps) != 1 or not tab_id:
            continue
        p = ps[0]
        pane_id = p.get("pane_id")
        if not pane_id or pane_id == mine or pane_id in claimed:
            continue
        if pane_agent_status(p) == "none":
            continue  # a pane at a shell holds nothing to adopt and nothing to prompt
        names = (labels.get(tab_id, ""), p.get("terminal_title_stripped") or "")
        branch = next((w["branch"] for w in workspaces
                       if any(n and title_names_workspace(n, w.get("id") or "") for n in names)), None)
        cwd = Path(p.get("cwd") or home)
        if branch is None and cwd != home and cwd.is_dir():
            branch = checkout_branch(cwd, s.repo)
        # The base branch is never a PR's head, and the clone sitting on it is
        # where the human works on everything else. Adopting that tab would
        # point a worker at the wrong checkout.
        if branch and branch != s.base and branch not in by_branch:
            by_branch[branch] = TabHandle(tab_id, pane_id)

    # Branches that are yours without a tab. Every clone prwatch has been shown
    # is asked; the answers are only ever reported, never acted on.
    clones = {Path(p["cwd"]) for p in panes if p.get("cwd") and Path(p["cwd"]) != home}
    if isinstance(s.backend, Worktree):
        clones.add(s.backend.clone)
    checkouts: dict[str, Path] = {}
    for c in sorted(clones):
        if c.is_dir() and checkout_branch(c, s.repo):
            for b, path in worktree_branches(c).items():
                if b != s.base:
                    checkouts.setdefault(b, path)
    return OpenTabs(by_branch, occupied, agentless, checkouts)


def remove_clean_worktree(s: Settings, num: int) -> None:
    match s.backend:
        case Worktree(clone):
            wt = s.worktrees / str(num)
            if not wt.is_dir():
                return
            dirty = run(["git", "-C", str(wt), "status", "--porcelain"]).stdout.strip()
            unpushed = run(["git", "-C", str(wt), "log", "--oneline", "@{u}..HEAD"]).stdout.strip()
            if dirty or unpushed:
                log(f"worktree {wt} kept: it has uncommitted or unpushed changes")
            elif not s.keep_worktrees:
                run(["git", "-C", str(clone), "worktree", "remove", "--force", str(wt)])
        case Devcontainer():
            pass
        case _ as unreachable:
            assert_never(unreachable)


def tidy(s: Settings) -> None:
    """Once a poll: the cleanup that follows the human's exit. With dl --rm the
    workspace deletes itself and the pane closes, so there is nothing to do but
    drop the marker. On the worktree backend Claude ran in the pane's own shell,
    which is left behind at a prompt when the human types /exit; that tab is
    closed here and its worktree removed if clean. Busy markers are left alone:
    a worker mid-startup has a tab and no agent yet. So are adopted ones: that
    tab and that checkout were the human's before prwatch knew the PR existed,
    and /exit there means they are done with the turn, not with the tab."""
    for n in marker_numbers(s):
        m = live_marker(s, n)
        if not m or m.busy or m.adopted or not isinstance(s.backend, Worktree):
            continue
        if agent_status(m.tab.pane_id) == "none":
            log(f"#{n}: Claude was exited in its tab; closing the tab and cleaning up")
            run(["herdr", "tab", "close", m.tab.tab_id])
            (s.workers / str(n)).unlink(missing_ok=True)
            remove_clean_worktree(s, n)


# ---------------------------------------------------------------------------
# classify

def classify_one(s: Settings, me: str, required: tuple[str, ...], l: dict, q: dict, p: PR | None,
                 now: str) -> PR:
    now_t, today = ts(now), now[:10]
    # No `or me` fallback: this login is half the dispatch gate below, and a
    # missing GraphQL author reading as me would hand a worker to a PR I have
    # no claim on. `ours` keeps the fallback, where guessing me is the
    # conservative way to leave a thread alone.
    author = (q.get("author") or {}).get("login") or (l.get("author") or {}).get("login") or ""
    # Our side of the conversation: the PR author and me. On a PR somebody else
    # wrote and assigned to me, the worker's replies are posted as me, and must
    # close a thread the same way the author's would.
    ours = {author or me, me}

    # ---- CI verdict over the required checks only ----
    all_checks = [
        {"name": c.get("name") or c.get("context"),
         "status": c.get("status") or "COMPLETED",
         "concl": c.get("conclusion") or c.get("state"),
         "run": run_id_of(c.get("detailsUrl"))}
        for c in (l.get("statusCheckRollup") or [])
    ]
    names = {c["name"] for c in all_checks}
    checks = [c for c in all_checks if c["name"] in required] if required else all_checks
    missing_req = tuple(c for c in required if c not in names) if required else ()
    red = tuple(sorted({c["name"] for c in checks if c["concl"] in RED_CONCLUSIONS}))
    red_runs = tuple(sorted({c["run"] for c in checks
                             if c["concl"] in RED_CONCLUSIONS and c["run"]}))
    pending = tuple(sorted({c["name"] for c in checks
                            if c["status"] != "COMPLETED" or c["concl"] in ("CANCELLED", "STALE")}))
    if red:
        ci = CI.RED
    elif pending:
        ci = CI.PENDING
    elif not all_checks:
        ci = CI.NONE
    elif missing_req:
        ci = CI.PENDING
    else:
        ci = CI.GREEN

    # ---- what GitHub said about the head, read now, judged below ----
    raw = q.get("mergeable") or l.get("mergeable") or "UNKNOWN"
    was_unknown = raw == "UNKNOWN"
    head_sha = q.get("headRefOid") or ""

    # ---- review threads: only those whose ball is in my court ----
    threads = (q.get("reviewThreads") or {}).get("nodes") or []
    unres = [t for t in threads if t.get("isResolved") is False]
    ball_in_court = 0
    for t in unres:
        comments = (t.get("comments") or {}).get("nodes") or []
        if comments:
            last = comments[-1].get("author") or {}
            if last.get("login") not in ours and not isbot(last):
                ball_in_court += 1

    # ---- reviews: latest per non-author human ----
    reviews = (q.get("reviews") or {}).get("nodes") or []
    ext = [r for r in reviews if (r.get("author") or {}).get("login") not in ours and not isbot(r.get("author"))]
    latest: dict[str, dict] = {}
    for r in sorted(ext, key=lambda r: r.get("submittedAt") or ""):
        latest[(r.get("author") or {}).get("login") or ""] = r
    changes_requested = sum(1 for r in latest.values() if r.get("state") == "CHANGES_REQUESTED")
    body_reviews = [r["submittedAt"] for r in latest.values()
                    if r.get("state") != "APPROVED" and (r.get("bodyText") or "") and r.get("submittedAt")]
    last_body_review_at = max(body_reviews, default=None)
    commits = (q.get("commits") or {}).get("nodes") or []
    head_committed_at = ((commits[0].get("commit") or {}).get("committedDate")) if commits else None
    unanswered_body = last_body_review_at is not None and ts(last_body_review_at) > ts(head_committed_at)
    approvals = [r["submittedAt"] for r in ext if r.get("state") == "APPROVED" and r.get("submittedAt")]
    last_approval_at = max(approvals, default=None)
    fresh_approval = last_approval_at is not None and ts(last_approval_at) >= ts(head_committed_at)
    stale_approval = l.get("reviewDecision") == "APPROVED" and not fresh_approval

    # ---- the human-activity clock ----
    activity = [ts(r.get("submittedAt")) for r in reviews if not isbot(r.get("author"))]
    activity += [ts(c.get("createdAt")) for t in threads
                 for c in ((t.get("comments") or {}).get("nodes") or []) if not isbot(c.get("author"))]
    activity += [ts(head_committed_at), ts(l.get("createdAt"))]
    activity_t = max(activity)
    age_days = (now_t - activity_t) / 86400
    labels = tuple(x.get("name") for x in (l.get("labels") or []))
    assignees = tuple(x.get("login") for x in (l.get("assignees") or []))
    labelled_stale = any((x or "").lower() == "stale" for x in labels)

    # ---- mergeable, with UNKNOWN carried forward only while it is a blip ----
    # UNKNOWN is usually GitHub still computing after a push, which is exactly
    # the moment a worker has just pushed a merge commit. Reading UNKNOWN as
    # "no longer conflicting" there would dispatch nothing while the conflict
    # is unresolved, so inside the recompute window the last known value is
    # carried forward and the stage holds.
    #
    # Past the window it is not a blip. #10764 pushed once and then read
    # UNKNOWN from GraphQL, REST and two live retries for over two hours,
    # because it was stacked on a moving base branch -- the usual way GitHub
    # gets stuck. Carrying CONFLICTING forward for hours would keep re-arming a
    # merge worker for a merge that already landed, so past the window UNKNOWN
    # stands as itself: the conflicting rung falls through and the PR is
    # classified by the signals that are real (ci_red, comments_open,
    # waiting_review). `ready` needs MERGEABLE, so it stays out of reach --
    # correctly, since a mergeability GitHub cannot evaluate cannot be merged.
    recomputing = was_unknown and p is not None and (
        p.head_sha != head_sha or now_t - ts(head_committed_at) < MERGEABLE_RECOMPUTE_S)
    if not was_unknown:
        mergeable = Mergeable(raw)
    elif recomputing:
        mergeable = p.mergeable
    else:
        mergeable = Mergeable.UNKNOWN

    # ---- stage, first match wins ----
    stage: Stage
    if me not in assignees and author != me:
        stage = QuietStage.UNASSIGNED
    elif labelled_stale or (age_days > s.stale_days and "keep-alive" not in labels):
        stage = QuietStage.STALE
    elif l.get("isDraft") and ci is not CI.RED:
        stage = QuietStage.DRAFT
    # A conflict outranks red CI, and the reason is that a red run on a
    # conflicting head can never come back green: the fix is a merge commit,
    # which discards that run's results along with the sha they belong to. Red
    # CI first meant a PR that was both spent round after round on checks
    # against a base it could not merge into, and the conflict -- the thing
    # actually blocking the merge -- was never named until every check was
    # green. Merge first, then fix whatever is still red against current main.
    elif mergeable is Mergeable.CONFLICTING:
        stage = WorkerStage.CONFLICTING
    elif ci is CI.RED:
        stage = WorkerStage.CI_RED
    elif ball_in_court > 0 or changes_requested > 0 or unanswered_body:
        stage = WorkerStage.COMMENTS_OPEN
    elif (l.get("reviewDecision") == "APPROVED" and fresh_approval
          and ci is CI.GREEN and mergeable is Mergeable.MERGEABLE):
        stage = QuietStage.READY
    else:
        stage = QuietStage.WAITING_REVIEW

    # A PR mid-recompute keeps its previous fingerprint, so no transition fires
    # while GitHub cannot say whether the merge commit a worker just pushed
    # landed clean; the poll after it settles compares against the pre-push
    # state and fires once. The freeze is bounded to the recompute window for
    # the same reason `mergeable` is: an UNKNOWN that never clears used to
    # freeze the fingerprint forever, and since `prev_fingerprint` is read from
    # the same frozen value the two were equal by construction and transitions()
    # skipped the PR on every poll. #10764 went red on a required check and sat
    # invisible for 2.75h that way -- top of the queue, in none of the
    # candidate sets. Past the window `settled` is used, so a chronic UNKNOWN
    # costs one suppressed poll rather than every poll thereafter.
    settled = Fingerprint(stage.value, head_sha, ball_in_court, red, mergeable.value)
    fingerprint = p.fingerprint if recomputing else settled

    return PR(
        number=l["number"], title=l.get("title") or "", url=l.get("url") or "",
        head_ref=l.get("headRefName") or "",
        base_ref=l.get("baseRefName") or s.base,
        head_owner=(l.get("headRepositoryOwner") or {}).get("login"),
        head_sha=head_sha, stage=stage, ci=ci,
        ci_red_checks=red, ci_pending_checks=pending, ci_red_runs=red_runs,
        ci_rerun=(p.ci_rerun if (p and p.head_sha == head_sha) else ()),
        ci_missing_required=missing_req,
        mergeable=mergeable, mergeable_was_unknown=was_unknown, merge_state=q.get("mergeStateStatus"),
        review_decision=l.get("reviewDecision"), stale_approval=stale_approval,
        unresolved_threads=len(unres), actionable_threads=ball_in_court,
        changes_requested=changes_requested, unanswered_review_body=unanswered_body,
        is_draft=bool(l.get("isDraft")), labels=labels, assignees=assignees,
        updated_at=l.get("updatedAt") or "",
        head_committed_at=head_committed_at,
        last_human_activity=(datetime.fromtimestamp(activity_t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                             if activity_t > 0 else None),
        age_days=int(age_days * 10) / 10,
        budget=(p.budget if p else Budget(today, 0)).for_day(today),
        pending=bool(p and p.pending) and isinstance(stage, WorkerStage),
        fingerprint=fingerprint,
        prev_fingerprint=p.fingerprint if p else None,
        prev_stage=p.stage.value if p else None,
    )


def stack_parents(prs: dict[int, PR]) -> dict[int, int]:
    """child PR number -> the open PR it is stacked on. A PR whose base is
    another open PR's head branch cannot be finished before that one: its
    branch contains the parent's commits, so it inherits the parent's failures
    and its conflicts resolve against the parent, not `main`. Stacks are common
    enough here that treating every PR as if it targeted the base branch is
    what makes a worker fix the right bug in the wrong branch."""
    by_head = {p.head_ref: p.number for p in prs.values() if p.head_ref}
    return {p.number: by_head[p.base_ref] for p in prs.values()
            if p.base_ref in by_head and by_head[p.base_ref] != p.number}


def stack_ancestors(num: int, parents: dict[int, int]) -> list[int]:
    """Every open PR below this one in its stack, nearest first, ending at the
    one that targets the base branch. A malformed stack can name a cycle -- two
    PRs each based on the other's head -- so the walk remembers where it has
    been rather than looping forever."""
    out: list[int] = []
    seen = {num}
    cur = parents.get(num)
    while cur is not None and cur not in seen:
        out.append(cur)
        seen.add(cur)
        cur = parents.get(cur)
    return out


def stack_descendants(num: int, parents: dict[int, int]) -> list[int]:
    """Every open PR above this one in its stack, whatever the distance."""
    return sorted(c for c in parents if num in stack_ancestors(c, parents))


def blocked_by_stack(child: PR, prs: dict[int, PR], parents: dict[int, int]) -> str | None:
    """Why this PR must wait for something below it in its stack, or None to
    work it now. Only a `conflicting` ancestor holds, and it holds from any
    depth.

    A conflict below is the one thing a descendant genuinely cannot work
    around: its own merge resolves against a branch that has to change first,
    and it cannot know the shape of that change. So the walk looks the whole
    way down. A single-hop version let a conflicting PR through whenever its
    immediate parent happened to be red on some unrelated check, while the
    grandparent's conflict was still unresolved.

    Nothing else holds, and that is a finding rather than an omission. A
    thirteen-deep stack ran here for four hours with red and comment-bearing
    PRs worked concurrently at every level, and it converged: every unwell PR
    in it ended green and mergeable. Workers re-merge their parent branch on
    the next turn, so a stale base costs a turn, not the result -- the loop
    self-corrects. Meanwhile the stack's root spent all eight of its rounds
    flapping between `comments_open` and `conflicting` as main moved, and never
    resolved. Holding on any unwell ancestor would have parked all twelve
    descendants behind exactly that PR for the whole four hours, trading a
    stack that fixed itself for one that could not.
    """
    below = stack_ancestors(child.number, parents)
    blocking = [n for n in below
                if (a := prs.get(n)) and a.stage is WorkerStage.CONFLICTING]
    if not blocking:
        return None
    # The lowest, not the nearest: that is the one a worker reaches first, so it
    # is the one this branch is really waiting on.
    low = blocking[-1]
    steps = below.index(low) + 1
    if steps == 1:
        return f"#{low} is conflicting, and this branch merges into it"
    return (f"#{low} is conflicting, {steps} steps down this stack; its merge has to land "
            f"before this branch can resolve its own")


def transitions(state: State) -> list[Transition]:
    out = []
    for pr in state.prs.values():
        if pr.fingerprint == pr.prev_fingerprint:
            continue
        if pr.prev_fingerprint is None:
            reason = f"first seen as {pr.stage.value}"
        else:
            reason = "; ".join(pr.prev_fingerprint.diff(pr.fingerprint))
        out.append(Transition(pr, reason))
    return out


def build_queue(s: Settings, state: State) -> list[dict]:
    q = [p for p in state.prs.values() if p.stage in RANK
         and not (isinstance(p.stage, WorkerStage) and p.budget.used >= s.round_budget)]
    q.sort(key=lambda p: (RANK[p.stage], p.updated_at))
    return [{"number": p.number, "stage": p.stage.value, "rank": RANK[p.stage], "rounds": p.budget.used,
             "ci": p.ci.value, "mergeable": p.mergeable.value, "actionable_threads": p.actionable_threads,
             "updatedAt": p.updated_at, "title": p.title, "url": p.url} for p in q]


