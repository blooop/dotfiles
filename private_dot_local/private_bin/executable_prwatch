def load_state(s: Settings) -> State | None:
    d = read_json(s.state_file)
    return State.from_json(d) if d else None


def print_state(s: Settings, state: State) -> None:
    print()
    fmt = "{:<8} {:<15} {:<9} {:<13} {:<7} {:<6} {:<5} {}"
    print(fmt.format("PR", "STAGE", "CI", "MERGEABLE", "THR/ACT", "ROUNDS", "AGE", "TITLE"))
    for p in sorted(state.prs.values(), key=lambda p: -p.number):
        title = p.title[:50]
        if p.stale_approval:
            title += "  [stale approval]"
        if p.pending:
            title += "  [pending worker]"
        m = live_marker(s, p.number)
        if m:
            title += "  [worker busy]" if m.busy else "  [tab open]"
        print(fmt.format(f"#{p.number}", p.stage.value, p.ci.value, p.mergeable.value,
                         f"{p.unresolved_threads}/{p.actionable_threads}",
                         p.budget.used, f"{int(p.age_days)}d", title))
    counts: dict[str, int] = {}
    for p in state.prs.values():
        counts[p.stage.value] = counts.get(p.stage.value, 0) + 1
    print("\nstage counts:")
    for k in sorted(counts):
        print(f"  {k}: {counts[k]}")
    queue = read_json(s.queue_file, []) or []
    print(f"\nqueue ({len(queue)} actionable, budget-exhausted excluded):")
    for i, v in enumerate(queue, 1):
        print(f"  {i}. #{v['number']} {v['stage']} rounds={v['rounds']} {v['title'][:50]}")


# ---------------------------------------------------------------------------
# the worker: one PR + one WorkerStage -> one prompted turn of Claude in the
# PR's herdr tab, opening the tab first if the PR has none.
#
# The tab is the human's once it exists. It stays open after the turn so they
# can read what happened, carry on, or /exit; a later transition on the same
# PR is prompted into the same tab. Exiting is the cleanup, not prwatch:
#
# Devcontainer backend: the tab runs `exec dl OWNER/NAME@branch --rm -- claude`.
# dl creates the workspace from the repo's own devcontainer, forwards the gh
# and Claude logins, installs herdr inside and reports the agent to the pane,
# so `herdr agent prompt` reaches Claude in the container. When the human
# exits Claude, --rm deletes the workspace (refusing, and saying so, if the
# clone holds unpushed work) and the exec'd shell ends, so the pane and its
# tab close.
#
# Worktree backend: a host-side git worktree for the PR branch, cut from the
# clone; `herdr agent start` runs Claude in the pane's own shell. For repos
# whose devcontainer cannot be built on this host. Exiting Claude leaves the
# shell, so tidy() closes that tab and removes the worktree if it is clean.
#
# Both: `herdr agent prompt --wait` (bare --wait: the turn settles as `done`,
# never `idle`, and `--until idle` times out against a finished turn), then
# `herdr agent read` into logs/ and a notification that the PR is ready to be
# looked at.
#
# The prompt is the safety boundary. It names the one branch the worker may
# touch and forbids merge, close, force-push, amend, and `gh auth token`.

def build_prompt(s: Settings, pr: PR, stage: WorkerStage) -> str:
    n, branch, url, title = pr.number, pr.head_ref, pr.url, pr.title
    rules = f"""You are an unattended worker on one pull request. Hard rules, no exceptions:
- Work only on branch `{branch}` in this checkout. Never switch branches, never touch {s.base}.
- Never merge, close, or comment on the PR's state. Never force-push, never rebase a pushed branch, never amend a pushed commit. New commits only, then `git push`.
- Never run `gh auth token` or print any credential.
- Never resolve a review thread written by a human.
- Do not ask questions; there is nobody watching. Make the call, state the assumption in your final summary.
- When you are done, print a summary of at most five lines: what changed, the commit hashes, and what CI is doing. Then stop."""
    match stage:
        case WorkerStage.CI_RED:
            red = ", ".join(pr.ci_red_checks) or "unknown"
            return f"""Fix the failing required CI on PR #{n} ({url}), "{title}".
Failing required checks: {red}.

Run `gh pr checks {n}` and read the failing logs with `gh run view <run-id> --log-failed` (get the run id from the check's URL). Fix the root cause in this branch, not the symptom, and do not disable, skip, or loosen a test or a lint to make it pass. Run the repo's pre-commit on the files you changed (`pre-commit run --from-ref origin/{s.base} --to-ref HEAD`, or its lint script if there is no .pre-commit-config.yaml). Commit with a message that says what was wrong, push, and stop. Do not wait for CI.

{rules}"""
        case WorkerStage.CONFLICTING:
            return f"""Resolve the merge conflict on PR #{n} ({url}), "{title}".

Run `git fetch origin {s.base}` and `git merge origin/{s.base}`. Resolve each conflict so the PR still does what its title and description say; read the conflicting hunks on both sides before choosing, and prefer keeping the base branch's changes to anything the PR did not deliberately touch. Build or run the tests that the touched files have, if that is feasible here; otherwise run the repo's pre-commit on the changed files. Commit the merge (a merge commit, not a rebase), push, and stop.

{rules}"""
        case WorkerStage.COMMENTS_OPEN:
            return f"""Address the open review on PR #{n} ({url}), "{title}" ({pr.actionable_threads} thread(s) waiting on the author, plus any review body newer than the head commit).

Invoke the `respond` skill for PR {n} and follow it: fix what is right, push back on what is wrong, one reply per unresolved thread, fixes pushed before replies. One addition: before posting each reply, pass its text through the `unslop` skill so it reads as one or two plain sentences naming the change or the reason. Never resolve a thread a human wrote.

{rules}"""
        case _ as unreachable:
            assert_never(unreachable)


def print_dry_run(s: Settings, pr: PR, stage: WorkerStage, existing: Marker | None) -> None:
    if existing:
        where = f"the open tab {existing.tab.tab_id}"
    elif isinstance(s.backend, Devcontainer):
        where = "a new devlaunch workspace"
    else:
        where = f"a new worktree from {s.backend.clone}"
    print(f"--- DRY RUN: PR #{pr.number} ({stage.value}) on {s.repo}@{pr.head_ref}, in {where}. Prompt that would be sent: ---")
    print(build_prompt(s, pr, stage))
    print("--- end of prompt; no tab, no workspace, no agent ---")


class Worker(threading.Thread):
    def __init__(self, s: Settings, pr: PR, stage: WorkerStage, me: str, existing: Marker | None):
        super().__init__(name=f"pr{pr.number}", daemon=True)
        self.s, self.pr, self.stage, self.me, self.existing = s, pr, stage, me, existing
        self.num = pr.number
        self.tab: TabHandle | None = existing.tab if existing else None
        self.proc: subprocess.Popen | None = None
        self.stopping = False

    def log(self, msg: str) -> None:
        log(msg, tag=f"worker[#{self.num}]")

    def herdr(self, *args: str) -> str:
        r = run(["herdr", *args])
        if r.returncode != 0:
            raise RuntimeError(f"herdr {' '.join(args[:2])} failed: {r.stderr.strip() or r.stdout.strip()}")
        return r.stdout

    def mark(self, busy: bool) -> None:
        if self.tab:
            write_marker(self.s, self.num, Marker(self.tab, self.stage.value, now_iso(), busy))

    def run(self) -> None:
        try:
            self.work()
        except Exception as e:  # noqa: BLE001 - one worker's failure must not take the loop down
            self.log(f"error: {e}")
            if self.tab:
                self.log(f"tab {self.tab.tab_id} left open so you can see what happened")
            notify(f"PR #{self.num}: {self.stage.value} worker failed", str(e)[:200])
        finally:
            self.mark(busy=False)

    def stop(self) -> None:
        """From the main thread on Ctrl-C: cut the blocking wait. The tab stays."""
        self.stopping = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()

    def sleep(self, seconds: float) -> None:
        end = time.monotonic() + seconds
        while not self.stopping and time.monotonic() < end:
            time.sleep(min(1.0, end - time.monotonic()))

    # -- steps ---------------------------------------------------------------

    def work(self) -> None:
        s, pr = self.s, self.pr
        if pr.head_owner not in (self.me, s.owner):
            raise RuntimeError(f"head branch belongs to {pr.head_owner or 'nobody GitHub will name'}, not {self.me} or {s.owner}; refusing")
        task = build_prompt(s, pr, self.stage)
        self.herdr("workspace", "list")

        if self.existing:
            tab = self.existing.tab
            self.log(f"prompting the open tab {tab.tab_id} again, now for {self.stage.value}")
            self.mark(busy=True)
        else:
            match s.backend:
                case Worktree(clone):
                    cwd = self.prepare_worktree(clone)
                    tab = self.tab = self.open_tab(cwd)
                    self.mark(busy=True)
                    self.start_agent_in_pane(tab)
                case Devcontainer():
                    tab = self.tab = self.open_tab(Path.home())
                    self.mark(busy=True)
                    self.start_agent_in_workspace(tab)
                case _ as unreachable:
                    assert_never(unreachable)
        if self.stopping:
            return

        pane = tab.pane_id
        run(["herdr", "pane", "report-metadata", pane, "--source", "prwatch",
             "--token", f"pr=#{self.num}", "--token", f"stage={self.stage.value}"])
        notify(f"PR #{self.num}: {self.stage.value} worker started", pr.title)

        self.log(f"prompting; waiting up to {s.worker_timeout_s // 60} min")
        self.proc = subprocess.Popen(
            ["herdr", "agent", "prompt", pane, task, "--wait", "--timeout", str(s.worker_timeout_s * 1000)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        rc = self.proc.wait()
        if self.stopping:
            outcome = Outcome.STOPPED
        elif rc == 0:
            outcome = Outcome.FINISHED
        else:
            outcome = Outcome.TIMED_OUT

        logf = s.logs / f"pr{self.num}-{self.stage.value}-{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}.txt"
        r = run(["herdr", "agent", "read", pane, "--source", "recent-unwrapped", "--lines", "200"])
        logf.write_text(r.stdout + r.stderr)
        self.log(f"worker {outcome.value} (agent {agent_status(pane)}); transcript tail in {logf}; "
                 f"tab {tab.tab_id} stays open until you /exit it")
        run(["herdr", "pane", "report-metadata", pane, "--source", "prwatch",
             "--token", f"pr=#{self.num}", "--token", f"stage={self.stage.value}:done"])
        # The body is the worker's own summary bullets, printable ASCII only:
        # herdr's CLI and notify-send both abort on an argument that is not
        # valid UTF-8, and a byte-based cut once split a glyph.
        bullets = [ln for ln in r.stdout.splitlines() if ln.startswith(("● ", "  - ", "- "))]
        summary = " ".join(re.sub(r"[^\x20-\x7e]", "", ln)[:160] for ln in bullets[-4:]).strip()
        match outcome:
            case Outcome.FINISHED:
                notify(f"PR #{self.num} ready to look at", f"{self.stage.value} worker done, tab open. {summary or pr.url}")
            case Outcome.TIMED_OUT:
                notify(f"PR #{self.num}: {self.stage.value} worker did not finish", f"tab open. {summary or logf}")
            case Outcome.STOPPED:
                pass
            case _ as unreachable:
                assert_never(unreachable)

    def prepare_worktree(self, clone: Path) -> Path:
        s, branch = self.s, self.pr.head_ref
        wt = s.worktrees / str(self.num)

        def git(cwd: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess:
            r = run(["git", "-C", str(cwd), *args])
            if check and r.returncode != 0:
                raise RuntimeError(f"git {args[0]} failed: {r.stderr.strip()}")
            return r

        if not (clone / ".git").exists():
            self.log(f"no clone at {clone}; cloning {s.repo}")
            clone.parent.mkdir(parents=True, exist_ok=True)
            r = run(["gh", "repo", "clone", s.repo, str(clone), "--", "--quiet"])
            if r.returncode != 0:
                raise RuntimeError(f"clone failed: {r.stderr.strip()}")
        git(clone, "worktree", "prune")
        git(clone, "fetch", "--quiet", "origin", branch, s.base)
        if wt.is_dir():
            # A previous worker's checkout. Bring it to the remote head without
            # losing anything: ff-only, and if that fails leave it for the human.
            git(wt, "checkout", "--quiet", branch, check=False)
            if git(wt, "merge", "--ff-only", "--quiet", f"origin/{branch}", check=False).returncode != 0:
                raise RuntimeError(f"{wt} has diverged from origin/{branch}; inspect it, then: "
                                   f"git -C {clone} worktree remove --force {wt}")
        else:
            # -B resets a stale local branch of that name to the remote head. It
            # fails if the branch is checked out elsewhere, which is the right
            # outcome: that checkout is somebody's.
            git(clone, "worktree", "add", "--quiet", "-B", branch, str(wt), f"origin/{branch}")
        git(wt, "branch", "--quiet", f"--set-upstream-to=origin/{branch}", branch, check=False)
        self.log(f"worktree {wt} at {git(wt, 'rev-parse', '--short', 'HEAD').stdout.strip()} on {branch}")
        return wt

    def open_tab(self, cwd: Path) -> TabHandle:
        # The workspace: --workspace, else the one this process runs in, else
        # the focused one.
        ws = self.s.workspace or os.environ.get("HERDR_WORKSPACE_ID")
        if not ws:
            wss = json.loads(self.herdr("workspace", "list"))["result"]["workspaces"]
            focused = [w for w in wss if w.get("focused")] or wss
            if not focused:
                raise RuntimeError("no herdr workspace to open a tab in")
            ws = focused[0]["workspace_id"]
        created = json.loads(self.herdr("tab", "create", "--workspace", ws, "--cwd", str(cwd),
                                        "--label", f"PR #{self.num}", "--no-focus"))
        result = created.get("result") or {}
        tab_id = (result.get("tab") or {}).get("tab_id")
        pane_id = (result.get("root_pane") or {}).get("pane_id")
        if not (tab_id and pane_id):
            raise RuntimeError(f"tab create returned no ids: {created}")
        self.log(f"tab {tab_id} pane {pane_id} in workspace {ws}")
        return TabHandle(tab_id, pane_id)

    def start_agent_in_pane(self, tab: TabHandle) -> None:
        """Worktree backend: Claude in the pane's own shell, permission posture
        explicit. The shell has to reach its prompt before agent start will
        take it; retry rather than guess."""
        pane = tab.pane_id
        out = ""
        for _ in range(6):
            self.sleep(2)
            if self.stopping:
                return
            r = run(["herdr", "agent", "start", f"pr{self.num}", "--kind", "claude", "--pane", pane,
                     "--timeout", "120000", "--", "--dangerously-skip-permissions"])
            out = (r.stdout + r.stderr).strip()
            if r.returncode == 0:
                return
            if "agent_pane_busy" not in out:
                break
        raise RuntimeError(f"claude did not come up in {pane}: {out or 'no output'}")

    def start_agent_in_workspace(self, tab: TabHandle) -> None:
        """Devcontainer backend: the pane execs dl, which builds or starts the
        workspace, runs Claude inside it, and reports the agent to herdr."""
        s, pane = self.s, tab.pane_id
        self.sleep(2)
        self.herdr("pane", "run", pane,
                   f"exec dl {s.repo}@{self.pr.head_ref} --rm -- claude --dangerously-skip-permissions")
        self.log(f"dl {s.repo}@{self.pr.head_ref} --rm; waiting up to {s.startup_timeout_s // 60} min for Claude")
        deadline = time.monotonic() + s.startup_timeout_s
        while not self.stopping and time.monotonic() < deadline:
            status = agent_status(pane)
            if status in ("idle", "blocked", "working"):
                self.log(f"claude is {status} in the workspace")
                return
            if status == "gone":
                raise RuntimeError("the pane closed before Claude came up: dl failed; run the dl line by hand to see why")
            self.sleep(5)
        if not self.stopping:
            raise RuntimeError(f"claude did not come up within {s.startup_timeout_s // 60} min; the tab is still open")


# ---------------------------------------------------------------------------
# the supervisor: one poll, and the loop around it

class Supervisor:
    def __init__(self, s: Settings, me: str):
        self.s, self.me = s, me
        self.workers: list[Worker] = []

    def reap(self) -> None:
        self.workers = [w for w in self.workers if w.is_alive()]

    def fetch(self) -> tuple[tuple[str, ...], list[dict], dict]:
        s = self.s
        # 1. required contexts: one call for the whole repo. Rulesets, not the
        #    legacy branch-protection endpoint, which 404s on some repos.
        r = run(["gh", "api", f"repos/{s.repo}/rules/branches/{s.base}"])
        rules = json.loads(r.stdout) if r.returncode == 0 else []
        write_json(s.raw / "rules.json", rules)
        required = tuple(c["context"] for rule in rules if rule.get("type") == "required_status_checks"
                         for c in rule["parameters"]["required_status_checks"])

        # 2. the list. Two calls, unioned: the PRs assigned to me, which are the
        #    only ones anything is ever dispatched for, and the ones I wrote,
        #    which are listed purely so the table can say `unassigned` instead
        #    of leaving me wondering whether the poll saw them at all. Never ask
        #    for `commits`: that query blows the 500k node limit.
        fields = ("number,title,updatedAt,createdAt,isDraft,mergeable,reviewDecision,statusCheckRollup,"
                  "headRefName,headRepositoryOwner,url,labels,author,assignees")
        seen: dict[int, dict] = {}
        for flag in ("--assignee", "--author"):
            for pr in gh_json(["pr", "list", "--repo", s.repo, flag, "@me", "--state", "open",
                               "--limit", "200", "--json", fields]):
                seen.setdefault(pr["number"], pr)
        prs = sorted(seen.values(), key=lambda p: -p["number"])
        write_json(s.raw / "list.json", prs)
        mine = sum(1 for pr in prs
                   if self.me in tuple(a.get("login") for a in (pr.get("assignees") or [])))
        log(f"open PRs: {len(prs)} listed, {mine} assigned to me; "
            f"required contexts: {', '.join(required) or '(none)'}")

        # 3. one batched GraphQL for threads / reviews / head commit date.
        gql: dict = {}
        if prs:
            body = [f'query {{\n  repository(owner: "{s.owner}", name: "{s.name}") {{']
            for pr in prs:
                n = pr["number"]
                body.append(f"""    p{n}: pullRequest(number: {n}) {{
      number mergeable mergeStateStatus headRefOid
      author {{ login }}
      commits(last:1){{ nodes {{ commit {{ committedDate }} }} }}
      reviewThreads(first:100){{ nodes {{ isResolved isOutdated comments(first:100){{ totalCount nodes {{ author{{login __typename}} createdAt }} }} }} }}
      reviews(last:50){{ nodes {{ state submittedAt author{{login __typename}} bodyText }} }}
    }}""")
            body.append("  }\n}")
            query = "\n".join(body)
            (s.raw / "q.graphql").write_text(query)
            data = gh_json(["api", "graphql", "-f", f"query={query}"])
            write_json(s.raw / "gql.json", data)
            gql = (data.get("data") or {}).get("repository") or {}
        return required, prs, gql

    def poll(self) -> None:
        s = self.s
        self.reap()
        tidy(s)
        log(f"repo={s.repo} me={self.me} mode={s.mode.value} busy={busy_workers(s)}/{s.max_workers} "
            f"tabs={len(marker_numbers(s))}")
        required, listed, gql = self.fetch()

        # 4. classify, 5. transitions
        prev = load_state(s)
        now = now_iso()
        prs = {l["number"]: classify_one(s, self.me, required, l, gql.get(f"p{l['number']}") or {},
                                         prev.prs.get(l["number"]) if prev else None, now)
               for l in listed}
        state = State(now, self.me, s.repo, required, prs)
        trans = transitions(state)
        write_json(s.trans_file, [{"number": t.pr.number, "stage": t.pr.stage.value, "prev_stage": t.pr.prev_stage,
                                   "title": t.pr.title, "url": t.pr.url, "first_seen": t.first_seen,
                                   "actionable": t.pr.stage in RANK, "reason": t.reason} for t in trans])

        # 6. decide. `ready` transitions notify. The worker candidates are this
        #    poll's dispatchable transitions plus the backlog: PRs an earlier
        #    poll wanted a worker for and held back, which stay pending because
        #    nothing about them will change on its own. Ranked ci_red,
        #    conflicting, comments_open, newest first within a stage. A request
        #    is held, in order, by: a worker still busy on this PR, the round
        #    budget, the worker cap. Every refusal is a log line. A PR whose tab
        #    is open and idle is prompted again in that tab.
        for t in trans:
            if t.pr.stage is QuietStage.READY:
                notify(f"PR #{t.pr.number} ready to merge", t.pr.title)
        fired = {t.pr.number: t.reason for t in trans if isinstance(t.pr.stage, WorkerStage)}
        candidates = [(p, p.stage) for p in prs.values()
                      if isinstance(p.stage, WorkerStage) and (p.number in fired or p.pending)]
        candidates.sort(key=lambda c: (RANK[c[1]], -c[0].number))
        dispatch: list[tuple[PR, WorkerStage, Marker | None]] = []
        held: list[int] = []
        for p, stage in candidates:
            reason = fired.get(p.number, "pending since an earlier poll")
            m = live_marker(s, p.number)
            if m and m.busy:
                log(f"#{p.number} {stage.value} ({reason}): its worker is still busy, kept pending")
                held.append(p.number)
            elif p.budget.used >= s.round_budget:
                log(f"#{p.number} {stage.value} ({reason}): round budget spent "
                    f"({p.budget.used}/{s.round_budget} today), not dispatching")
                notify(f"PR #{p.number} out of rounds", f"{stage.value}, {p.budget.used}/{s.round_budget} today; it needs a human")
            elif busy_workers(s) + len(dispatch) >= s.max_workers:
                log(f"#{p.number} {stage.value} ({reason}): worker cap {s.max_workers} reached, kept pending")
                held.append(p.number)
            else:
                dispatch.append((p, stage, m))

        # Rounds are consumed by a live dispatch, not by a transition: a dry-run
        # that only prints the prompt must not eat the budget the real run will
        # need. In dry-run the pending flag is still recorded, so the backlog
        # is visible.
        for p, _, _ in dispatch:
            spent = p.budget.used + 1 if s.mode is Mode.LIVE else p.budget.used
            prs[p.number] = replace(p, pending=False, budget=Budget(p.budget.day, spent))
        for n in held:
            prs[n] = replace(prs[n], pending=True)
        state = State(now, self.me, s.repo, required, prs)
        write_json(s.state_file, state.to_json())

        # 7. queue: what is actionable right now, ranked, budget-exhausted dropped.
        write_json(s.queue_file, build_queue(s, state))

        # 8. dispatch. Each turn is a thread of this process; the tab it runs
        #    in is not, and outlives both the turn and the process.
        for p, stage, m in dispatch:
            self.dispatch(prs[p.number], stage, m)

        # 9. report
        print_state(s, state)
        print(f"\ntransitions: {len(trans)}")
        for t in trans:
            print(f"  #{t.pr.number} [{'WAKE' if isinstance(t.pr.stage, WorkerStage) else 'quiet'}] {t.reason}")

    def dispatch(self, pr: PR, stage: WorkerStage, existing: Marker | None) -> None:
        match self.s.mode:
            case Mode.DRY_RUN:
                log(f"#{pr.number} {stage.value}: DRY RUN, the prompt that would be sent follows")
                print_dry_run(self.s, pr, stage, existing)
                notify(f"PR #{pr.number} would get a {stage.value} worker", "dry-run; drop --dry-run to dispatch")
            case Mode.LIVE:
                log(f"#{pr.number} {stage.value}: {'prompting its open tab' if existing else 'opening a worker tab'}")
                w = Worker(self.s, pr, stage, self.me, existing)
                w.start()
                self.workers.append(w)
            case _ as unreachable:
                assert_never(unreachable)

    def dispatch_one(self, num: int) -> None:
        s = self.s
        state = load_state(s)
        if not state:
            die(f"no state yet: run `prwatch {s.repo} --once` first")
        pr = state.prs.get(num)
        if not pr:
            die(f"PR #{num} is not in the state file (not yours, not open, or not on {s.repo})")
        stage = pr.stage
        if not isinstance(stage, WorkerStage):
            die(f"PR #{num} is {stage.value}, which dispatches no worker "
                f"(only {', '.join(w.value for w in WorkerStage)} do)")
        m = live_marker(s, num)
        if m and m.busy:
            die(f"PR #{num} has a worker busy in tab {m.tab.tab_id}")
        if s.mode is Mode.LIVE:
            today = now_iso()[:10]
            budget = pr.budget.for_day(today)
            pr = replace(pr, pending=False, budget=Budget(today, budget.used + 1))
            state.prs[num] = pr
            write_json(s.state_file, state.to_json())
        self.dispatch(pr, stage, m)
        self.wait_for_workers()

    def wait_for_workers(self) -> None:
        for w in self.workers:
            w.join()

    def shutdown(self) -> None:
        """Ctrl-C: stop waiting on turns in flight. The tabs are the human's
        and stay; the turns inside them carry on."""
        self.reap()
        for w in self.workers:
            w.stop()
        for w in self.workers:
            w.join(timeout=10)
        s = self.s
        open_tabs = [(n, m) for n in marker_numbers(s) if (m := live_marker(s, n))]
        if open_tabs:
            log(f"{len(open_tabs)} worker tab(s) stay open: "
                + ", ".join(f"#{n} ({'busy' if m.busy else 'idle'}, tab {m.tab.tab_id})" for n, m in open_tabs)
                + ". /exit in a tab ends it and cleans up.")


# ---------------------------------------------------------------------------
# main

def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="prwatch",
        description="PR supervisor: poll one repo's open PRs in this window and open a Claude worker tab on a transition.",
        epilog="Workers are dispatched unless --dry-run is given. Ctrl-C stops the polls; worker tabs stay open until you /exit them.",
    )
    p.add_argument("repo", help="OWNER/NAME, or a path to a local clone of it (which is then used as --clone)")
    p.add_argument("--dry-run", action="store_true", help="print the prompts a worker would get instead of opening one")
    p.add_argument("--once", action="store_true", help="one poll, then exit")
    p.add_argument("--interval", type=parse_duration, default=600, metavar="10m", help="time between polls (default 10m)")
    p.add_argument("--clone", metavar="PATH",
                   help="run workers in host worktrees cut from this clone instead of in a devlaunch workspace")
    p.add_argument("--base", default="main", metavar="BRANCH", help="base branch whose ruleset names the required checks (default main)")
    p.add_argument("--max-workers", type=int, default=10, metavar="N", help="concurrent worker turns in flight (default 10)")
    p.add_argument("--round-budget", type=int, default=3, metavar="N", help="dispatches per PR per UTC day (default 3)")
    p.add_argument("--stale-days", type=int, default=7, metavar="N", help="days of human silence before a PR is stale (default 7)")
    p.add_argument("--worker-timeout", type=parse_duration, default=1800, metavar="30m", help="how long a worker may hold its turn (default 30m)")
    p.add_argument("--startup-timeout", type=parse_duration, default=900, metavar="15m",
                   help="how long dl may take to build the workspace and start Claude (default 15m)")
    p.add_argument("--workspace", metavar="ID", help="herdr workspace for worker tabs (default: the focused one)")
    p.add_argument("--keep-worktrees", action="store_true", help="with --clone: never remove a worker's worktree, even when clean")
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")
    sub.add_parser("status", help="the last poll's state table and queue, no fetch")
    d = sub.add_parser("dispatch", help="one PR, its current stage, through the worker (honours --dry-run)")
    d.add_argument("pr", type=int)
    return p.parse_args(argv)


def whoami() -> str:
    r = run(["gh", "api", "user", "--jq", ".login"])
    if r.returncode != 0:
        die("gh is not authenticated")
    return r.stdout.strip()


def main(argv: list[str]) -> None:
    a = parse_args(argv)
    s = settings_from_args(a)
    if a.cmd == "status":
        state = load_state(s)
        if not state:
            die(f"no state yet: run `prwatch {s.repo} --once` first")
        print_state(s, state)
        print(f"\nlast poll: {state.generated_at}  worker tabs open: {len(marker_numbers(s))}, busy: {busy_workers(s)}")
        return

    # One process per repo. A second window on the same repo would spawn
    # duplicate workers off the same transitions.
    lock = open(s.state_dir / "lock", "w")  # noqa: SIM115 - held for the process lifetime
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die(f"another prwatch is already watching {s.repo} (lock: {s.state_dir / 'lock'})")

    def on_term(*_):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, on_term)
    # A non-interactive shell starts `&` jobs with SIGINT ignored, and Python
    # keeps an inherited SIG_IGN. Ctrl-C has to mean stop wherever this runs.
    signal.signal(signal.SIGINT, signal.default_int_handler)

    sup = Supervisor(s, whoami())
    try:
        if a.cmd == "dispatch":
            sup.dispatch_one(a.pr)
            return
        where = "devlaunch workspaces" if isinstance(s.backend, Devcontainer) else f"worktrees from {s.backend.clone}"
        log(f"watching {s.repo} every {s.interval // 60}m, {s.mode.value}, workers in {where}; "
            f"state in {s.state_dir}; Ctrl-C to stop")
        while True:
            try:
                sup.poll()
            except RuntimeError as e:
                log(f"poll failed: {e}")
            if a.once:
                sup.wait_for_workers()
                return
            log(f"next poll at {datetime.fromtimestamp(time.time() + s.interval):%H:%M:%S}")
            time.sleep(s.interval)
    except KeyboardInterrupt:
        print()
        log("interrupted")
        sup.shutdown()
        sys.exit(130)


if __name__ == "__main__":
    main(sys.argv[1:])
