        title = p.title[:50]
        if p.stale_approval:
            title += "  [stale approval]"
        if p.pending:
            title += "  [pending worker]"
        m = live_marker(s, p.number)
        if m and m.busy:
            title += "  [worker busy]"
        elif m:
            title += "  [your tab]" if m.adopted else "  [tab open]"
            if m.unfinished:
                title += f"  [retry owed: {m.outcome}]"
        elif p.head_ref in open_tabs.by_branch:
            title += "  [your tab]"
        elif p.head_ref in open_tabs.checkouts:
            title += "  [also checked out]"
        print(fmt.format(f"#{p.number}", p.stage.value, p.ci.value, p.mergeable.value,
                         f"{p.unresolved_threads}/{p.actionable_threads}",
