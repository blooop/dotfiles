# ---------------------------------------------------------------------------
# the worker: one PR + one WorkerStage -> one prompted turn of Claude in the
# PR's herdr tab, opening the tab first if the PR has none.
#
# The tab is the human's once it exists. It stays open after the turn so they
# can read what happened, carry on, or /exit; a later transition on the same
# PR is prompted into the same tab. Exiting is the cleanup, not prwatch:
#
# Devcontainer backend: the tab runs `exec dl OWNER/NAME@branch --rm -- claude`.
# dl creates the workspace from the repo's own devcontainer, forwards the gh
# and Claude logins, installs herdr inside and reports the agent to the pane,
# so `herdr agent prompt` reaches Claude in the container. When the human
# exits Claude, --rm deletes the workspace (refusing, and saying so, if the
# clone holds unpushed work) and the exec'd shell ends, so the pane and its
# tab close.
#
# Worktree backend: a host-side git worktree for the PR branch, cut from the
# clone; `herdr agent start` runs Claude in the pane's own shell. For repos
# whose devcontainer cannot be built on this host. Exiting Claude leaves the
# shell, so tidy() closes that tab and removes the worktree if it is clean.
#
# Both: `herdr agent prompt --wait` (bare --wait: the turn settles as `done`,
# never `idle`, and `--until idle` times out against a finished turn), then
# `herdr agent read` into logs/ and a notification that the PR is ready to be
# looked at.
#
# The prompt is the safety boundary. It names the one branch the worker may
# touch and forbids merge, close, force-push, amend, and `gh auth token`.

def build_prompt(s: Settings, pr: PR, stage: WorkerStage, parent: PR | None = None) -> str:
    n, branch, url, title = pr.number, pr.head_ref, pr.url, pr.title
    base = pr.base_ref
    # A stacked PR merges into another PR's branch, not the repo's base. Saying
    # so is what stops the worker fixing an inherited failure in the wrong
    # branch, or merging `main` into a child and burying the parent's diff.
    stacked = "" if parent is None else (
        f"\n\nThis PR is stacked: it merges into `{base}`, the head branch of PR "
        f"#{parent.number} (\"{parent.title}\"), not into `{s.base}`. Anything wrong that "
        f"also reproduces on #{parent.number} is that PR's to fix, not this one's -- say so in "
        f"your summary and change nothing here. Only fix what is genuinely this PR's own.")
    rules = f"""You are an unattended worker on one pull request. Hard rules, no exceptions:
- Work only on branch `{branch}` in this checkout. Never switch branches, never touch `{base}` or `{s.base}`.
- Never merge, close, or comment on the PR's state. Never force-push, never rebase a pushed branch, never amend a pushed commit. New commits only, then `git push`.
- Never run `gh auth token` or print any credential.
- Never resolve a review thread written by a human.
- Do not ask questions; there is nobody watching. Make the call, state the assumption in your final summary.
- When you are done, print a summary of at most five lines: what changed, the commit hashes, and what CI is doing. Then stop."""
    match stage:
        case WorkerStage.CI_RED:
            red = ", ".join(pr.ci_red_checks) or "unknown"
            return f"""Fix the failing required CI on PR #{n} ({url}), "{title}".
Failing required checks: {red}.

These jobs have already been re-run once on this exact commit and failed again, so treat the failure as real and reproducible. Do not re-run CI, do not queue anything to re-run it later, and do not stop at "this looks like a flake" -- that has been tested already.

Run `gh pr checks {n}` and read the failing logs with `gh run view <run-id> --log-failed` (get the run id from the check's URL). Fix the root cause in this branch, not the symptom, and do not disable, skip, or loosen a test or a lint to make it pass. Run the repo's pre-commit on the files you changed (`pre-commit run --from-ref origin/{base} --to-ref HEAD`, or its lint script if there is no .pre-commit-config.yaml). Commit with a message that says what was wrong, push, and stop. Do not wait for CI.

If the failure is not this PR's to fix -- it reproduces on the base branch, or the test covers code this branch never touched -- then change nothing, say which PR or commit owns it in your summary, and stop. An honest "not mine" is a better answer than a patch that hides it.{stacked}

{rules}"""
        case WorkerStage.CONFLICTING:
            return f"""Resolve the merge conflict on PR #{n} ({url}), "{title}".

Run `git fetch origin {base}` and `git merge origin/{base}` -- `{base}` is this PR's own base branch, which is not always the repo's. Resolve each conflict so the PR still does what its title and description say; read the conflicting hunks on both sides before choosing, and prefer keeping the base branch's changes to anything the PR did not deliberately touch. Build or run the tests that the touched files have, if that is feasible here; otherwise run the repo's pre-commit on the changed files. Commit the merge (a merge commit, not a rebase), push, and stop.{stacked}

{rules}"""
        case WorkerStage.COMMENTS_OPEN:
            return f"""Address the open review on PR #{n} ({url}), "{title}" ({pr.actionable_threads} thread(s) waiting on the author, plus any review body newer than the head commit).

Invoke the `respond` skill for PR {n} and follow it: fix what is right, push back on what is wrong, one reply per unresolved thread, fixes pushed before replies. One addition: before posting each reply, pass its text through the `unslop` skill so it reads as one or two plain sentences naming the change or the reason. Never resolve a thread a human wrote.

{rules}"""
        case _ as unreachable:
            assert_never(unreachable)


def print_dry_run(s: Settings, pr: PR, stage: WorkerStage, existing: Marker | None,
                  parent: PR | None = None) -> None:
    if existing and existing.adopted:
        where = f"your open tab {existing.tab.tab_id}, already on {pr.head_ref}"
    elif existing:
        where = f"the open tab {existing.tab.tab_id}"
    elif isinstance(s.backend, Devcontainer):
        where = "a new devlaunch workspace"
    else:
        where = f"a new worktree from {s.backend.clone}"
    print(f"--- DRY RUN: PR #{pr.number} ({stage.value}) on {s.repo}@{pr.head_ref}, in {where}. Prompt that would be sent: ---")
    print(build_prompt(s, pr, stage, parent))
    print("--- end of prompt; no tab, no workspace, no agent ---")


class Worker(threading.Thread):
    def __init__(self, s: Settings, pr: PR, stage: WorkerStage, me: str, existing: Marker | None,
                 parent: PR | None = None, no_change_turns: int = 0):
        super().__init__(name=f"pr{pr.number}", daemon=True)
        self.s, self.pr, self.stage, self.me, self.existing = s, pr, stage, me, existing
        self.parent = parent
        self.no_change_turns = no_change_turns
        self.num = pr.number
        self.tab: TabHandle | None = existing.tab if existing else None
        self.adopted = bool(existing and existing.adopted)
        self.outcome: Outcome | None = None
        self.proc: subprocess.Popen | None = None
        self.stopping = False

    def log(self, msg: str) -> None:
        log(msg, tag=f"worker[#{self.num}]")

    def herdr(self, *args: str) -> str:
        r = run(["herdr", *args])
        if r.returncode != 0:
            raise RuntimeError(f"herdr {' '.join(args[:2])} failed: {r.stderr.strip() or r.stdout.strip()}")
        return r.stdout

    def mark(self, busy: bool) -> None:
        if self.tab:
            # A running turn has no outcome yet, and its marker must not carry
            # the last one: that would read as a retry still owed.
            outcome = None if busy else (self.outcome.value if self.outcome else None)
            write_marker(self.s, self.num,
                         Marker(self.tab, self.stage.value, now_iso(), busy, self.adopted, outcome,
                                self.pr.fingerprint.to_json(), self.no_change_turns))

    def run(self) -> None:
        try:
            self.work()
        except Exception as e:  # noqa: BLE001 - one worker's failure must not take the loop down
            self.outcome = Outcome.FAILED
            self.log(f"error: {e}")
            if self.tab:
                self.log(f"tab {self.tab.tab_id} left open so you can see what happened")
            notify(f"PR #{self.num}: {self.stage.value} worker failed", str(e)[:200])
        finally:
            # An interrupt landing before the prompt goes out leaves no outcome
            # at all, and no outcome reads as "no turn ran here, nothing owed".
            # The PR is then orphaned: `conflicting` with an unchanged head
            # produces no new fingerprint however far main moves, so no
            # transition ever comes back for it.
            if self.outcome is None and self.stopping:
                self.outcome = Outcome.STOPPED
            self.mark(busy=False)

    def stop(self) -> None:
        """From the main thread on Ctrl-C: cut the blocking wait. The tab stays."""
        self.stopping = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()

    def sleep(self, seconds: float) -> None:
        end = time.monotonic() + seconds
        while not self.stopping and time.monotonic() < end:
            time.sleep(min(1.0, end - time.monotonic()))

    # -- steps ---------------------------------------------------------------

    def work(self) -> None:
        s, pr = self.s, self.pr
        if pr.head_owner not in (self.me, s.owner):
            raise RuntimeError(f"head branch belongs to {pr.head_owner or 'nobody GitHub will name'}, not {self.me} or {s.owner}; refusing")
        task = build_prompt(s, pr, self.stage, self.parent)
        self.herdr("workspace", "list")

        if self.existing:
            tab = self.existing.tab
            whose = "your" if self.adopted else "the"
            self.log(f"prompting {whose} open tab {tab.tab_id} on {pr.head_ref}, for {self.stage.value}")
            if self.adopted:
                self.log("its input box is cleared first, so anything you had typed there unsent "
                         "is discarded rather than submitted as part of the prompt")
            self.mark(busy=True)
            launched_with_task = False
        else:
            match s.backend:
                case Worktree(clone):
                    # `herdr agent start` passes agent args as argv, but encodes
                    # them for the target shell and refuses what it cannot encode
                    # -- a prompt with a newline in it comes back
                    # invalid_agent_argument, and every prompt here has one. So
                    # this backend still types into the input box.
                    cwd = self.prepare_worktree(clone)
                    tab = self.tab = self.open_tab(cwd)
                    self.mark(busy=True)
                    self.start_agent_in_pane(tab)
                    self.wait_ready(tab.pane_id)
                    launched_with_task = False
                case Devcontainer():
                    tab = self.tab = self.open_tab(Path.home())
                    self.mark(busy=True)
                    self.start_agent_in_workspace(tab, task)
                    launched_with_task = True
                case _ as unreachable:
                    assert_never(unreachable)
        if self.stopping:
            return

        pane = tab.pane_id
        run(["herdr", "pane", "report-metadata", pane, "--source", "prwatch",
             "--token", f"pr=#{self.num}", "--token", f"stage={self.stage.value}"])
        notify(f"PR #{self.num}: {self.stage.value} worker started", pr.title)

        self.log(f"waiting up to {s.worker_timeout_s // 60} min for the turn")
        outcome = self.await_launched_turn(pane) if launched_with_task else self.deliver(pane, task)
        self.outcome = outcome

        logf = s.logs / f"pr{self.num}-{self.stage.value}-{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}.txt"
        r = run(["herdr", "agent", "read", pane, "--source", "recent-unwrapped", "--lines", "200"])
        logf.write_text(r.stdout + r.stderr)
        self.log(f"worker {outcome.value} (agent {agent_status(pane)}); transcript tail in {logf}; "
                 f"tab {tab.tab_id} stays open until you /exit it")
        run(["herdr", "pane", "report-metadata", pane, "--source", "prwatch",
             "--token", f"pr=#{self.num}", "--token", f"stage={self.stage.value}:done"])
        # The body is the worker's own summary bullets, printable ASCII only:
        # herdr's CLI and notify-send both abort on an argument that is not
        # valid UTF-8, and a byte-based cut once split a glyph.
        bullets = [ln for ln in r.stdout.splitlines() if ln.startswith(("● ", "  - ", "- "))]
        summary = " ".join(re.sub(r"[^\x20-\x7e]", "", ln)[:160] for ln in bullets[-4:]).strip()
        match outcome:
            case Outcome.FINISHED:
                notify(f"PR #{self.num} ready to look at", f"{self.stage.value} worker done, tab open. {summary or pr.url}")
            case Outcome.RUNNING_ON:
                notify(f"PR #{self.num}: {self.stage.value} turn is longer than {s.worker_timeout_s // 60} min",
                       f"still going in its tab; nothing is owed. {summary or pr.url}")
            case Outcome.TIMED_OUT:
                notify(f"PR #{self.num}: {self.stage.value} worker did not finish", f"tab open. {summary or logf}")
            case Outcome.UNDELIVERED:
                notify(f"PR #{self.num}: {self.stage.value} prompt never reached Claude",
                       f"the text is in its input box, unsent. {logf}")
            case Outcome.FAILED:
                pass  # run() has already notified with the exception
            case Outcome.STOPPED:
                pass
            case _ as unreachable:
                assert_never(unreachable)

    def await_launched_turn(self, pane: str) -> Outcome:
        """Wait out a turn the agent started on its own.

        A task handed over at launch -- `dl ... -- claude <prompt>`, which is
        what `aid` is a shortcut for -- is submitted by Claude reading its own
        argument, so there is no composer to type into, no Enter to lose and no
        prompt call to wait on. That removes the delivery race at its source
        rather than retrying around it; `deliver` stays for adopted tabs, where
        Claude is already running and its input box is the only way in.

        Two waits, because one would not do: a settled state matches the idle
        moment before the agent has read its argument, and would report a turn
        that never started as finished."""
        start_by = time.monotonic() + TURN_START_S
        started = (self.herdr_wait(pane, ("working",), TURN_START_S)
                   or self.poll_until(pane, ("working",), start_by))
        if self.stopping:
            return Outcome.STOPPED
        if not started:
            self.log(f"the agent never began a turn within {TURN_START_S}s (now {agent_status(pane)}); "
                     f"waiting it out anyway in case it was quicker than the watch")
        return self.await_turn(pane, time.monotonic() + self.s.worker_timeout_s)

    def herdr_wait(self, pane: str, states: tuple[str, ...], timeout_s: float) -> bool:
        """`herdr agent wait`, held in self.proc so Ctrl-C can cut it.

        Returning early is not the same as timing out: the call errors straight
        away if the pane holds no agent yet, and reporting that as a thirty
        minute timeout is the mistake this whole area has already made once."""
        args = ["herdr", "agent", "wait", pane]
        for st in states:
            args += ["--until", st]
        args += ["--timeout", str(int(timeout_s * 1000))]
        began = time.monotonic()
        self.proc = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        out = (self.proc.communicate()[0] or "").strip()
        if self.proc.returncode == 0:
            return not self.stopping
        if not self.stopping and time.monotonic() - began < timeout_s / 2:
            self.log(f"agent wait --until {'/'.join(states)} gave up early: {out[:160] or 'no output'}")
        return False

    def poll_until(self, pane: str, states: tuple[str, ...], deadline: float) -> bool:
        """The fallback when the event wait cannot answer -- no agent in the
        pane yet, herdr restarted under us. Slower, but it cannot mistake an
        error for an outcome."""
        while not self.stopping and time.monotonic() < deadline:
            if agent_status(pane) in states:
                return True
            self.sleep(3)
        return False

    def wait_ready(self, pane: str) -> None:
        """Hold until the agent will take a submitted prompt, not merely until
        one exists. Between those two moments the text lands in the composer and
        the Enter is lost -- which is what happened to two of the first three
        workers, eight seconds after Claude appeared.

        `interactive_ready` is the real answer where herdr has one: it does, for
        agents it started (the worktree backend). For a Claude that dl started
        inside a devcontainer it answers None forever, and there the only thing
        available is to wait out the window; the retry in deliver() is what
        covers the rest."""
        deadline = time.monotonic() + PROMPT_SETTLE_S
        while not self.stopping and time.monotonic() < deadline:
            if interactive_ready(pane) is True:
                return
            self.sleep(1)

    def deliver(self, pane: str, task: str) -> Outcome:
        """Submit into a running agent's input box, then wait the turn out.

        Used where there is no launch to hand the task to: an adopted tab, and
        the worktree backend. Two things have to be true and neither is free.

        The box is cleared first. `herdr agent prompt` appends to whatever is
        typed there and submits the concatenation, so an unsent line becomes
        part of the prompt -- the human's draft, or the previous prompt on a
        retry -- and that is instructions to a worker running with permissions
        skipped, not a cosmetic problem.

        And the submit waits for `working`, not for a settled state. A bare
        `--wait` matches the first settle it observes and does not track turns,
        so on an agent that has just come up it matches the idle it was already
        in: #10660 was declared finished seventeen seconds into a thirty minute
        budget, its transcript read before Claude had written a word, while the
        turn it had just started ran on in the tab -- a false success, which is
        worse than a false failure because nothing comes back to it. Waiting
        for the turn to start and then for it to end cannot make that mistake,
        and it catches a lost Enter better than herdr's five second stall
        window: a prompt that never took never reaches `working`.
        """
        s = self.s
        for attempt in range(1, PROMPT_ATTEMPTS + 1):
            clear_composer(pane)
            self.proc = subprocess.Popen(
                ["herdr", "agent", "prompt", pane, task, "--wait", "--until", "working",
                 "--timeout", str(TURN_START_S * 1000)],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            out = (self.proc.communicate()[0] or "").strip()
            rc = self.proc.returncode
            if self.stopping:
                return Outcome.STOPPED
            # rc 0 is a turn observed starting. Otherwise the agent may still be
            # working -- it began just outside the window herdr watched -- and
            # re-sending then would queue the prompt twice.
            if rc == 0 or agent_status(pane) == "working":
                return self.await_turn(pane, time.monotonic() + s.worker_timeout_s)
            if agent_status(pane) == "blocked":
                self.log(f"the agent is blocked waiting on a human, which a worker cannot answer: "
                         f"{out[:160] or 'no output'}")
                return Outcome.UNDELIVERED
            if attempt == PROMPT_ATTEMPTS:
                break
            self.log(f"the prompt started no turn (attempt {attempt}/{PROMPT_ATTEMPTS}, agent "
                     f"{agent_status(pane)}): {out[:160] or 'no output'}; resending in {PROMPT_RETRY_S}s")
            self.sleep(PROMPT_RETRY_S)
            if self.stopping:
                return Outcome.STOPPED
        self.log(f"the prompt never started a turn after {PROMPT_ATTEMPTS} attempts; the text is in "
                 f"Claude's input box in {self.tab.tab_id if self.tab else pane}, unsent")
        return Outcome.UNDELIVERED

    def await_turn(self, pane: str, deadline: float) -> Outcome:
        """Wait a running turn out to its end."""
        settled = ("idle", "done", "blocked")
        left = max(1.0, deadline - time.monotonic())
        if self.herdr_wait(pane, settled, left) or self.poll_until(pane, settled, deadline):
            return Outcome.FINISHED
        return self.gave_up(pane)

    def gave_up(self, pane: str) -> Outcome:
        """Classify a wait that ended without the turn settling by what the
        agent is doing. Still working means the turn outlived the wait, which is
        not a failure and is owed nothing; anything else means it is not running
        and did not finish, which is."""
        if agent_status(pane) == "working":
            return Outcome.RUNNING_ON
        return Outcome.STOPPED if self.stopping else Outcome.TIMED_OUT

    def prepare_worktree(self, clone: Path) -> Path:
        s, branch = self.s, self.pr.head_ref
        wt = s.worktrees / str(self.num)

        def git(cwd: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess:
            r = run(["git", "-C", str(cwd), *args])
            if check and r.returncode != 0:
                raise RuntimeError(f"git {args[0]} failed: {r.stderr.strip()}")
            return r

        if not (clone / ".git").exists():
            self.log(f"no clone at {clone}; cloning {s.repo}")
            clone.parent.mkdir(parents=True, exist_ok=True)
            r = run(["gh", "repo", "clone", s.repo, str(clone), "--", "--quiet"])
            if r.returncode != 0:
                raise RuntimeError(f"clone failed: {r.stderr.strip()}")
        git(clone, "worktree", "prune")
        git(clone, "fetch", "--quiet", "origin", branch, s.base)
        if wt.is_dir():
            # A previous worker's checkout. Bring it to the remote head without
            # losing anything: ff-only, and if that fails leave it for the human.
            git(wt, "checkout", "--quiet", branch, check=False)
            if git(wt, "merge", "--ff-only", "--quiet", f"origin/{branch}", check=False).returncode != 0:
                raise RuntimeError(f"{wt} has diverged from origin/{branch}; inspect it, then: "
                                   f"git -C {clone} worktree remove --force {wt}")
        else:
            # -B resets a stale local branch of that name to the remote head. It
            # fails if the branch is checked out elsewhere, which is the right
            # outcome: that checkout is somebody's.
            git(clone, "worktree", "add", "--quiet", "-B", branch, str(wt), f"origin/{branch}")
        git(wt, "branch", "--quiet", f"--set-upstream-to=origin/{branch}", branch, check=False)
        self.log(f"worktree {wt} at {git(wt, 'rev-parse', '--short', 'HEAD').stdout.strip()} on {branch}")
        return wt

    def open_tab(self, cwd: Path) -> TabHandle:
        # The workspace: --workspace, else the one this process runs in, else
        # the focused one.
        ws = self.s.workspace or os.environ.get("HERDR_WORKSPACE_ID")
        if not ws:
            wss = json.loads(self.herdr("workspace", "list"))["result"]["workspaces"]
            focused = [w for w in wss if w.get("focused")] or wss
            if not focused:
                raise RuntimeError("no herdr workspace to open a tab in")
            ws = focused[0]["workspace_id"]
        created = json.loads(self.herdr("tab", "create", "--workspace", ws, "--cwd", str(cwd),
                                        "--label", devlaunch_label(self.s.name, self.pr.head_ref),
                                        "--no-focus"))
        result = created.get("result") or {}
        tab_id = (result.get("tab") or {}).get("tab_id")
        pane_id = (result.get("root_pane") or {}).get("pane_id")
        if not (tab_id and pane_id):
            raise RuntimeError(f"tab create returned no ids: {created}")
        self.log(f"tab {tab_id} pane {pane_id} in workspace {ws}")
        return TabHandle(tab_id, pane_id)

    def start_agent_in_pane(self, tab: TabHandle) -> None:
        """Worktree backend: Claude in the pane's own shell, permission posture
        explicit. No task here -- `agent start` refuses an argument with a
        newline in it, and every prompt has one -- so this one is typed in
        afterwards. The shell has to reach its prompt before agent start will
        take it; retry rather than guess."""
        pane = tab.pane_id
        out = ""
        for _ in range(6):
            self.sleep(2)
            if self.stopping:
                return
            r = run(["herdr", "agent", "start", f"pr{self.num}", "--kind", "claude", "--pane", pane,
                     "--timeout", "120000", "--", "--dangerously-skip-permissions",
                     "--model", self.s.model])
            out = (r.stdout + r.stderr).strip()
            if r.returncode == 0:
                return
            if "agent_pane_busy" not in out:
                break
        raise RuntimeError(f"claude did not come up in {pane}: {out or 'no output'}")

    def start_agent_in_workspace(self, tab: TabHandle, task: str) -> None:
        """Devcontainer backend: the pane execs dl, which builds or starts the
        workspace, runs Claude inside it, and reports the agent to herdr.

        `--rm` only when the workspace is prwatch's to delete. `dl` attaches to
        the workspace that is already running rather than making a second one,
        so on a branch the human already has open --rm would arm the delete on
        theirs, and their workspace would go when this worker's Claude exits.
        Adoption catches that case when their tab still holds an agent; this
        catches it when it does not, or when the workspace is running with no
        tab at all."""
        s, pane = self.s, tab.pane_id
        theirs = any(w["branch"] == self.pr.head_ref for w in dl_workspaces(s.repo))
        rm = "" if theirs else " --rm"
        if theirs:
            self.log(f"a devlaunch workspace for {self.pr.head_ref} is already yours; dropping --rm")
        self.sleep(2)
        self.herdr("pane", "run", pane,
                   f"exec dl {s.repo}@{self.pr.head_ref}{rm} -- claude "
                   f"--dangerously-skip-permissions --model {shlex.quote(s.model)} "
                   f"{shlex.quote(task)}")
        self.log(f"dl {s.repo}@{self.pr.head_ref}{rm} -- claude --model {s.model} <prompt>; "
                 f"waiting up to {s.startup_timeout_s // 60} min for Claude")
        deadline = time.monotonic() + s.startup_timeout_s
        while not self.stopping and time.monotonic() < deadline:
            status = agent_status(pane)
            if status in ("idle", "blocked", "working"):
                self.log(f"claude is {status} in the workspace")
                return
            if status == "gone":
                raise RuntimeError("the pane closed before Claude came up: dl failed; run the dl line by hand to see why")
            self.sleep(5)
        if not self.stopping:
            raise RuntimeError(f"claude did not come up within {s.startup_timeout_s // 60} min; the tab is still open")


# ---------------------------------------------------------------------------
# the supervisor: one poll, and the loop around it

class Supervisor:
    def __init__(self, s: Settings, me: str):
        self.s, self.me = s, me
        self.workers: list[Worker] = []
        self.capped: list[int] = []  # PRs the last poll held back on the worker cap alone

    def reap(self) -> None:
        self.workers = [w for w in self.workers if w.is_alive()]

    def wait_for_next_poll(self) -> None:
        """Sleep until the next poll is due, or until a worker finishes with a
        PR queued for the slot it just freed. `reap` only ran at the top of a
        poll, so a slot freed a minute into a ten minute sleep stayed idle for
        the other nine. The thread count is the signal rather than the markers:
        `mark(busy=True)` is written inside the worker, after its tab exists, so
        a just-dispatched worker is briefly uncounted and `busy_workers` would
        read a free slot that is already taken.
        """
        s = self.s
        self.reap()
        running = len(self.workers)
        deadline = time.monotonic() + s.interval
        while (left := deadline - time.monotonic()) > 0:
            time.sleep(min(DRAIN_TICK_S, left))
            self.reap()
            if self.capped and len(self.workers) < running:
                waiting = ", ".join(f"#{n}" for n in self.capped)
                log(f"a worker finished and {len(self.capped)} PR(s) are queued for the slot "
                    f"({waiting}); polling now rather than waiting out the interval")
                return

    def fetch(self) -> tuple[tuple[str, ...], list[dict], dict]:
        s = self.s
        # 1. required contexts: one call for the whole repo. Rulesets, not the
        #    legacy branch-protection endpoint, which 404s on some repos.
        r = run(["gh", "api", f"repos/{s.repo}/rules/branches/{s.base}"])
        rules = json.loads(r.stdout) if r.returncode == 0 else []
        write_json(s.raw / "rules.json", rules)
        required = tuple(c["context"] for rule in rules if rule.get("type") == "required_status_checks"
                         for c in rule["parameters"]["required_status_checks"])

        # 2. the list. Two calls, unioned, and either half is a claim worth a
        #    worker: the PRs assigned to me and the ones I wrote. The union is
        #    also why `unassigned` never fires -- every PR here satisfies the
        #    gate by the query that found it. Never ask for `commits`: that
        #    query blows the 500k node limit.
        fields = ("number,title,updatedAt,createdAt,isDraft,mergeable,reviewDecision,statusCheckRollup,"
                  "baseRefName,"
                  "headRefName,headRepositoryOwner,url,labels,author,assignees")
        seen: dict[int, dict] = {}
        for flag in ("--assignee", "--author"):
            for pr in gh_json(["pr", "list", "--repo", s.repo, flag, "@me", "--state", "open",
                               "--limit", "200", "--json", fields]):
                seen.setdefault(pr["number"], pr)
        prs = sorted(seen.values(), key=lambda p: -p["number"])
        write_json(s.raw / "list.json", prs)
        assigned = sum(1 for pr in prs
                       if self.me in tuple(a.get("login") for a in (pr.get("assignees") or [])))
        wrote = sum(1 for pr in prs if (pr.get("author") or {}).get("login") == self.me)
        log(f"open PRs: {len(prs)} listed, {assigned} assigned to me, {wrote} written by me "
            f"(either is enough); required contexts: {', '.join(required) or '(none)'}")

        # 3. one batched GraphQL for threads / reviews / head commit date.
        gql: dict = {}
        if prs:
            body = [f'query {{\n  repository(owner: "{s.owner}", name: "{s.name}") {{']
            for pr in prs:
                n = pr["number"]
                body.append(f"""    p{n}: pullRequest(number: {n}) {{
      number mergeable mergeStateStatus headRefOid
      author {{ login }}
      commits(last:1){{ nodes {{ commit {{ committedDate }} }} }}
      reviewThreads(first:100){{ nodes {{ isResolved isOutdated comments(first:100){{ totalCount nodes {{ author{{login __typename}} createdAt }} }} }} }}
      reviews(last:50){{ nodes {{ state submittedAt author{{login __typename}} bodyText }} }}
    }}""")
            body.append("  }\n}")
            query = "\n".join(body)
            (s.raw / "q.graphql").write_text(query)
            data = gh_json(["api", "graphql", "-f", f"query={query}"])
            write_json(s.raw / "gql.json", data)
            gql = (data.get("data") or {}).get("repository") or {}
        return required, prs, gql

    def poll(self) -> None:
        s = self.s
        self.reap()
        tidy(s)
        open_tabs = scan_open_tabs(s)
        log(f"repo={s.repo} me={self.me} mode={s.mode.value} busy={busy_workers(s)}/{s.max_workers} "
            f"tabs={len(marker_numbers(s))} yours={len(open_tabs.by_branch)}")
        required, listed, gql = self.fetch()

        # 4. classify, 5. transitions
        prev = load_state(s)
        now = now_iso()
        prs = {l["number"]: classify_one(s, self.me, required, l, gql.get(f"p{l['number']}") or {},
                                         prev.prs.get(l["number"]) if prev else None, now)
               for l in listed}
        state = State(now, self.me, s.repo, required, prs)
        trans = transitions(state)
        write_json(s.trans_file, [{"number": t.pr.number, "stage": t.pr.stage.value, "prev_stage": t.pr.prev_stage,
                                   "title": t.pr.title, "url": t.pr.url, "first_seen": t.first_seen,
                                   "actionable": t.pr.stage in RANK, "reason": t.reason} for t in trans])

        # 6. decide. `ready` transitions notify. The worker candidates are this
        #    poll's dispatchable transitions plus the backlog: PRs an earlier
        #    poll wanted a worker for and held back, which stay pending because
        #    nothing about them will change on its own. Ranked ci_red,
        #    conflicting, comments_open, newest first within a stage. A request
        #    is held, in order, by: a worker still busy on this PR, a CI run
        #    that has not finished deciding the red set, the round budget, or
        #    the worker cap. Every refusal is a log line, and every refusal
        #    holds the PR pending -- a refusal that does neither orphans it,
        #    since `conflicting` and `ci_red` produce no new fingerprint on
        #    their own however long they wait. A PR whose tab is open and idle
        #    is prompted again in that tab, whoever opened it.
        for t in trans:
            if t.pr.stage is QuietStage.READY:
                notify(f"PR #{t.pr.number} ready to merge", t.pr.title)
        fired = {t.pr.number: t.reason for t in trans if isinstance(t.pr.stage, WorkerStage)}
        # A turn that ran and did not work the PR earns another, exactly as a
        # held-back one does. Without this the PR is in neither set -- `pending`
        # was cleared when it was dispatched -- so it sits at the top of the
        # queue that nothing reads, and no transition will ever come for it.
        owed = {}
        for n in marker_numbers(s):
            m = live_marker(s, n)
            if m is None:
                continue
            if m.unfinished:
                owed[n] = m.outcome
            elif (p := prs.get(n)) and m.changed_nothing(p):
                owed[n] = "the turn finished without changing anything"

        for n, why in owed.items():
            # Not for one that is about to be stood down: the refusal below says
            # what actually happens, and announcing a retry that never comes is
            # worse than saying nothing -- it reads, every poll, as prwatch
            # promising work it has already decided against.
            if (m := live_marker(s, n)) and m.gave_up_twice:
                continue
            if isinstance((p := prs.get(n)) and p.stage, WorkerStage) and n not in fired:
                log(f"#{n} {p.stage.value}: last turn ended {why}; owed a retry")
        parents = stack_parents(prs)
        candidates = [(p, p.stage) for p in prs.values()
                      if isinstance(p.stage, WorkerStage)
                      and (p.number in fired or p.pending or p.number in owed)]
        candidates.sort(key=lambda c: (RANK[c[1]], -c[0].number))
        dispatch: list[tuple[PR, WorkerStage, Marker | None]] = []
        held: list[int] = []
        capped: list[int] = []
        retried: dict[int, list[str]] = {}
        for p, stage in candidates:
            reason = fired.get(p.number, "pending since an earlier poll")
            m = live_marker(s, p.number)
            if m and not open_tabs.promptable(m):
                log(f"#{p.number} {stage.value}: tab {m.tab.tab_id} outlived its Claude; "
                    f"dropping it and starting fresh")
                (s.workers / str(p.number)).unlink(missing_ok=True)
                m = None
            if not m and (t := open_tabs.by_branch.get(p.head_ref)):
                m = Marker(t, stage.value, now, busy=False, adopted=True)
                log(f"#{p.number} {stage.value}: adopting your open tab {t.tab_id} on {p.head_ref} "
                    f"rather than opening a second one")
            if not m and (wt := open_tabs.checkouts.get(p.head_ref)):
                log(f"#{p.number} {stage.value}: heads up, {p.head_ref} is also checked out at {wt} "
                    f"with nothing open on it; the worker pushes from its own clone, so that one "
                    f"will need a pull")
            if m and open_tabs.busy(m):
                whose = "you are" if m.adopted and not m.busy else "its worker is"
                log(f"#{p.number} {stage.value} ({reason}): {whose} still working in {m.tab.tab_id}, kept pending")
                held.append(p.number)
            elif m and m.gave_up_twice and m.changed_nothing(p):
                if not p.pending:
                    # Anything stacked on this PR is held behind it and will stay
                    # held now that prwatch has stopped working it. Naming those
                    # here is what keeps the rest of the stack from waiting in
                    # silence for a parent nobody has been told about.
                    # Only the ones actually being held, and the whole stack
                    # above rather than the direct children alone: a stood-down
                    # PR stays in a worker stage, so it goes on blocking every
                    # branch above it, not just the next one up. A stack twelve
                    # deep is a wall of numbers, so the tail is counted instead
                    # of listed.
                    kids = [c for c in stack_descendants(p.number, parents)
                            if (k := prs.get(c)) and blocked_by_stack(k, prs, parents)]
                    named = ", ".join(f"#{c}" for c in kids[:6])
                    rest = f" and {len(kids) - 6} more" if len(kids) > 6 else ""
                    also = (f"; {named}{rest} "
                            f"{'is' if len(kids) == 1 else 'are'} stacked above it and held too"
                            if kids else "")
                    log(f"#{p.number} {stage.value} ({reason}): two workers ran here and neither "
                        f"changed anything; leaving it for you rather than spending more "
                        f"rounds{also}")
                    notify(f"PR #{p.number} needs a human",
                           f"{stage.value}: two workers each concluded there was nothing to "
                           f"change here{also}")
                held.append(p.number)
            elif why := blocked_by_stack(p, prs, parents):
                # Once, not every ten minutes: holding sets `pending`, and the PR
                # stays held for as long as anything below it is unwell.
                if not p.pending:
                    log(f"#{p.number} {stage.value} ({reason}): stacked on {why}; kept pending")
                held.append(p.number)
            elif (stage is WorkerStage.CI_RED and s.rerun
                  and (todo := [r for r in p.ci_red_runs if r not in p.ci_rerun])):
                # A red required check is not always the PR's fault. Retrying the
                # failed jobs once per head costs no round and no worker, and it
                # is what a human does first. Only if the check fails again does
                # the PR earn a turn. The cap is the head sha: one retry per run
                # per push, so a genuinely broken test cannot become a retry loop.
                states = {r: run_retry_state(s, r) for r in todo}
                ready = [r for r, st in states.items() if st == "ready"]
                # A run still going after the bound is written off rather than
                # waited on again: the PR falls through to a worker on the next
                # branch, and `ci_rerun` remembers we are done trying so the
                # wait does not restart every poll.
                stale = [r for r, st in states.items() if st == "stale"]
                if stale and not ready:
                    log(f"#{p.number} {stage.value} ({reason}): run {', '.join(stale)} is still "
                        f"going after {RERUN_WAIT_MAX_MIN}m and "
                        f"{', '.join(p.ci_red_checks)} has already failed; giving up on the free "
                        f"retry and working it instead")
                    retried.setdefault(p.number, []).extend(stale)
                    dispatch.append((p, stage, m))
                elif not ready:
                    log(f"#{p.number} {stage.value} ({reason}): the run behind "
                        f"{', '.join(p.ci_red_checks) or 'the red set'} has not finished; "
                        f"retrying its failed jobs once it does, no round spent")
                    held.append(p.number)
                elif s.mode is Mode.DRY_RUN:
                    log(f"#{p.number} {stage.value} ({reason}): DRY RUN, would re-run the failed "
                        f"jobs of run(s) {', '.join(ready)} instead of spending a round")
                    held.append(p.number)
                else:
                    for r in ready:
                        if err := rerun_failed_jobs(s, r):
                            log(f"#{p.number} {stage.value}: could not re-run run {r}: {err}")
                        else:
                            log(f"#{p.number} {stage.value} ({reason}): re-ran the failed jobs of "
                                f"run {r} ({', '.join(p.ci_red_checks)}); no round spent, a worker "
                                f"goes out only if it fails again")
                            retried.setdefault(p.number, []).append(r)
                    held.append(p.number)
            elif p.budget.used >= s.round_budget:
                # Said once, not every ten minutes: the PR stays pending from
                # here, so this branch is reached on every later poll. The log
                # line was outside this guard and repeated all day -- five
                # times for one PR in a four hour run, saying nothing new each
                # time. The notification was always inside it.
                if not p.pending:
                    log(f"#{p.number} {stage.value} ({reason}): round budget spent "
                        f"({p.budget.used}/{s.round_budget} today), not dispatching")
                    notify(f"PR #{p.number} out of rounds",
                           f"{stage.value}, {p.budget.used}/{s.round_budget} today; it needs a human")
                # Held, exactly as the worker cap holds one. Without this the PR
                # leaves the candidate set for good: nothing about it will change
                # on its own, so no transition returns, and neither the budget
                # resetting at UTC midnight nor --round-budget being raised
                # brings it back.
                held.append(p.number)
            elif busy_workers(s) + len(dispatch) >= s.max_workers:
                log(f"#{p.number} {stage.value} ({reason}): worker cap {s.max_workers} reached, kept pending")
                held.append(p.number)
                capped.append(p.number)
            else:
                dispatch.append((p, stage, m))

        # Only the cap is worth waking the wait for: it is the one hold that a
        # worker finishing clears by itself. A budget or a settling CI run is
        # not shortened by polling sooner.
        self.capped = capped

        # Rounds are consumed by a live dispatch, not by a transition: a dry-run
        # that only prints the prompt must not eat the budget the real run will
        # need. In dry-run the pending flag is still recorded, so the backlog
        # is visible.
        for p, _, _ in dispatch:
            spent = p.budget.used + 1 if s.mode is Mode.LIVE else p.budget.used
            prs[p.number] = replace(p, pending=False, budget=Budget(p.budget.day, spent))
        for n in held:
            prs[n] = replace(prs[n], pending=True)
        # A retried run is remembered against this head, so the next poll lets the
        # PR through to a worker rather than re-running the same jobs for ever.
        for n, runs in retried.items():
            prs[n] = replace(prs[n], ci_rerun=tuple(sorted({*prs[n].ci_rerun, *runs})))
        state = State(now, self.me, s.repo, required, prs)
        write_json(s.state_file, state.to_json())

        # 7. queue: what is actionable right now, ranked, budget-exhausted dropped.
        write_json(s.queue_file, build_queue(s, state))

        # 8. dispatch. Each turn is a thread of this process; the tab it runs
        #    in is not, and outlives both the turn and the process.
        for p, stage, m in dispatch:
            self.dispatch(prs[p.number], stage, m, prs.get(parents.get(p.number, -1)))

        # 9. report
        print_state(s, state, open_tabs)
        print(f"\ntransitions: {len(trans)}")
        for t in trans:
            print(f"  #{t.pr.number} [{'WAKE' if isinstance(t.pr.stage, WorkerStage) else 'quiet'}] {t.reason}")

    def dispatch(self, pr: PR, stage: WorkerStage, existing: Marker | None,
                 parent: PR | None = None) -> None:
        match self.s.mode:
            case Mode.DRY_RUN:
                log(f"#{pr.number} {stage.value}: DRY RUN, the prompt that would be sent follows")
                print_dry_run(self.s, pr, stage, existing, parent)
                notify(f"PR #{pr.number} would get a {stage.value} worker", "dry-run; drop --dry-run to dispatch")
            case Mode.LIVE:
                where = ("prompting your open tab" if existing and existing.adopted else
                         "prompting its open tab" if existing else "opening a worker tab")
                log(f"#{pr.number} {stage.value}: {where}")
                w = Worker(self.s, pr, stage, self.me, existing, parent,
                           no_change_turns=(existing.no_change_turns
                                            + 1 if existing and existing.changed_nothing(pr) else 0))
                w.start()
                self.workers.append(w)
            case _ as unreachable:
                assert_never(unreachable)

    def dispatch_one(self, num: int) -> None:
        s = self.s
        state = load_state(s)
        if not state:
            die(f"no state yet: run `prwatch {s.repo} --once` first")
        pr = state.prs.get(num)
        if not pr:
            die(f"PR #{num} is not in the state file (not yours, not open, or not on {s.repo})")
        stage = pr.stage
        if not isinstance(stage, WorkerStage):
            die(f"PR #{num} is {stage.value}, which dispatches no worker "
                f"(only {', '.join(w.value for w in WorkerStage)} do)")
        open_tabs = scan_open_tabs(s)
        m = live_marker(s, num)
        if m and not open_tabs.promptable(m):
            log(f"#{num}: tab {m.tab.tab_id} outlived its Claude; dropping it and starting fresh")
            (s.workers / str(num)).unlink(missing_ok=True)
            m = None
        if not m and (t := open_tabs.by_branch.get(pr.head_ref)):
            m = Marker(t, stage.value, now_iso(), busy=False, adopted=True)
            log(f"#{num}: your tab {t.tab_id} is already on {pr.head_ref}; prompting it")
        if m and open_tabs.busy(m):
            die(f"PR #{num}: somebody is mid-turn in tab {m.tab.tab_id}; try again when it settles")
        if s.mode is Mode.LIVE:
            today = now_iso()[:10]
            budget = pr.budget.for_day(today)
            pr = replace(pr, pending=False, budget=Budget(today, budget.used + 1))
            state.prs[num] = pr
            write_json(s.state_file, state.to_json())
        self.dispatch(pr, stage, m)
        self.wait_for_workers()

    def wait_for_workers(self) -> None:
        for w in self.workers:
            w.join()

    def shutdown(self) -> None:
        """Ctrl-C: stop waiting on turns in flight. The tabs are the human's
        and stay; the turns inside them carry on."""
        self.reap()
        for w in self.workers:
            w.stop()
        for w in self.workers:
            w.join(timeout=10)
        s = self.s
        open_tabs = [(n, m) for n in marker_numbers(s) if (m := live_marker(s, n))]
        if open_tabs:
            log(f"{len(open_tabs)} worker tab(s) stay open: "
                + ", ".join(f"#{n} ({'busy' if m.busy else 'idle'}, tab {m.tab.tab_id})" for n, m in open_tabs)
                + ". /exit in a tab ends it and cleans up.")


