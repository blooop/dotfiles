#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml"]
# ///
"""ralph — Hat-based Claude Code orchestrator."""

import argparse
import subprocess
import sys
from pathlib import Path

import yaml

MAX_HANDOFF = 4000
MAX_DIFF = 8000


def find_config() -> Path:
    """Walk up from cwd to find ralph.yml."""
    d = Path.cwd()
    while True:
        cfg = d / "ralph.yml"
        if cfg.is_file():
            return cfg
        if d.parent == d:
            break
        d = d.parent
    print("error: ralph.yml not found", file=sys.stderr)
    sys.exit(1)


def load_config(path: Path) -> dict:
    with open(path) as f:
        return yaml.safe_load(f)


def git_head_sha() -> str | None:
    r = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        capture_output=True, text=True,
    )
    return r.stdout.strip() if r.returncode == 0 else None


def git_diff_since(sha: str | None) -> str:
    if not sha:
        return ""
    r = subprocess.run(
        ["git", "diff", sha],
        capture_output=True, text=True,
    )
    return r.stdout


def truncate(s: str, limit: int) -> str:
    if len(s) <= limit:
        return s
    return s[:limit] + "\n... (truncated)"


def build_handoff_prompt(
    task: str,
    prev_output: str | None,
    diff: str,
) -> str:
    parts = [f"## Task\n{task}"]
    if prev_output:
        parts.append(
            f"## Previous Hat Output\n{truncate(prev_output, MAX_HANDOFF)}"
        )
    if diff.strip():
        parts.append(
            f"## Changes Made So Far (git diff)\n```diff\n{truncate(diff, MAX_DIFF)}\n```"
        )
    return "\n\n".join(parts)


def run_claude(
    hat_prompt: str,
    user_prompt: str,
    model: str | None,
    permission_mode: str,
) -> str:
    cmd = ["claude", "--append-system-prompt", hat_prompt, "-p"]
    if model:
        cmd += ["--model", model]
    cmd += ["--permission-mode", permission_mode]
    cmd.append(user_prompt)

    print("  running claude ...", file=sys.stderr)
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0 and r.stderr:
        print(f"  claude stderr: {r.stderr[:500]}", file=sys.stderr)
    return r.stdout


def run_chain(config: dict, chain_name: str, task: str) -> int:
    chains = config.get("chains", {})
    if chain_name not in chains:
        hats = config.get("hats", {})
        if chain_name in hats:
            chains[chain_name] = {
                "steps": [chain_name],
                "description": hats[chain_name].get("description", ""),
            }
        else:
            print(f"error: unknown chain or hat '{chain_name}'", file=sys.stderr)
            return 1

    chain = chains[chain_name]
    steps = chain["steps"]
    max_iter = chain.get("max_iterations", 1)
    marker = chain.get("completion_marker", "LOOP_COMPLETE")
    defaults = config.get("defaults", {})
    model = defaults.get("model")
    perm = defaults.get("permission_mode", "auto")
    hats = config.get("hats", {})

    for s in steps:
        if s not in hats:
            print(f"error: hat '{s}' not found", file=sys.stderr)
            return 1

    baseline_sha = git_head_sha()
    prev_output = None

    for iteration in range(1, max_iter + 1):
        if max_iter > 1:
            print(f"--- iteration {iteration}/{max_iter} ---", file=sys.stderr)

        for step_name in steps:
            print(f"[{step_name}]", file=sys.stderr)

            diff = git_diff_since(baseline_sha)
            prompt = build_handoff_prompt(task, prev_output, diff)
            prev_output = run_claude(hats[step_name]["prompt"], prompt, model, perm)

        if max_iter > 1:
            if prev_output and marker in prev_output:
                print("completion marker found, done.", file=sys.stderr)
                break
            if iteration == max_iter:
                print(
                    f"warning: max iterations ({max_iter}) reached without completion",
                    file=sys.stderr,
                )
                print(prev_output or "", end="")
                return 1

    print(prev_output or "", end="")
    return 0


def list_chains(config: dict):
    chains = config.get("chains", {})
    hats = config.get("hats", {})
    print("Chains:")
    for name, chain in chains.items():
        desc = chain.get("description", "")
        steps = " → ".join(chain.get("steps", []))
        loop = f" (loop ≤{chain['max_iterations']})" if "max_iterations" in chain else ""
        print(f"  {name:20s} {steps}{loop}")
        if desc:
            print(f"  {'':20s} {desc}")
    print("\nHats (usable as single-step chains):")
    for name, hat in hats.items():
        desc = hat.get("description", "")
        print(f"  {name:20s} {desc}")


def main():
    parser = argparse.ArgumentParser(
        prog="ralph",
        description="Hat-based Claude Code orchestrator",
    )
    parser.add_argument("chain", nargs="?", help="chain or hat name to run")
    parser.add_argument("prompt", nargs="?", default="", help="task prompt")
    parser.add_argument("--list", action="store_true", help="list available chains")
    args = parser.parse_args()

    config_path = find_config()
    config = load_config(config_path)

    if args.list:
        list_chains(config)
        return

    if not args.chain:
        parser.print_help()
        sys.exit(1)

    task = args.prompt
    if not task and not sys.stdin.isatty():
        task = sys.stdin.read().strip()

    # Fall back to chain/hat description if no prompt given
    if not task:
        chains = config.get("chains", {})
        hats = config.get("hats", {})
        if args.chain in chains:
            task = chains[args.chain].get("description", "")
        elif args.chain in hats:
            task = hats[args.chain].get("description", "")

    if not task:
        print("error: no prompt provided and chain has no description", file=sys.stderr)
        sys.exit(1)

    sys.exit(run_chain(config, args.chain, task))


if __name__ == "__main__":
    main()
