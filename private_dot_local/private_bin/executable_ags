#!/bin/bash

# ags - Austin Gregg-Shell
# Isolated shell with full dotfiles that doesn't affect the host
#
# Usage:    ags              # enter isolated shell
#           ags <container>  # enter isolated shell inside a running docker container
#           ags [<container>] -- <command> [args ...]
#           ags update       # reinstall dotfiles
#           ags uninstall    # remove ags and cached environment

set -e

# ags <container>: inject this script into a running container and run it there.
# Runs before the nesting guard — entering a container from an ags shell is fine.
if [ -n "${1:-}" ] && [ "$1" != "--" ] && [ "$1" != "update" ] && [ "$1" != "uninstall" ]; then
    container=$1
    shift
    if ! command -v docker >/dev/null 2>&1; then
        echo "ags: unknown argument '$container' (docker not available)" >&2
        exit 1
    fi
    if [ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" != "true" ]; then
        echo "ags: no running container named '$container'" >&2
        exit 1
    fi
    # Stage a world-readable copy: docker cp preserves mode but sets owner to
    # root, so a 700 source would be unreadable by the container user
    staged=$(mktemp)
    cat "$0" > "$staged"
    chmod 755 "$staged"
    docker cp "$staged" "$container:/tmp/ags"
    rm -f "$staged"
    tty_flag=""
    [ -t 0 ] && tty_flag="-t"
    # docker exec defaults TERM to plain xterm, which disables most color detection
    exec docker exec -i $tty_flag -e AGS_SHELL= -e TERM="${TERM:-xterm-256color}" "$container" bash /tmp/ags "$@"
fi

# Nesting guard
if [ -n "$AGS_SHELL" ]; then
    echo "Already inside ags"
    exit 0
fi

AGS_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/ags"

case "${1:-}" in
    uninstall)
        rm -rf "$AGS_HOME"
        rm -f "$HOME/.local/bin/ags"
        echo "ags uninstalled"
        exit 0
        ;;
    update)
        rm -f "$AGS_HOME/.installed"
        echo "Updating ags..."
        exec "$0"
        ;;
esac

if [ ! -f "$AGS_HOME/.installed" ]; then
    if ! command -v curl >/dev/null 2>&1; then
        echo "ags: curl is required to bootstrap the environment" >&2
        exit 1
    fi
    mkdir -p "$AGS_HOME"

    # A fresh HOME has no distro .bashrc/.profile (and /etc/skel may be empty),
    # so a login shell would load nothing: no colors, no aliases, no pixi PATH.
    # Seed known-good files; chezmoi's modify_dot_bashrc preserves this content.
    if [ ! -f "$AGS_HOME/.bashrc" ]; then
        cat > "$AGS_HOME/.bashrc" <<'EOF'
# Seeded by ags — fresh HOME has no distro bashrc
case $- in *i*) ;; *) return ;; esac

HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize

if command -v tput >/dev/null 2>&1 && tput setaf 1 >/dev/null 2>&1; then
    PS1='\[\e[01;35m\][ags]\[\e[00m\] \[\e[01;32m\]\u@\h\[\e[00m\]:\[\e[01;34m\]\w\[\e[00m\]\$ '
else
    PS1='[ags] \u@\h:\w\$ '
fi

command -v dircolors >/dev/null 2>&1 && eval "$(dircolors -b)"
alias ls='ls --color=auto'
alias grep='grep --color=auto'

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

if [ -f ~/.bash_env ]; then
    . ~/.bash_env
fi
EOF
    fi
    if [ ! -f "$AGS_HOME/.profile" ]; then
        cat > "$AGS_HOME/.profile" <<'EOF'
# Seeded by ags
PATH="$HOME/.local/bin:$PATH"
if [ -n "$BASH_VERSION" ] && [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
EOF
    fi

    echo "Installing ags environment..."
    # AGS_SHELL=1 tells chezmoi templates to omit personal info (git identity)
    # so ags is safe on shared machines. Footprint is exactly this script and
    # $AGS_HOME — nothing else on the machine is modified.
    HOME="$AGS_HOME" AGS_SHELL=1 bash -c 'curl -fsSL https://raw.githubusercontent.com/blooop/dotfiles/main/install.sh | DEVPOD=1 bash'
    touch "$AGS_HOME/.installed"
fi

# Pixi's exposed-command trampolines record an absolute environment prefix, but
# $AGS_HOME resolves to a different absolute path for a different user: the same
# cache directory bind-mounted into a container is reached as
# /home/<container-user>/.local/share/ags rather than /home/<host-user>/... .
# Whichever side bootstrapped the cache owns the trampolines, and from the other
# side every exposed command fails with ENOENT while the environments themselves
# are intact. `.installed` is set by then, so nothing re-bootstraps to repair it.
#
# `pixi global sync` re-exposes the manifest's commands against the current
# prefix, rewriting the trampolines in place, and needs no network when the
# environments are already installed. Detecting the mismatch is one file read, so
# it runs every time; the sync only fires when the cache has changed sides.
#
# Repairing the trampolines rather than just reordering PATH is what fixes the
# interactive shell: .bash_env prepends $PIXI_HOME/bin, so it lands ahead of
# anything this script exports a moment earlier. `ags -- <cmd>` avoided that by
# exec'ing directly with environment bins first, which is why one-shot commands
# kept working from both sides while `ags` itself did not.
trampoline_dir="$AGS_HOME/.pixi/bin/trampoline_configuration"
if [ -d "$trampoline_dir" ]; then
    recorded_exe=$(sed -n 's/.*"exe"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$trampoline_dir"/*.json 2>/dev/null | head -1)
    if [ -n "$recorded_exe" ] && [ "${recorded_exe#"$AGS_HOME"/}" = "$recorded_exe" ]; then
        if command -v pixi >/dev/null 2>&1; then
            echo "ags: cache was last exposed under ${recorded_exe%%/.pixi/*} — re-exposing for $AGS_HOME"
            if ! PIXI_HOME="$AGS_HOME/.pixi" pixi global sync >/dev/null 2>&1; then
                echo "ags: warning: re-exposing failed; run 'ags update' to rebuild" >&2
            fi
        else
            # Environments still work, so leave the cache alone rather than
            # rebuilding it: `ags -- <cmd>` bypasses the trampolines entirely.
            echo "ags: warning: cache was exposed under another path and pixi is not available to repair it" >&2
            echo "ags: exposed commands may fail — 'ags -- <cmd>' still works" >&2
        fi
    fi
fi

if [ "${1:-}" = "--" ]; then
    shift
    if [ "$#" -eq 0 ]; then
        echo "ags: -- requires a command" >&2
        exit 2
    fi
    # Pixi's exposed-command trampolines contain an absolute environment
    # prefix. A cache mounted under another username can therefore retain
    # valid environments but broken trampolines. Direct environment bins
    # first make one-shot commands portable across those cache relocations.
    command_path="$AGS_HOME/.local/bin"
    for environment_bin in "$AGS_HOME"/.pixi/envs/*/bin; do
        [ -d "$environment_bin" ] && command_path="$command_path:$environment_bin"
    done
    HOME="$AGS_HOME" PATH="$command_path:$AGS_HOME/.pixi/bin:$PATH" AGS_SHELL=1 exec "$@"
fi

HOME="$AGS_HOME" AGS_SHELL=1 exec bash -l
