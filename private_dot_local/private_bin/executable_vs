#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""vs — attach to dev containers locally or on another machine over SSH.

Assumes the containers already exist and VS Code has attached to them before
(container creation is devlaunch's job). Mines VS Code's workspaceStorage for
every attached-container / dev-container window you've ever opened, checks
which containers are currently running (docker ps locally and over ssh),
lets you multi-select with fzf, starts any stopped containers, and launches
`code --folder-uri` for each selection.

For a terminal workspace in a container (the old `vst`), use `grove`, which
manages a tree of worktree+session workspaces and rides `ags` into containers.

Usage:
    vs                  # fzf picker — TAB to multi-select, ctrl-x to forget, Enter to launch
    vs k1 k3ci          # batch: launch every workspace matching each token
    vs -a [token ...]   # launch all known workspaces (optionally filtered)
    vs -l               # list known workspaces and container status
    vs -H <host>        # also scan a host for running containers (repeatable)
    vs -n ...           # dry-run: print commands without executing them
"""

import argparse
import json
import shlex
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import unquote, urlparse

STORAGE_DIRS = [
    Path.home() / ".config/Code/User/workspaceStorage",
    Path.home() / ".config/Code - Insiders/User/workspaceStorage",
]
# Timestamps of the last launch of each entry via this tool, keyed by
# entry_key(). Folded into the picker's recency sort so an attach launched
# from vs floats up even if VS Code hasn't rewritten its workspaceStorage yet.
LAUNCHES_FILE = Path.home() / ".local/state/vs/launches.json"
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=4"]

GREEN, RED, YELLOW, DIM, RESET = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"
STATE_COLOR = {"running": GREEN, "exited": RED, "created": YELLOW, "paused": YELLOW}


@dataclass
class Entry:
    container: str  # container name, or hostPath for dev-container entries
    host: str | None  # None = local docker, else ssh host as VS Code knows it
    path: str  # workspace path inside the container
    uri: str  # folder-uri to relaunch (stored verbatim when from history)
    kind: str = "attach"  # "attach" | "devcontainer" | "new"
    mtime: float = 0.0
    state: str = "?"
    sources: list[Path] = field(default_factory=list)  # workspaceStorage dirs this entry came from

    @property
    def label(self) -> str:
        return f"{self.container}@{self.host or 'local'}"

    @property
    def key(self) -> str:
        """Stable identity for the launches state file (mirrors the
        (container, host, path) dedup key used by collect_history)."""
        return f"{self.container}@{self.host or 'local'}:{self.path}"


def parse_remote_uri(uri: str) -> Entry | None:
    """Parse a vscode-remote:// URI into an Entry, or None if not a container."""
    parsed = urlparse(uri)
    if parsed.scheme != "vscode-remote":
        return None
    authority = unquote(parsed.netloc)
    host = None
    for part in authority.split("@")[1:]:
        if part.startswith("ssh-remote+"):
            host = part.split("+", 1)[1]
    head = authority.split("@", 1)[0]
    kind, _, hexpart = head.partition("+")
    if kind not in ("attached-container", "dev-container"):
        return None
    try:
        payload = bytes.fromhex(hexpart).decode()
    except ValueError:
        return None
    if payload.startswith("{"):
        meta = json.loads(payload)
        container = meta.get("containerName") or meta.get("hostPath") or payload
    else:
        container = payload
    container = container.lstrip("/").split("/")[-1] if kind == "dev-container" else container.lstrip("/")
    return Entry(
        container=container,
        host=host,
        path=parsed.path or "/",
        uri=uri,
        kind="attach" if kind == "attached-container" else "devcontainer",
    )


def collect_history() -> list[Entry]:
    """One Entry per (container, host, path) ever opened, newest first.

    Several workspaceStorage dirs can map to the same key (reopened from
    different windows); keep the newest one's metadata but remember every
    source dir so deletion prunes them all and the entry can't resurrect."""
    seen: dict[tuple, Entry] = {}
    for storage in STORAGE_DIRS:
        if not storage.is_dir():
            continue
        for ws_json in storage.glob("*/workspace.json"):
            try:
                folder = json.loads(ws_json.read_text()).get("folder", "")
            except (OSError, json.JSONDecodeError):
                continue
            entry = parse_remote_uri(folder)
            if entry is None:
                continue
            entry.mtime = ws_json.stat().st_mtime
            entry.sources = [ws_json.parent]
            key = (entry.container, entry.host, entry.path)
            cur = seen.get(key)
            if cur is None:
                seen[key] = entry
            elif entry.mtime > cur.mtime:
                entry.sources += cur.sources
                seen[key] = entry
            else:
                cur.sources += entry.sources
    return sorted(seen.values(), key=lambda e: -e.mtime)


def docker(host: str | None, *args: str) -> list[str]:
    if host:
        # ssh joins args with spaces and the remote shell re-splits them,
        # so the whole remote command must be quoted as one string
        return ["ssh", *SSH_OPTS, host, shlex.join(["docker", *args])]
    return ["docker", *args]


def container_states(host: str | None) -> dict[str, str] | None:
    """Map of container name -> state on a docker host, None if unreachable."""
    try:
        out = subprocess.run(
            docker(host, "ps", "-a", "--format", "{{.Names}}\t{{.State}}"),
            capture_output=True, text=True, timeout=10,
        )
    except subprocess.TimeoutExpired:
        return None
    if out.returncode != 0:
        return None
    states = {}
    for line in out.stdout.splitlines():
        name, _, state = line.partition("\t")
        states[name] = state
    return states


def workdir_of(host: str | None, name: str) -> str:
    out = subprocess.run(
        docker(host, "inspect", "--format", "{{.Config.WorkingDir}}", name),
        capture_output=True, text=True,
    )
    wd = out.stdout.strip()
    return wd if wd.startswith("/") else "/"


def attach_uri(name: str, host: str | None, path: str) -> str:
    hexpart = json.dumps({"containerName": f"/{name}"}).encode().hex()
    suffix = f"@ssh-remote+{host}" if host else ""
    return f"vscode-remote://attached-container+{hexpart}{suffix}{path}"


def load_launches() -> dict[str, float]:
    """Map of entry.key -> unix time of its last launch via this tool."""
    try:
        data = json.loads(LAUNCHES_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def record_launches(keys: list[str]) -> None:
    """Stamp the given entry keys with the current time, merging into any
    existing record. Best-effort: a write failure must never fail a launch."""
    if not keys:
        return
    data = load_launches()
    now = time.time()
    for k in keys:
        data[k] = now
    try:
        LAUNCHES_FILE.parent.mkdir(parents=True, exist_ok=True)
        LAUNCHES_FILE.write_text(json.dumps(data))
    except OSError:
        pass


def gather(extra_hosts: list[str]) -> list[Entry]:
    entries = collect_history()
    hosts = {e.host for e in entries if e.kind == "attach"} | {None} | set(extra_hosts)
    with ThreadPoolExecutor(max_workers=8) as pool:
        states = dict(zip(hosts, pool.map(container_states, hosts)))
    known = {(e.container, e.host) for e in entries}
    for host, st in states.items():
        for name, state in (st or {}).items():
            if state == "running" and (name, host) not in known:
                entries.append(Entry(name, host, "", "", kind="new"))
    for e in entries:
        if e.kind == "devcontainer":
            continue
        st = states.get(e.host)
        e.state = "no ssh" if st is None else st.get(e.container, "missing")
    # Running first, then most-recently-used: recency is the later of VS Code's
    # last touch (mtime) and the last time we launched the entry ourselves.
    launches = load_launches()
    order = {"running": 0, "created": 1, "exited": 1, "paused": 1}
    return sorted(
        entries,
        key=lambda e: (order.get(e.state, 2), -max(e.mtime, launches.get(e.key, 0.0))),
    )


def render(entries: list[Entry]) -> list[str]:
    name_w = max(len(e.container) for e in entries)
    host_w = max(len(e.host or "local") for e in entries)
    lines = []
    for i, e in enumerate(entries):
        color = STATE_COLOR.get(e.state, DIM)
        tag = " [devcontainer]" if e.kind == "devcontainer" else (" [no history]" if e.kind == "new" else "")
        lines.append(
            f"{i:>3}  {e.container:<{name_w}}  {e.host or 'local':<{host_w}}  "
            f"{color}{e.state:<8}{RESET} {DIM}{e.path}{tag}{RESET}"
        )
    return lines


def launch(selected: list[Entry], dry_run: bool) -> int:
    def run(cmd: list[str]) -> bool:
        print("  $", " ".join(cmd))
        return dry_run or subprocess.run(cmd).returncode == 0

    failed = 0
    for host in {e.host for e in selected}:
        to_start = [e.container for e in selected if e.host == host and e.state in ("exited", "created")]
        if to_start and not run(docker(host, "start", *to_start)):
            failed += len(to_start)
        for e in [e for e in selected if e.host == host and e.state == "paused"]:
            run(docker(host, "unpause", e.container))
    launched = []
    for e in selected:
        if e.state == "missing":
            print(f"  skip {e.label}: container no longer exists (recreate it with dl)", file=sys.stderr)
            failed += 1
            continue
        if not e.uri:
            e.uri = attach_uri(e.container, e.host, e.path or workdir_of(e.host, e.container))
        if not run(["code", "--folder-uri", e.uri]):
            failed += 1
        else:
            launched.append(e.key)
    if not dry_run:
        record_launches(launched)
    return failed


def delete_entries(entries: list[Entry], dry_run: bool) -> list[Entry]:
    """Forget entries by removing the VS Code workspaceStorage dirs that
    produced them. Container and data are untouched. Returns the entries
    actually pruned (those that came from history)."""
    removed = []
    for e in entries:
        if not e.sources:
            print(f"  skip {e.label}: running container with no history to forget", file=sys.stderr)
            continue
        for src in e.sources:
            print(f"  {'would rm' if dry_run else 'rm'} {src}", file=sys.stderr)
            if not dry_run:
                shutil.rmtree(src, ignore_errors=True)
        removed.append(e)
    return removed


def pick(
    entries: list[Entry],
    query: str | None,
    status: str | None = None,
    *,
    multi: bool = True,
) -> tuple[str, list[Entry]]:
    """Show the fzf picker. Returns (action, selected): action is 'launch'
    (Enter) or 'delete' (ctrl-x); an empty selection means the user cancelled."""
    header = "TAB: multi-select   ctrl-x: forget   Enter: launch"
    if status:
        header = f"{status}\n{header}"
    cmd = [
        "fzf", "--ansi", "--height=100%", "--prompt", "vs> ",
        "--header", header, "--expect", "ctrl-x",
        # Match only the container column (field 2), never the host IP, state,
        # or path — otherwise a query like "k4" fuzzy-matches the "4" in a host
        # IP or an "x64" tag and surfaces containers you never touched. Break
        # score ties by input order (--tiebreak=index), which gather() has
        # already sorted running-first then most-recently-used, so the history
        # ordering wins instead of being discarded by fzf's own sort.
        "--nth=2", "--tiebreak=index",
    ]
    if multi:
        cmd.append("--multi")
    if query:
        cmd += ["--query", query]
    proc = subprocess.run(cmd, input="\n".join(render(entries)), stdout=subprocess.PIPE, text=True)
    if proc.returncode not in (0, 1):  # 130 = ESC / ctrl-c, 2 = error
        return "launch", []
    lines = proc.stdout.splitlines()
    if not lines:
        return "launch", []
    # --expect prints the pressed key (empty line for Enter) before the selection
    action = "delete" if lines[0] == "ctrl-x" else "launch"
    chosen = [entries[int(l.split()[0])] for l in lines[1:] if l.split()]
    return action, chosen


def main() -> int:
    ap = argparse.ArgumentParser(prog="vs", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("tokens", nargs="*", help="substring filters on container@host; all matches launch")
    ap.add_argument("-a", "--all", action="store_true", help="launch all matches without the picker")
    ap.add_argument("-l", "--ls", action="store_true", help="list workspaces and status")
    ap.add_argument("-H", "--host", action="append", default=[], help="extra ssh host to scan for containers")
    ap.add_argument("-n", "--dry-run", action="store_true", help="print commands without running them")
    args = ap.parse_args()

    entries = gather(args.host)
    if not entries:
        print("no container workspaces found in VS Code history and no containers running", file=sys.stderr)
        return 1

    if args.ls:
        print("\n".join(render(entries)))
        return 0

    query = None
    if args.tokens:
        matched = [e for e in entries if any(t in e.label for t in args.tokens)]
        exact = [e for e in entries if e.container in args.tokens]
        matched = exact or matched
        if not matched:
            print(f"no workspace matches {args.tokens}; known:", file=sys.stderr)
            print("\n".join(render(entries)), file=sys.stderr)
            return 1
        if not args.all and len(matched) > 1 and len(args.tokens) == 1:
            query = args.tokens[0]  # fall through to the picker loop
        else:
            return 1 if launch(matched, args.dry_run) else 0
    elif args.all:
        return 1 if launch([e for e in entries if e.state != "missing"], args.dry_run) else 0

    # interactive picker: loop so ctrl-x prunes the list and reopens the picker
    status = None
    while entries:
        action, matched = pick(entries, query, status)
        if not matched:
            return 130
        if action == "delete":
            removed = delete_entries(matched, args.dry_run)
            removed_ids = {id(e) for e in removed}
            entries = [e for e in entries if id(e) not in removed_ids]
            skipped = len(matched) - len(removed)
            verb = "would forget" if args.dry_run else "forgot"
            status = f"{verb} {len(removed)} entr{'y' if len(removed) == 1 else 'ies'}"
            if skipped:
                status += f", skipped {skipped} with no history"
            continue
        return 1 if launch(matched, args.dry_run) else 0
    print("all entries forgotten", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
