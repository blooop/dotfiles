#!/usr/bin/env bash
# Kitty's `shell`. A new terminal window is a Zellij session immediately, so it
# can be split and tabbed without a wrapper command.
#
# PATH is set explicitly rather than inherited. The graphical session's PATH is
# fixed at login and contains neither ~/.pixi/bin nor ~/.local/bin, and running
# this through `bash -lc` does NOT fix that: ~/.profile sources ~/.bashrc, but
# Ubuntu's ~/.bashrc returns immediately for non-interactive shells, so
# ~/.bash_env — where PATH is actually built — is never reached. Zellij would
# then be missing and every desktop-launched window would quietly fall back to a
# plain shell. Panes inside Zellij are interactive and get the full environment
# the normal way.
export PATH="$HOME/.pixi/bin:$HOME/.local/bin:$PATH"

if [ -z "${ZELLIJ:-}" ] && command -v zellij >/dev/null 2>&1; then
    # A new session per window, not a shared one. Attaching every window to a
    # single session makes them clients of it, so Zellij mirrors them and reports
    # "MY FOCUS AND: FOCUSED USERS" — three windows showing one screen. Windows are
    # meant to be independent workspaces, so each gets its own session.
    #
    # SSH is the opposite case and deliberately differs: there, one resumable
    # session named "main" is the whole point, so that a dropped connection
    # reattaches rather than starting over.
    #
    # The cost is that sessions accumulate, since closing a window only detaches
    # and session_serialization keeps them. `zjclean` prunes the empty ones.
    #
    # Not exec'd, so that a Zellij which cannot start does not take the window
    # with it. Only that case should fall through: it exits non-zero, whereas a
    # session that ended — its last pane exited, or the client detached — exits 0
    # and the window should close with it. Leaving a bare login shell in a window
    # that is no longer a Zellij session is the surprising outcome, and it made
    # `exit` need typing twice. The SSH autostart makes the same test.
    if zellij; then
        exit
    fi
fi

# Reached only by Zellij being absent or failing to start, so a broken Zellij can
# never make a window unusable.
exec bash -l
