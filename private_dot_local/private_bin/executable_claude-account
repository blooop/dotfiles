#!/bin/bash
# claude-account - switch every Claude Code session on every machine to one login.
#
# Usage:    claude-account              # show the live login and the saved ones
#           claude-account <name>       # make <name> live here and on every machine (ck, cb, ca)
#           claude-account save <name>  # save the live login as <name>, after a sign-in
#           claude-account setup        # set up this machine: save each login, timer, sync
#           claude-account sync         # follow the choice made on another machine (timer)
#           claude-account rotate       # make the account that resets first live (timer)
#           claude-account rotate show  # print each account's usage and what rotate would do
#           claude-account rotate on|off  # make this machine the one that rotates, or stop
#
# There is one live login: ~/.claude/.credentials.json. Host shells read it
# (CLAUDE_CONFIG_DIR is ~/.claude, see .bash_env) and devlaunch containers read
# it through their bind mount of ~/.claude (dl's token forwarding is off, see
# .bash_env). A running `claude` re-reads that file before each request, so a
# swap moves every session, host and container, on its next request, with no
# restart. Measured on 2.1.300: a long-lived `claude -p` session failed its next
# turn after the file was swapped to a bad token and recovered after it was
# swapped back.
#
# The other logins wait in ~/.claude-accounts/<name>.json, outside the mount.
# The refresh token rotates while a login is live, so a switch first saves the
# live file back under the live name (.active); a copy saved before that would
# be dead. Names are yours: this script never guesses whose a login is. Sign in
# the usual way (claude-login, or /login) and `claude-account save <name>` it.
#
# Across machines: a switch also writes the name to one secret gist (described
# "claude-account active", found by that description, made on first use). Each
# machine's claude-account-sync.timer runs `sync` every 5 minutes: a conditional GET
# with the last ETag, which GitHub answers 304 and does not count against the API
# quota while nothing changed. So the machines never need to reach each other, and
# a machine that was asleep catches up when it wakes. Each machine keeps its own
# saved logins: a refresh token rotates, so two machines must never share one.
#
# Rotation: one machine, the leader, runs claude-account-rotate.timer every 5
# minutes. `rotate` reads each account's usage, logs it, and measures the demand
# of the last 7 days. What an account has not used at its weekly reset is lost,
# so each account should reach 99% just before its reset. An account is due when
# the demand until its reset, times 1.5 (CLAUDE_ACCOUNT_DUE_MARGIN), fits in what
# it has left below 99%. The due account that resets first is made live and
# latched until its limit or its reset; while none is due, the account that
# resets last carries the work. An account at 90% of its 5-hour window or 99% of
# its week is not usable; work moves to the next account until that window or
# week resets, and when no account is usable, it stays. A
# switch goes through the gist like a `ck`, so the other machines follow. Every
# switch costs each running session one full cache miss (the accounts are in two
# organizations). Replayed on the 8 days of usage logged up to 2026-10-27
# (1.05% of a week per hour, about 1.8 accounts' weekly use), this rule lost 0.2%
# of a week's demand per week to limits and switched 19 times a week; "soonest
# reset first", the rule before it, lost 2% and switched 41 times. The first
# design is in the simulator at https://claude.ai/artifact/HpxeEcbQKivKsnQikHH4Jd.
# A switch you make by hand, here or on another machine, holds for CLAUDE_ACCOUNT_HOLD_HOURS (2) unless the
# account you chose hits a limit. The usage endpoint allows about 30 calls an hour
# per account; rotate makes 12, and after a 429 it waits for the Retry-After.
# The token refresh and the usage reads follow realiti4/claude-swap.

set -euo pipefail

live="$HOME/.claude/.credentials.json"
state="$HOME/.claude/.claude.json"
store="${CLAUDE_ACCOUNTS_DIR:-$HOME/.claude-accounts}"
# The accounts `setup` asks for. ck and cb in .bash_aliases name the same two.
read -ra accounts <<<"${CLAUDE_ACCOUNTS:-kinisi bear}"
gist_desc="claude-account active"
token_url="https://platform.claude.com/v1/oauth/token"
client_id="9d1c250a-e61b-44d9-88ed-5944d1962f5e"   # Claude Code's own OAuth client
hold_hours="${CLAUDE_ACCOUNT_HOLD_HOURS:-2}"
due_margin="${CLAUDE_ACCOUNT_DUE_MARGIN:-1.5}"   # an account is due 1.5x early
now_ms() { date +%s%3N; }
umask 077
mkdir -p "$store"

die() { echo "claude-account: $*" >&2; exit 1; }
active() { cat "$store/.active" 2>/dev/null || true; }
lock() { exec 9>"$store/.lock"; flock -w 30 9 || die "another claude-account is running"; }

# The email behind a credentials file, for display and the duplicate check only.
email() {
    local token
    token=$(jq -r '.claudeAiOauth.accessToken // empty' "$1" 2>/dev/null) || return 0
    [[ -n "$token" ]] || return 0
    curl -fsS --max-time 10 -H "Authorization: Bearer $token" \
        -H 'anthropic-beta: oauth-2025-04-20' \
        https://api.anthropic.com/api/oauth/profile 2>/dev/null | jq -r '.account.email // empty' || true
}

# Write $2 to $1 in one rename, so no reader sees half a file.
put() {
    local tmp
    tmp=$(mktemp "$1.XXXXXX")
    cat "$2" > "$tmp"
    mv -f "$tmp" "$1"
}

# Save the live login as $1 and record its email. Refuse a login that another
# name already holds: that is a sign-in to the wrong account.
save() {
    local name="$1" mail file
    [[ -f "$live" ]] || die "there is no live login; sign in first (claude-login, or /login)"
    mail=$(email "$live")
    for file in "$store"/*.email; do
        [[ -f "$file" && "$(basename "$file" .email)" != "$name" ]] || continue
        if [[ -n "$mail" && "$(cat "$file")" == "$mail" ]]; then
            die "the live login is $mail, which is already saved as '$(basename "$file" .email)'." \
                "Sign in as $name, then run: claude-account save $name"
        fi
    done
    put "$store/$name.json" "$live"
    [[ -n "$mail" ]] && printf '%s\n' "$mail" > "$store/$name.email"
    printf '%s\n' "$name" > "$store/.active"
    echo "claude: saved $name (${mail:-email unknown})"
}

# Refresh a saved login that is not live, the way Claude Code does. A refresh
# token works once, so the new one is written to the slot before anything else.
oauth_refresh() {
    local slot="$1" rt resp tmp
    rt=$(jq -r '.claudeAiOauth.refreshToken // empty' "$slot")
    [[ -n "$rt" ]] || return 1
    resp=$(curl -fsS --max-time 20 -H 'Content-Type: application/json' -A claude-account/1.0 \
        -d "$(jq -n --arg rt "$rt" --arg c "$client_id" \
            '{grant_type: "refresh_token", refresh_token: $rt, client_id: $c}')" \
        "$token_url") || return 1
    jq -e '.access_token' <<<"$resp" >/dev/null || return 1
    tmp=$(mktemp "$slot.XXXXXX")
    jq --argjson r "$resp" --argjson now "$(now_ms)" '.claudeAiOauth += {
        accessToken: $r.access_token,
        refreshToken: ($r.refresh_token // .claudeAiOauth.refreshToken),
        expiresAt: ($now + $r.expires_in * 1000)}' "$slot" > "$tmp"
    mv -f "$tmp" "$slot"
}

# A login whose access token is near its end gets one refresh here, rather than
# in every running session at once after the swap.
refresh() {
    local slot="$1" exp
    exp=$(jq -r '.claudeAiOauth.expiresAt // 0' "$slot")
    (( exp - $(now_ms) > 300000 )) && return 0
    oauth_refresh "$slot" || echo "claude-account: the refresh failed; sign in again and save it" >&2
}

# Keep oauthAccount in .claude.json in step, for the status line and /status.
# Requests use the credentials file alone, so a lost race here costs a label.
# The record of the account switched away from is kept beside its login, if it
# is that account's; one switched to without a kept record gets its email only.
relabel() {
    local from="$1" to="$2" tmp rec="$store/$2.account.json"
    [[ -f "$state" ]] || return 0
    if [[ -n "$from" ]] && jq -e --arg m "$(cat "$store/$from.email" 2>/dev/null)" \
        '$m != "" and .oauthAccount.emailAddress == $m' "$state" >/dev/null 2>&1; then
        jq '.oauthAccount' "$state" > "$store/$from.account.json"
    fi
    tmp=$(mktemp "$state.XXXXXX")
    if [[ -f "$rec" ]]; then
        jq --slurpfile a "$rec" '.oauthAccount = $a[0]' "$state" > "$tmp"
    else
        jq --arg m "$(cat "$store/$to.email" 2>/dev/null)" \
            'if $m == "" then . else .oauthAccount.emailAddress = $m end' "$state" > "$tmp"
    fi && mv -f "$tmp" "$state" || rm -f "$tmp"
}

show() {
    local now name slot days
    now=$(active)
    shopt -s nullglob
    for slot in "$store"/*.json; do
        name=$(basename "$slot" .json)
        days=$(jq -r '.claudeAiOauth.refreshTokenExpiresAt // 0' "$slot")
        days=$(( days > 0 ? (days - $(date +%s%3N)) / 86400000 : -1 ))
        printf '%s %-8s %s (login good for %s more days)\n' "$([[ $name == "$now" ]] && echo '*' || echo ' ')" \
            "$name" "$(cat "$store/$name.email" 2>/dev/null || echo 'email unknown')" "$days"
    done
    [[ -n "$now" ]] || echo "No login saved yet. Run: claude-account setup"
}

# Make $1 live. $2 = yes tells the other machines; $3 = yes holds it against
# rotate for $hold_hours, because a person chose it.
use() {
    local name="$1" publish="${2:-yes}" hold="${3:-no}" was next
    lock
    [[ -f "$store/$name.json" ]] || die "no saved login '$name'. Run: claude-account setup"
    was=$(active)
    if [[ "$was" == "$name" ]]; then
        echo "claude: $name is already live"
    else
        # Keep the rotated refresh token of the login that is live now.
        [[ -f "$live" && -n "$was" ]] && put "$store/$was.json" "$live"
        refresh "$store/$name.json"
        # Take the login from the slot and keep the rest of the live file:
        # mcpOAuth holds this machine's MCP server logins, not the account's.
        next=$(mktemp "$store/.next.XXXXXX")
        if [[ -f "$live" ]]; then
            jq -s '.[0] + {claudeAiOauth: .[1].claudeAiOauth}' "$live" "$store/$name.json" > "$next"
        else
            cat "$store/$name.json" > "$next"
        fi
        put "$live" "$next"
        rm -f "$next"
        printf '%s\n' "$name" > "$store/.active"
        relabel "$was" "$name"
        echo "claude: $name is live for every session on the host and in containers" \
            "($(cat "$store/$name.email" 2>/dev/null || echo 'email unknown'))"
    fi
    [[ "$hold" == yes ]] && echo "$(( $(date +%s) + hold_hours * 3600 ))" > "$store/.hold"
    [[ "$publish" == yes ]] && publish "$name"
    return 0
}

# The gist id, found once by its description and kept; made when there is none.
gist_id() {
    local id
    id=$(cat "$store/.gist" 2>/dev/null || true)
    if [[ -z "$id" ]]; then
        id=$(gh api --paginate gists --jq ".[] | select(.description == \"$gist_desc\") | .id" 2>/dev/null | head -1)
        [[ -n "$id" ]] || id=$(gh api -X POST gists -f description="$gist_desc" -F public=false \
            -f "files[active][content]=none" --jq .id) || return 1
        printf '%s\n' "$id" > "$store/.gist"
    fi
    echo "$id"
}

# Tell the other machines. A failure here leaves this machine switched.
publish() {
    local id
    if id=$(gist_id) && gh api -X PATCH "gists/$id" -f "files[active][content]=$1" >/dev/null; then
        echo "claude: told the other machines (gist $id)"
    else
        echo "claude-account: could not write the gist; other machines did not switch" >&2
    fi
}

# Switch to the name in the gist, if it differs from the live one.
sync() {
    local id token headers body etag status want leader
    id=$(gist_id) || die "no gist"
    token=$(gh auth token) || die "gh is not logged in"
    headers=$(mktemp) body=$(mktemp)
    trap 'rm -f "$headers" "$body"' RETURN
    status=$(curl -sS --max-time 20 -o "$body" -D "$headers" -w '%{http_code}' \
        -H "Authorization: Bearer $token" -H 'Accept: application/vnd.github+json' \
        -H "If-None-Match: $(cat "$store/.etag" 2>/dev/null)" \
        "https://api.github.com/gists/$id") || die "GitHub is unreachable"
    [[ "$status" == 304 ]] && return 0
    [[ "$status" == 200 ]] || die "GitHub answered $status"
    etag=$(sed -n 's/^etag: *//Ip' "$headers" | tr -d '\r')
    want=$(jq -r '.files.active.content // empty' "$body" | tr -d '[:space:]')
    leader=$(jq -r '.files.leader.content // empty' "$body" | tr -d '[:space:]')
    if [[ -n "$leader" && "$leader" != none ]]; then
        printf '%s\n' "$leader" > "$store/.leader"
    else
        rm -f "$store/.leader"
    fi
    # Keep the ETag first: a machine without that login says so once, not every
    # check, and the polls after it stay 304s.
    printf '%s\n' "$etag" > "$store/.etag"
    if [[ -n "$want" && "$want" != none && "$want" != "$(active)" ]]; then
        # Only the leader rotates, and it does not see its own switch here. So
        # a change from another machine is a person's choice: hold it.
        ( use "$want" no yes ) || true
    fi
}

# Usage of one account as {"five_hour":..., "seven_day":...}. The live login is
# read from the live file, because its slot is stale while it is live; only a
# login that is not live is refreshed here. A 429 sets a back-off for rotate.
usage() {
    local name="$1" file="$store/$1.json" out hdr code tok wait try
    [[ "$name" == "$(active)" ]] && file="$live"
    [[ -f "$file" ]] || return 1
    out=$(mktemp) hdr=$(mktemp)
    for try in 1 2; do
        if [[ "$file" != "$live" ]] &&
            (( $(jq -r '.claudeAiOauth.expiresAt // 0' "$file") - $(now_ms) < 300000 )); then
            oauth_refresh "$file" || { echo "claude-account: could not refresh $name" >&2; break; }
        fi
        tok=$(jq -r '.claudeAiOauth.accessToken // empty' "$file")
        code=$(curl -sS --max-time 15 -o "$out" -D "$hdr" -w '%{http_code}' \
            -H "Authorization: Bearer $tok" -H 'anthropic-beta: oauth-2025-04-20' \
            https://api.anthropic.com/api/oauth/usage 2>/dev/null) || code=000
        case "$code" in
            200) jq -c '{five_hour, seven_day}' "$out"; rm -f "$out" "$hdr"; return 0 ;;
            401) [[ "$file" != "$live" && "$try" == 1 ]] && oauth_refresh "$file" && continue ;;
            429)
                wait=$(sed -n 's/^retry-after: *//Ip' "$hdr" | tr -d '\r')
                [[ "$wait" =~ ^[0-9]+$ ]] || wait=0
                (( wait < 300 )) && wait=300
                echo "$(( $(date +%s) + wait ))" > "$store/.backoff" ;;
        esac
        echo "claude-account: no usage for $name (HTTP $code)" >&2
        break
    done
    rm -f "$out" "$hdr"
    return 1
}

# One line per account whose usage is known: name, 5-hour %, weekly %, hours to
# the weekly reset.
usage_lines() {
    local name json
    for name in "${accounts[@]}"; do
        [[ -f "$store/$name.json" ]] || continue
        json=$(usage "$name") || continue
        jq -r --arg n "$name" --argjson now "$(date +%s)" '
            def ts: if . then sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601 else null end;
            [$n, (.five_hour.utilization // 0), (.seven_day.utilization // 0),
             ((.seven_day.resets_at | ts) as $r | if $r then ($r - $now) / 3600 else 168 end)]
            | @tsv' <<<"$json"
    done
}

# Each rotate run logs every account's usage to .usage.tsv: epoch, name, 5-hour
# %, weekly %, reset epoch. The log keeps 8 days; demand_rate reads it.
log_usage() {
    local f="$store/.usage.tsv" now
    now=$(date +%s)
    awk -F'\t' -v now="$now" '{ printf "%d\t%s\t%s\t%s\t%d\n", now, $1, $2, $3, now + $4 * 3600 }' <<<"$1" >>"$f"
    awk -F'\t' -v cut=$(( now - 8 * 86400 )) '$1 >= cut' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
}

# The demand of the last 7 days, in % of one week per hour, over all accounts:
# each account's weekly % rises by what it spent, and restarts from 0 at its
# reset. A gap over an hour (the machine slept) adds nothing. Under a day of
# log gives 0, which makes every account due: soonest reset first.
demand_rate() {
    awk -F'\t' -v since=$(( $(date +%s) - 7 * 86400 )) '
        $1 < since { next }
        { if (($2 in t) && $1 - t[$2] < 3600) sum += ($4 >= w[$2]) ? $4 - w[$2] : $4
          if (first == "") first = $1
          last = $1; t[$2] = $1; w[$2] = $4 }
        END { h = (last - first) / 3600; printf "%.3f\n", (h >= 24) ? sum / h : 0 }' \
        "$store/.usage.tsv" 2>/dev/null || echo 0
}

# The account to make live, from usage_lines on stdin, the live name in $1, the
# demand rate in $2 and the latch in $3. An account is due when the demand
# until its reset, with a margin, fits in what it has left below 99%: from then
# on, all work goes to it, or its unspent week is lost. The due account that
# resets first is made live and latched; the latch ("name reset-hour") keeps it
# live until its limit or its reset. While no account is due, the usable
# account that resets last carries the work. Stay when the live usage is
# unknown or no account is usable. Prints the pick, then the latch to keep.
decide() {
    awk -F'\t' -v cur="$1" -v d="$2" -v latch="$3" -v m="$due_margin" -v now="$(date +%s)" '
        { known[$1] = 1
          key = $1 " " int((now + $4 * 3600 + 1800) / 3600)
          if (!($2 < 90 && $3 < 99)) next
          if (key == latch) kept = key
          if (d * $4 <= m * (99 - $3) && (dn == "" || $4 < dsoon)) { dsoon = $4; dn = $1; dkey = key }
          if (ln == "" || $4 > lsoon) { lsoon = $4; ln = $1 } }
        END { if (kept != "") { split(kept, a, " "); pick = a[1]; key = kept }
              else if (dn != "") { pick = dn; key = dkey }
              else { pick = ln; key = "" }
              if (!(cur in known) || pick == "") { pick = cur; key = latch }
              print pick; print key }'
}

rotate() {
    local me leader cur lines pick until held d latch out
    me=$(hostname -s)
    leader=$(cat "$store/.leader" 2>/dev/null || true)
    if [[ -n "$leader" && "$leader" != "$me" ]]; then
        echo "claude: $leader rotates now, so $me stops"
        systemctl --user disable --now claude-account-rotate.timer >/dev/null 2>&1 || true
        return 0
    fi
    until=$(cat "$store/.backoff" 2>/dev/null || echo 0)
    if (( $(date +%s) < until )); then
        echo "claude: the usage endpoint asked to wait until $(date -d "@$until" +%H:%M)"
        return 0
    fi
    lines=$( lock; usage_lines )
    cur=$(active)
    [[ "${1:-}" == show ]] || log_usage "$lines"
    d=$(demand_rate)
    latch=$(cat "$store/.latch" 2>/dev/null || true)
    out=$(decide "$cur" "$d" "$latch" <<<"$lines")
    pick=$(sed -n 1p <<<"$out") latch=$(sed -n 2p <<<"$out")
    held=$(cat "$store/.hold" 2>/dev/null || echo 0)
    # A hand-made choice holds while that account is usable.
    if [[ "$pick" != "$cur" ]] && (( $(date +%s) < held )) &&
        awk -F'\t' -v c="$cur" '$1 == c && $2 < 90 && $3 < 99 { ok = 1 } END { exit !ok }' <<<"$lines"; then
        echo "claude: $cur was chosen by hand; it holds until $(date -d "@$held" +%H:%M)"
        pick="$cur"
    fi
    echo "claude: demand ${d}% of a week per hour (last 7 days)"
    awk -F'\t' -v cur="$cur" -v pick="$pick" -v d="$d" -v m="$due_margin" -v latch="${latch%% *}" '
        { due = $4 - m * (99 - $3) / (d > 0 ? d : 1e-9)
          if (!($2 < 90 && $3 < 99)) note = "at limit"
          else if ($1 == latch) note = "latched"
          else if (due <= 0) note = "due"
          else note = sprintf("due in %.1fh", due)
          printf "%s %-8s 5h %3.0f%%  week %3.0f%%  reset in %5.1fh  %s\n", ($1 == cur ? "*" : " "),
              $1, $2, $3, $4, note }
        END { print (pick == cur ? "claude: " cur " stays live" : "claude: switch " cur " -> " pick) }' <<<"$lines"
    [[ "${1:-}" == show ]] && return 0
    printf '%s\n' "$latch" >"$store/.latch"
    [[ "$pick" == "$cur" ]] || ( use "$pick" yes no )
}

# Make this machine the one that rotates: the gist names it, so a leader
# elsewhere stops at its next run, and this machine's timer starts.
rotate_on() {
    local id me
    me=$(hostname -s)
    systemctl --user show-environment >/dev/null 2>&1 || die "rotate needs user systemd"
    id=$(gist_id) || die "no gist"
    gh api -X PATCH "gists/$id" -f "files[leader][content]=$me" >/dev/null || die "could not write the gist"
    printf '%s\n' "$me" > "$store/.leader"
    systemctl --user daemon-reload
    systemctl --user enable --now claude-account-rotate.timer >/dev/null
    echo "claude: $me rotates every 5 minutes"
}

rotate_off() {
    local id me
    me=$(hostname -s)
    systemctl --user disable --now claude-account-rotate.timer >/dev/null 2>&1 || true
    if [[ "$(cat "$store/.leader" 2>/dev/null)" == "$me" ]]; then
        id=$(gist_id) && gh api -X PATCH "gists/$id" -f "files[leader][content]=none" >/dev/null || true
        rm -f "$store/.leader"
    fi
    echo "claude: rotation is off; the live account stays $(active)"
}

# A saved login is good while its refresh token has more than a day left.
good() {
    local exp
    [[ -f "$store/$1.json" ]] || return 1
    exp=$(jq -r '.claudeAiOauth.refreshTokenExpiresAt // 0' "$store/$1.json" 2>/dev/null) || return 1
    (( exp - $(date +%s%3N) > 86400000 ))
}

# The prompt goes to stderr, so only the probe of /dev/tty is silenced, never the read.
ask() { ( : </dev/tty ) 2>/dev/null || die "setup needs a terminal"; read -rp "$1" REPLY </dev/tty; }

# Everything one machine needs, safe to run again: only what is missing is done.
setup() {
    local tool name want mail
    for tool in claude jq curl flock gh; do
        command -v "$tool" >/dev/null || die "$tool is not on PATH; run 'chezmoi update' first"
    done
    gh auth status 2>&1 | grep -q "'gist'" || die "gh needs the gist scope; run 'gh auth refresh -s gist'"

    # Name the login this machine has now, so the first sign-in does not lose it.
    if [[ -f "$live" && -z "$(active)" ]]; then
        mail=$(email "$live")
        ask "The live login is ${mail:-an unknown account}. Which name is it (${accounts[*]}, or Enter to drop it)? "
        [[ -n "$REPLY" ]] && save "$REPLY"
    fi

    for name in "${accounts[@]}"; do
        if good "$name"; then
            echo "claude: $name is saved ($(cat "$store/$name.email" 2>/dev/null || echo 'email unknown'))"
            continue
        fi
        # The sign-in replaces the live login: save it first, under its own name.
        [[ -f "$live" && -n "$(active)" ]] && put "$store/$(active).json" "$live"
        echo
        echo "== Sign in as $name the way you usually do: claude-login, or /login in claude."
        ask "   Press Enter when you are signed in as $name. "
        save "$name"
    done

    if systemctl --user show-environment >/dev/null 2>&1; then
        systemctl --user daemon-reload
        systemctl --user enable --now claude-account-sync.timer >/dev/null 2>&1 \
            && echo "claude: the sync timer is on (every 5 minutes)" \
            || echo "claude-account: no claude-account-sync.timer; run 'chezmoi update' first" >&2
    fi

    # Join the choice the other machines made; the first machine makes it.
    want=$(gh api "gists/$(gist_id)" --jq '.files.active.content' 2>/dev/null | tr -d '[:space:]')
    if [[ -n "$want" && "$want" != none && -f "$store/$want.json" ]]; then
        use "$want" no
    else
        use "${accounts[0]}"
    fi
    rm -f "$store/.etag"
    echo
    show
}

case "${1:-}" in
    "") show ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
    save) [[ -n "${2:-}" ]] || die "usage: claude-account save <name>"; lock; save "$2" ;;
    setup) setup ;;
    sync) sync ;;
    rotate)
        case "${2:-}" in
            on) rotate_on ;; off) rotate_off ;; ""|show) rotate "${2:-}" ;;
            *) die "usage: claude-account rotate [show|on|off]" ;;
        esac ;;
    *) use "$1" yes yes ;;
esac
