#!/usr/bin/env bash
# Pick an agent for a new Zellij pane. Kept separate from the layout so more
# agents can be added without remembering another global key.

set -euo pipefail

if ! command -v fzf >/dev/null 2>&1; then
    echo "zja: fzf is required" >&2
    exit 1
fi

declare -a choices=()

command -v codex >/dev/null 2>&1 && choices+=(
    "Codex · new · unrestricted"
    "Codex · resume · unrestricted"
)
command -v claude >/dev/null 2>&1 && choices+=(
    "Claude · new · unrestricted"
    "Claude · resume · unrestricted"
)
command -v opencode >/dev/null 2>&1 && choices+=(
    "OpenCode · new · unrestricted"
    "OpenCode · continue · unrestricted"
)
choices+=("Shell")

choice=$(
    printf '%s\n' "${choices[@]}" |
        fzf \
            --height=100% \
            --layout=reverse \
            --border \
            --prompt="agent> " \
            --header="Enter: launch · Esc: cancel"
) || exit $?

case "$choice" in
    "Codex · new · unrestricted")
        exec codex --yolo
        ;;
    "Codex · resume · unrestricted")
        exec codex --yolo resume
        ;;
    "Claude · new · unrestricted")
        exec claude --dangerously-skip-permissions
        ;;
    "Claude · resume · unrestricted")
        exec claude --dangerously-skip-permissions --resume
        ;;
    "OpenCode · new · unrestricted")
        exec opencode --auto
        ;;
    "OpenCode · continue · unrestricted")
        exec opencode --auto --continue
        ;;
    "Shell")
        exec "${SHELL:-/bin/bash}"
        ;;
esac
