#!/bin/bash
# Focused workspace picker for zjsh. Keeps live/configured sessions, then adds
# only the current directory and immediate children of ~/projects.

set -euo pipefail

for command in zjsh fzf; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "zj: $command is required" >&2
        exit 1
    fi
done

declare -a candidates=()
declare -A seen=()

add_candidate() {
    local candidate=$1
    if [ -n "$candidate" ] && [ -z "${seen[$candidate]:-}" ]; then
        candidates+=("$candidate")
        seen["$candidate"]=1
    fi
}

# zjsh mixes configured projects/live sessions with its entire zoxide history.
# Retain the useful non-path entries and replace the unbounded path section.
while IFS= read -r candidate; do
    case "$candidate" in
        "→ "*) ;;
        *) add_candidate "$candidate" ;;
    esac
done < <(zjsh list -i 2>/dev/null || true)

add_candidate "→ ."

shopt -s nullglob
for path in "$HOME"/projects/*; do
    [ -d "$path" ] && add_candidate "→ $path"
done
shopt -u nullglob

if [ "${#candidates[@]}" -eq 0 ]; then
    echo "zj: no workspaces found" >&2
    exit 1
fi

choice=$(
    printf '%s\n' "${candidates[@]}" |
        fzf --height=80% --layout=reverse --border --prompt="workspace> "
) || exit $?

exec zjsh connect "$choice"
