#!/usr/bin/env bash
# Open a herdr window that is independent of the others.
#
# Successor to `zj` for Ctrl+Shift+Enter / Ctrl+Shift+T, and much smaller than it
# because herdr's own model does most of what zj hand-rolled: zj enumerated live
# sessions, zoxide history, git worktrees and ~/projects children into an fzf
# picker, because under Zellij a session was the only unit of independent work.
# Here the sidebar already lists every workspace, `prefix+shift+n` makes another,
# and `prefix+shift+g` makes one from a git worktree. None of that needs a script.
#
# What DOES need one is the case herdr handles differently from Zellij: two herdr
# clients attached to the same session are fully synced. Change tabs in one
# window and the other window changes too. So a second *window* showing separate
# work cannot just run `herdr` -- that is two views of one screen. It needs its
# own named session, and a name worth having.
#
# Prefer a workspace over one of these. A named session is for the genuinely
# separate case: another monitor, a demo, work that must not share a sidebar.
# Sessions cost a server each and show up in `herdr session list` forever
# (`herdr session stop|delete <name>` to clear them out).
#
# PATH is set explicitly rather than inherited: Kitty is launched by the
# graphical session, whose PATH is fixed at login and contains neither
# ~/.pixi/bin nor ~/.local/bin, and `bash -lc` does not fix it -- ~/.profile
# sources ~/.bashrc, but Ubuntu's ~/.bashrc returns immediately for
# non-interactive shells, so ~/.bash_env never runs.

set -euo pipefail

export PATH="$HOME/.pixi/bin:$HOME/.local/bin:$PATH"

if ! command -v herdr >/dev/null 2>&1; then
    echo "hnew: herdr is not installed" >&2
    exec bash -l
fi

# A name from the project, the way zjname derived one: `dotfiles` is pickable out
# of `herdr session list`, `sincere-petunia` is not.
session_name() {
    local root name existing candidate n

    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    name=$(basename "${root:-$PWD}")

    # The name becomes a directory and a socket path, so hold it to the shape a
    # branch slug would take.
    name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' |
        sed -e 's/[^a-z0-9]\+/-/g' -e 's/^-\+//' -e 's/-\+$//')
    [ -n "$name" ] || name=herdr

    # `--session` uses OR creates, so a colliding name silently joins the other
    # window's session -- the exact mirroring this script exists to avoid.
    # Suffix until the name is genuinely free.
    existing=$(herdr session list --json 2>/dev/null || true)
    candidate=$name
    n=2
    while printf '%s' "$existing" | grep -q "\"name\":\"$candidate\""; do
        candidate="$name-$n"
        n=$((n + 1))
    done

    printf '%s' "$candidate"
}

# `hnew <name>` to say it outright; no argument derives one from the cwd.
target=${1:-$(session_name)}

# Not exec'd, so a herdr that cannot start does not take the window with it.
# Only that case should fall through: it exits non-zero, whereas a session that
# ended -- last pane exited, or the client detached -- exits 0, and the window
# should close with it rather than leaving a bare shell that needs `exit` twice.
if herdr --session "$target"; then
    exit
fi

exec bash -l
