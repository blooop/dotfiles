#!/usr/bin/env bash
# prwatch-dispatch: one PR + one stage -> one Claude worker in a herdr tab.
#
# Called by prwatch on a transition (as a transient systemd unit, so it outlives
# the poller's oneshot) or by hand through `prwatch --dispatch-one <PR>`. It
# owns everything between "this PR needs a worker" and "the tab is closed":
#
#   1. a host-side git worktree for the PR branch, cut from PRWATCH_CLONE. Not
#      a container: the pilot repo's devcontainer delegates its image to
#      `kinisi_env build`, which refuses without live gcloud credentials this
#      host lacks, wants a ~20 GB sim image, and is a per-clone GPU-claiming
#      singleton that does not fan out. A worktree costs nothing, fans out
#      freely, and the pane's own shell is the foreground, so
#      `herdr agent start` works directly. Keep `dl <ws> -- claude` as the
#      primitive for repos with self-contained devcontainers later.
#   2. `herdr tab create --no-focus` in that worktree, ids parsed, never guessed.
#   3. `herdr agent start pr<N> --kind claude --pane <id>`, with the permission
#      posture set explicitly: the spawn probe saw Claude come up in manual
#      mode, and an unattended worker in manual mode blocks forever.
#   4. `herdr pane report-metadata` with $pr / $stage tokens, so the Agents
#      sidebar reads as PRs (see ui.sidebar.agents.rows in herdr's config).
#   5. `herdr agent prompt --wait`. Bare --wait: the turn settles as `done`,
#      never `idle`, and `--until idle` times out against a finished turn.
#   6. `herdr agent read` into $STATE/logs, `/exit` (ctrl+c does not quit
#      Claude Code), tab close, worktree removed unless it holds unpushed work.
#
# The prompt is the safety boundary. It names the one branch the worker may
# touch and forbids merge, close, force-push, amend, and `gh auth token`.
# /respond already never resolves a human's thread and already renames the
# tab off HERDR_TAB_ID; neither is duplicated here. /respond does NOT call
# /unslop, so that is asked for in the prompt rather than by editing the skill.
#
# Usage: prwatch-dispatch <PR> <ci_red|conflicting|comments_open> [--dry-run|--live]
# Dry-run prints the exact prompt and touches nothing.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/prwatch"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/prwatch"
# shellcheck disable=SC1091
[ -f "$CONFIG_DIR/config" ] && . "$CONFIG_DIR/config"

REPO="${PRWATCH_REPO:-kinisi-robotics/kinisi_ros}"
BASE_BRANCH="${PRWATCH_BASE:-main}"
CLONE="${PRWATCH_CLONE:-$STATE/clones/${REPO##*/}}"
WORKTREES="$STATE/worktrees"
LOGS="$STATE/logs"
WORKERS="$STATE/workers"
PROMPT_TIMEOUT_MS="${PRWATCH_WORKER_TIMEOUT_MS:-1800000}"

PR="${1:-}"; STAGE="${2:-}"; LIVE=0
case "${3:-}" in --live) LIVE=1 ;; --dry-run | "") ;; *) echo "unknown flag: $3" >&2; exit 2 ;; esac
[ -n "$PR" ] && [ -n "$STAGE" ] || { echo "usage: prwatch-dispatch <PR> <stage> [--dry-run|--live]" >&2; exit 2; }

log() { printf '%s prwatch-dispatch[#%s]: %s\n' "$(date -u +%H:%M:%S)" "$PR" "$*"; }
die() { log "error: $*" >&2; exit 1; }
notify() {
    log "notify: $1 -- $2"
    herdr notification show "$1" --body "$2" >/dev/null 2>&1 && return
    command -v notify-send >/dev/null 2>&1 && notify-send "$1" "$2" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# the PR, from the poller's state; the poller is the one source of stage truth
STATE_FILE="$STATE/state.json"
[ -f "$STATE_FILE" ] || die "no $STATE_FILE; run prwatch first"
pr_json=$(jq -c --arg n "$PR" '.prs[$n] // empty' "$STATE_FILE")
[ -n "$pr_json" ] || die "PR #$PR is not in state.json"
field() { jq -r --arg k "$1" '.[$k] // empty' <<<"$pr_json"; }
BRANCH=$(field head_ref); URL=$(field url); TITLE=$(field title); ME=$(jq -r .me "$STATE_FILE")
HEAD_OWNER=$(field head_owner)
RED=$(jq -r '(.ci_red_checks // []) | join(", ")' <<<"$pr_json")
THREADS=$(field actionable_threads)

# Never touch a PR whose head branch is not the user's. A PR listed as ours
# but headed on somebody else's fork is exactly that.
if [ -n "$HEAD_OWNER" ] && [ "$HEAD_OWNER" != "$ME" ] && [ "$HEAD_OWNER" != "${REPO%%/*}" ]; then
    die "head branch belongs to $HEAD_OWNER, not $ME or ${REPO%%/*}; refusing"
fi

# ---------------------------------------------------------------------------
# the prompt
RULES="You are an unattended worker on one pull request. Hard rules, no exceptions:
- Work only on branch \`$BRANCH\` in this worktree. Never switch branches, never touch $BASE_BRANCH.
- Never merge, close, or comment on the PR's state. Never force-push, never rebase a pushed branch, never amend a pushed commit. New commits only, then \`git push\`.
- Never run \`gh auth token\` or print any credential.
- Never resolve a review thread written by a human.
- Do not ask questions; there is nobody watching. Make the call, state the assumption in your final summary.
- When you are done, print a summary of at most five lines: what changed, the commit hashes, and what CI is doing. Then stop."

case "$STAGE" in
    ci_red)
        TASK="Fix the failing required CI on PR #$PR ($URL), \"$TITLE\".
Failing required checks: ${RED:-unknown}.

Run \`gh pr checks $PR\` and read the failing logs with \`gh run view <run-id> --log-failed\` (get the run id from the check's URL). Fix the root cause in this branch, not the symptom, and do not disable, skip, or loosen a test or a lint to make it pass. Run the repo's pre-commit on the files you changed (\`pre-commit run --from-ref origin/$BASE_BRANCH --to-ref HEAD\`, or its lint script if there is no .pre-commit-config.yaml). Commit with a message that says what was wrong, push, and stop. Do not wait for CI.

$RULES" ;;
    conflicting)
        TASK="Resolve the merge conflict on PR #$PR ($URL), \"$TITLE\".

Run \`git fetch origin $BASE_BRANCH\` and \`git merge origin/$BASE_BRANCH\`. Resolve each conflict so the PR still does what its title and description say; read the conflicting hunks on both sides before choosing, and prefer keeping the base branch's changes to anything the PR did not deliberately touch. Build or run the tests that the touched files have, if that is feasible here; otherwise run the repo's pre-commit on the changed files. Commit the merge (a merge commit, not a rebase), push, and stop.

$RULES" ;;
    comments_open)
        TASK="Address the open review on PR #$PR ($URL), \"$TITLE\" (${THREADS:-0} thread(s) waiting on the author, plus any review body newer than the head commit).

Invoke the \`respond\` skill for PR $PR and follow it: fix what is right, push back on what is wrong, one reply per unresolved thread, fixes pushed before replies. One addition: before posting each reply, pass its text through the \`unslop\` skill so it reads as one or two plain sentences naming the change or the reason. Never resolve a thread a human wrote.

$RULES" ;;
    *) die "stage $STAGE dispatches no worker" ;;
esac

if [ "$LIVE" != 1 ]; then
    echo "--- DRY RUN: PR #$PR ($STAGE) on $REPO@$BRANCH. Prompt that would be sent: ---"
    printf '%s\n' "$TASK"
    echo "--- end of prompt; no tab, no worktree, no agent ---"
    exit 0
fi

# ---------------------------------------------------------------------------
# live
mkdir -p "$WORKTREES" "$LOGS" "$WORKERS" "$(dirname "$CLONE")"
command -v herdr >/dev/null || die "herdr not on PATH"
herdr workspace list >/dev/null 2>&1 || die "no herdr server reachable (HERDR_SOCKET_PATH=${HERDR_SOCKET_PATH:-unset}); a worker needs a live TUI"

MARKER="$WORKERS/$PR"
TAB=""; PANE=""; WT="$WORKTREES/$PR"
cleanup() {
    rc=$?
    if [ -n "$PANE" ]; then
        herdr pane run "$PANE" '/exit' >/dev/null 2>&1 || true
        sleep 5
    fi
    [ -n "$TAB" ] && herdr tab close "$TAB" >/dev/null 2>&1 || true
    # Keep a worktree that still holds work nobody pushed; a human may want it.
    if [ -d "$WT" ]; then
        if [ -n "$(git -C "$WT" status --porcelain 2>/dev/null)" ] ||
           [ -n "$(git -C "$WT" log --oneline "@{u}..HEAD" 2>/dev/null)" ]; then
            log "worktree $WT kept: it has uncommitted or unpushed changes"
        elif [ "${PRWATCH_KEEP_WORKTREES:-0}" != 1 ]; then
            git -C "$CLONE" worktree remove --force "$WT" >/dev/null 2>&1 || true
        fi
    fi
    rm -f "$MARKER"
    exit "$rc"
}
trap cleanup EXIT
jq -n --arg pid "$$" --arg stage "$STAGE" --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{pid: ($pid|tonumber), stage: $stage, started: $started}' > "$MARKER"

# 1. worktree
if [ ! -d "$CLONE/.git" ] && [ ! -f "$CLONE/.git" ]; then
    log "no clone at $CLONE; cloning $REPO (set PRWATCH_CLONE in $CONFIG_DIR/config to reuse an existing one)"
    gh repo clone "$REPO" "$CLONE" -- --quiet
fi
git -C "$CLONE" worktree prune
git -C "$CLONE" fetch --quiet origin "$BRANCH" "$BASE_BRANCH"
if [ -d "$WT" ]; then
    # A previous worker's checkout. Bring it to the remote head without losing
    # anything: ff-only, and if that fails leave it for the human.
    git -C "$WT" checkout --quiet "$BRANCH" 2>/dev/null || true
    git -C "$WT" merge --ff-only --quiet "origin/$BRANCH" ||
        die "$WT has diverged from origin/$BRANCH; inspect it, then remove it with: git -C $CLONE worktree remove --force $WT"
else
    # -B resets a stale local branch of that name to the remote head. It fails
    # if the branch is checked out elsewhere, which is the right outcome: that
    # checkout is somebody's.
    git -C "$CLONE" worktree add --quiet -B "$BRANCH" "$WT" "origin/$BRANCH"
fi
git -C "$WT" branch --quiet --set-upstream-to="origin/$BRANCH" "$BRANCH" 2>/dev/null || true
log "worktree $WT at $(git -C "$WT" rev-parse --short HEAD) on $BRANCH"

# 2. tab. The workspace: the one named in config, else the one the caller is
#    in, else the focused one; a timer tick has no HERDR_WORKSPACE_ID of its own.
WS="${PRWATCH_HERDR_WORKSPACE:-${HERDR_WORKSPACE_ID:-}}"
[ -n "$WS" ] || WS=$(herdr workspace list | jq -r '.result.workspaces | (map(select(.focused))[0] // .[0]).workspace_id')
[ -n "$WS" ] && [ "$WS" != null ] || die "no herdr workspace to open a tab in"
created=$(herdr tab create --workspace "$WS" --cwd "$WT" --label "PR #$PR" --no-focus)
TAB=$(jq -r '.result.tab.tab_id // empty' <<<"$created")
PANE=$(jq -r '.result.root_pane.pane_id // empty' <<<"$created")
[ -n "$TAB" ] && [ -n "$PANE" ] || die "tab create returned no ids: $created"
log "tab $TAB pane $PANE in workspace $WS"

# 3. agent, permission posture explicit
# The pane's shell has to reach its prompt before agent start will take it,
# and a login shell with pixi on PATH takes a moment; retry rather than guess.
started=""
for _ in 1 2 3 4 5 6; do
    sleep 2
    if out=$(herdr agent start "pr$PR" --kind claude --pane "$PANE" --timeout 120000 -- --dangerously-skip-permissions 2>&1); then
        started=1; break
    fi
    grep -q agent_pane_busy <<<"$out" || break
done
[ -n "$started" ] || die "claude did not come up in $PANE: ${out:-no output}"

# 4. sidebar tokens
herdr pane report-metadata "$PANE" --source prwatch --token pr="#$PR" --token stage="$STAGE" >/dev/null 2>&1 || true
notify "PR #$PR: $STAGE worker started" "$TITLE"

# 5. the turn
log "prompting; waiting up to $((PROMPT_TIMEOUT_MS / 60000)) min"
if herdr agent prompt "$PANE" "$TASK" --wait --timeout "$PROMPT_TIMEOUT_MS" >/dev/null; then
    outcome="finished"
else
    outcome="did not settle in time"
fi
status=$(herdr agent get "$PANE" 2>/dev/null | jq -r '.result.agent.agent_status // "unknown"')

# 6. the transcript, then teardown (in cleanup)
LOGF="$LOGS/pr$PR-$STAGE-$(date -u +%Y%m%dT%H%M%SZ).txt"
herdr agent read "$PANE" --source recent-unwrapped --lines 200 > "$LOGF" 2>&1 || true
log "worker $outcome (agent $status); transcript tail in $LOGF"
herdr pane report-metadata "$PANE" --source prwatch --token pr="#$PR" --token stage="$STAGE:done" >/dev/null 2>&1 || true
# The body is the worker's own summary bullets, ASCII only. `cut -c` is byte
# based and split a multibyte glyph once; herdr's CLI (Rust argv) aborts on an
# argument that is not valid UTF-8, and so does notify-send.
summary=$(grep -E '^(● |  - |- )' "$LOGF" 2>/dev/null | tr -cd '[:print:]\n' | tail -n 4 | cut -c1-160 | tr '\n' ' ')
notify "PR #$PR: $STAGE worker $outcome" "${summary:-see $LOGF}"
