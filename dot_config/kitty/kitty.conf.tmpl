# Kitty is the terminal frontend; Zellij owns panes, tabs, and persistence.

# Every window opens directly into a single-pane Zellij session, so splitting and
# tabbing are available without first typing anything. Absolute path because XFCE
# launches Kitty with a PATH that contains neither ~/.local/bin nor ~/.pixi/bin.
shell {{ .chezmoi.homeDir }}/.local/bin/zjshell

font_family JetBrainsMono Nerd Font Mono
font_size 10.5

cursor_shape block
cursor_blink_interval 0
scrollback_lines 10000
wheel_scroll_multiplier 3.0

window_padding_width 2
remember_window_size yes
initial_window_width 140c
initial_window_height 42c
tab_bar_min_tabs 2

enable_audio_bell no
allow_remote_control no
shell_integration enabled

# Zellij owns persistence, so closing a window only detaches the client. Nothing
# is lost, and the "it is running: ..." prompt is pure friction.
confirm_os_window_close 0

# An ordinary new window is a fresh single-pane session. These two open a window
# at the workspace picker instead, for attaching to an existing project. Either
# way the second layer is a Zellij session, never Kitty panes or tabs.
map ctrl+shift+enter launch --type=os-window --cwd=current zj
map ctrl+shift+t launch --type=os-window --cwd=current zj
