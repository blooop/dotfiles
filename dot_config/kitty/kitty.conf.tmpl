# Kitty is the terminal frontend. Nothing multiplexes it automatically.
#
# A window used to be a Zellij session from the first keystroke, via `shell
# zjshell`. That is deliberately gone while tuios is being trialled: a window is a
# plain login shell, and a multiplexer is started by hand when it is wanted. The
# point is to find out what the bare terminal actually lacks before configuring
# anything to fill the gap.
#
# No `shell` line at all, so Kitty starts the login shell from /etc/passwd. That
# also retires the PATH workaround zjshell needed — an interactive login Bash
# sources ~/.bash_env the normal way, which is where PATH is built.

font_family JetBrainsMono Nerd Font Mono
font_size 10.5

cursor_shape block
cursor_blink_interval 0
scrollback_lines 10000
wheel_scroll_multiplier 3.0

window_padding_width 2
remember_window_size yes
initial_window_width 140c
initial_window_height 42c
tab_bar_min_tabs 2

enable_audio_bell no
allow_remote_control no
shell_integration enabled

# Nothing owns persistence now, so closing a window really does end what is in it.
# Kitty's default (-1: ask only when a program other than the shell is running) is
# the right guard again, and is restored by having no setting here.

# A new OS window in the same directory. These opened the `zj` workspace picker
# while Zellij autostarted; they are plain windows now, so nothing about opening a
# window presumes a multiplexer.
map ctrl+shift+enter launch --type=os-window --cwd=current
map ctrl+shift+t launch --type=os-window --cwd=current

# Single-press window control for tuios, matching what F2/F3/F4 did in Zellij
# (NewTab / previous tab / next tab). tuios cannot do this itself: the only
# keybinding section that is live while you are typing in a pane exposes exactly
# three actions and no "new window" among them, so the keys are bound out here and
# drive tuios through its remote-control CLI instead.
#
# Kitty swallows these before any application sees them, which is what makes them
# work from inside Neovim or an agent pane — and also means F2/F3/F4 are gone for
# everything else, Zellij's own F-key layer included.
#
# Requires a daemon-backed session (`tui`, or `tuios new <name>`); a bare `tuios`
# has no daemon and these silently do nothing.
map f2 launch --type=background tuios run-command NewWindow
map f3 launch --type=background tuios run-command PrevWindow
map f4 launch --type=background tuios run-command NextWindow

# Once the only un-multiplexed window; now every window is one, so this is kept
# only for the habit and for whenever a multiplexer autostarts here again.
#
# `shell zjshell` means every other window is a Zellij session, which is right up
# until the moment you SSH somewhere that also runs Zellij: the remote session is
# then nested inside the local one, and the outer Zellij eats every function key
# before the inner one sees it. `Ctrl+; d` exists for when that happens anyway,
# but the better answer is not to nest — multiplex at exactly one end, and for a
# remote host that end is the remote one, because that is where persistence
# across a dropped connection actually has to live.
#
# So: open this window, SSH from it, and the remote Zellij is the only Zellij in
# the stack. Every key, the mouse, the clipboard, and the scrollback belong to it
# unambiguously. The cost is that this window has no local splitting — use
# another window, which `remember_window_size` and a cheap close keep painless.
#
# `bash -l` explicitly: `launch` overrides the configured shell, and a login shell
# is what makes ~/.bash_env's PATH available here — which is also why no `shell`
# line is needed at the top any more.
map ctrl+shift+y launch --type=os-window --cwd=current bash -l

# The same window, but going straight to a host: an fzf picker over ~/.ssh/config
# and the `ssh` lines in history, which then `exec`s, so the remote is the
# window's own process and ending it closes the window.
#
# Ctrl+Shift+Y plus a remembered hostname is two steps, and the two-step version
# of the right answer loses to the one-step version of the wrong one — SSHing from
# an ordinary pane, which nests. This makes not nesting the cheaper habit.
#
# Displaces Kitty's start_resizing_window, which stays meaningless here: panes and
# tabs belong to whatever multiplexer is running inside, not to Kitty.
map ctrl+shift+r launch --type=os-window --cwd=current {{ .chezmoi.homeDir }}/.local/bin/sshz
