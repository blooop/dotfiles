defaults {
    shell "bash"
    restart_on_resurrection false
    icon_project "◆"
    icon_session "●"
    icon_resurrectable "↺"
    icon_path "→"
}
{{ if .heavy -}}

project "kinisi" {
    path "{{ .chezmoi.homeDir }}/kinisi/kinisi_ros"
    session "kinisi"
    layout_file "{{ .chezmoi.homeDir }}/.config/zellij/layouts/workspace.kdl"
}

project "kreal" {
    path "{{ .chezmoi.homeDir }}/kreal/kinisi_ros"
    session "kreal"
    layout_file "{{ .chezmoi.homeDir }}/.config/zellij/layouts/workspace.kdl"
}

# The old static k1..k5 sibling checkouts are retired: use `grove fork kinisi`
# to spin up as many isolated worktree+session workspaces as you need, on demand.
{{- end }}
