// A new session is one bare pane, so opening a terminal is cheap and never
// starts processes that were not asked for. The Neovim/agents grid is opt-in:
// zjsh applies layouts/workspace.kdl to configured projects, and `Ctrl+; t w`
// opens it as a tab on demand.
default_layout "simple"
theme "blade-runner-focus"

pane_frames true
// Growing a pane past its neighbours collapses them into a title-line stack
// instead of refusing. This is the "minimise" half of Alt+z's "maximise".
stacked_resize true
mouse_mode true
scroll_buffer_size 50000
copy_clipboard "system"
copy_on_select true
on_force_close "detach"
session_serialization true

// A reboot is not a detach. Detaching leaves the server running and the panes
// alive; a shutdown kills the server, so there is nothing left to detach from and
// no setting could change that. Serialization is the only thing that crosses a
// reboot, which makes what it captures the whole question.
//
// By default it saves the shape — tabs, geometry, cwds, commands — and nothing
// that was on screen, so a resurrected session comes back structurally correct
// and completely blank. serialize_pane_viewport keeps the scrollback too, which
// is the difference between "my layout is back" and "I can see what I was doing".
serialize_pane_viewport true

// Capped well under scroll_buffer_size (50000). This is written to disk for every
// pane of every session on a repeating interval, so the buffer size that is right
// to hold in memory for one focused pane is the wrong one to persist dozens of
// times over. 10000 lines is far more context than is ever read back after a
// reboot, and keeps a session's footprint in the low megabytes.
scrollback_lines_to_serialize 10000
scrollback_editor "nvim"
show_startup_tips false
show_release_notes false

// Bundled "blade-runner", with only the two pane-frame colours changed.
//
// Frames are the one part of the UI Zellij will not let a theme fully control:
// UNFOCUSED frames are always drawn in the terminal's default foreground
// (bright white in our Kitty config) and `frame_*.background` is ignored, so a
// focused pane can only win on hue and chroma. Upstream ships green for
// frame_selected and orange for frame_highlight — two mid-luminance colours that
// read as "roughly the same as the white ones" at a glance.
//
// frame_selected  = the focused pane in normal mode
// frame_highlight = the focused pane while a mode is active, which is where the
//                   sticky Ctrl-; layer leaves us nearly all the time
//
// Magenta and cyan are both native blade-runner accents, are far from white, and
// are far from each other, so "which pane has focus" and "am I in a mode" are
// two independent, unmistakable signals.
//
// A themes block replaces a theme wholesale: any section left out is silently
// zeroed rather than inherited, so the whole definition has to be spelled out.
themes {
    blade-runner-focus {
        text_unselected {
            base 255 255 255
            background 0 0 0
            emphasis_0 255 140 13
            emphasis_1 0 229 229
            emphasis_2 0 255 0
            emphasis_3 255 0 255
        }
        text_selected {
            base 255 255 255
            background 26 26 26
            emphasis_0 255 140 13
            emphasis_1 0 229 229
            emphasis_2 0 255 0
            emphasis_3 255 0 255
        }
        ribbon_selected {
            base 0 0 0
            background 0 255 0
            emphasis_0 255 53 94
            emphasis_1 255 140 13
            emphasis_2 255 0 255
            emphasis_3 0 217 227
        }
        ribbon_unselected {
            base 0 0 0
            background 43 191 244
            emphasis_0 255 53 94
            emphasis_1 255 255 255
            emphasis_2 0 217 227
            emphasis_3 255 0 255
        }
        table_title {
            base 0 255 0
            background 0
            emphasis_0 255 140 13
            emphasis_1 0 229 229
            emphasis_2 0 255 0
            emphasis_3 255 0 255
        }
        table_cell_selected {
            base 255 255 255
            background 26 26 26
            emphasis_0 255 140 13
            emphasis_1 0 229 229
            emphasis_2 0 255 0
            emphasis_3 255 0 255
        }
        table_cell_unselected {
            base 255 255 255
            background 0 0 0
            emphasis_0 255 140 13
            emphasis_1 0 229 229
            emphasis_2 0 255 0
            emphasis_3 255 0 255
        }
        list_selected {
            base 255 255 255
            background 26 26 26
            emphasis_0 255 140 13
            emphasis_1 0 229 229
            emphasis_2 0 255 0
            emphasis_3 255 0 255
        }
        list_unselected {
            base 255 255 255
            background 0 0 0
            emphasis_0 255 140 13
            emphasis_1 0 229 229
            emphasis_2 0 255 0
            emphasis_3 255 0 255
        }
        // Changed from blade-runner's green 0 255 0.
        frame_selected {
            base 255 0 255
            background 0
            emphasis_0 255 140 13
            emphasis_1 0 229 229
            emphasis_2 255 0 255
            emphasis_3 0
        }
        // Changed from blade-runner's orange 255 140 13.
        frame_highlight {
            base 0 229 229
            background 0
            emphasis_0 255 0 255
            emphasis_1 0 229 229
            emphasis_2 0 229 229
            emphasis_3 0 229 229
        }
        exit_code_success {
            base 0 255 0
            background 0
            emphasis_0 0 229 229
            emphasis_1 0 0 0
            emphasis_2 255 0 255
            emphasis_3 0 217 227
        }
        exit_code_error {
            base 255 53 94
            background 0
            emphasis_0 255 230 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 255 0 255
            player_2 0 217 227
            player_3 0
            player_4 255 230 0
            player_5 0 229 229
            player_6 0
            player_7 255 53 94
            player_8 0
            player_9 0
            player_10 0
        }
    }
}

// autolock exists for exactly one binding: Ctrl+hjkl. It watches the command in
// the focused pane and locks Zellij for the few applications that need those keys
// themselves — inside Neovim they reach Neovim, and zellij-nav.nvim crosses the
// pane border only once the cursor is already at the editor's edge; inside fzf
// Ctrl+j/Ctrl+k stay list movement.
//
// The trigger list is short on purpose. Locking also means Ctrl+hjkl cannot move
// focus *out* of that pane, so pagers, htop, and lazygit are deliberately absent:
// none of them want Ctrl+hjkl, and all of them are easier to leave without it.
// The function keys are unaffected either way, being bound in `shared`.
//
// attention renames a tab when a pane in it wants input, so a waiting agent is
// visible from whichever project is currently on screen.
plugins {
    autolock location="file:{{ .chezmoi.homeDir }}/.config/zellij/plugins/zellij-autolock.wasm" {
        is_enabled true
        triggers "nvim|vim|hx|fzf"
        reaction_seconds "0.3"
        print_to_log false
    }

    attention location="file:{{ .chezmoi.homeDir }}/.config/zellij/plugins/zellij-attention.wasm" {
        enabled "true"
        waiting_icon "⏳"
        completed_icon "✅"
    }

    // Selection rather than cycling: type characters from a name and it filters
    // live, jumping the moment one candidate is left. Deliberately absent from
    // load_plugins — it is launched on demand, not held in the background.
    leap location="file:{{ .chezmoi.homeDir }}/.config/zellij/plugins/zellij-leap.wasm"

    // The modal half of the cheatsheet. Reads the real keybinds, so unlike the
    // hand-written F-key legend in the status bar it cannot fall out of date, and
    // auto_show means entering the Ctrl+; layer and pausing lists what is
    // available rather than requiring the README.
    which-key location="file:{{ .chezmoi.homeDir }}/.config/zellij/plugins/zj-which-key.wasm" {
        auto_show "true"
        delay_secs "0.4"
        position "bottom-right"
        max_height_pct "40"
    }
}

load_plugins {
    autolock
    attention
    which-key
}

// Normal mode belongs entirely to the focused application. Ctrl-; enters one
// sticky Vim-shaped control layer; F12 is the terminal-independent fallback.
keybinds clear-defaults=true {
    normal {
        bind "Ctrl ;" "F12" { SwitchToMode "Pane"; }

        // Submitting a command is the moment the foreground process changes.
        // Forwarding the carriage return unchanged and poking autolock makes it
        // re-evaluate immediately instead of on its next poll.
        bind "Enter" {
            WriteChars "\u{000D}";
            MessagePlugin "autolock" {};
        }
    }

    // Locked mode also passes Ctrl-; through to an application that needs it.
    // F12 remains the deliberately boring escape hatch.
    locked {
        bind "F12" { SwitchToMode "Normal"; }
    }

    // The pass-through layer, entered with `Ctrl+; d` and left with F12.
    //
    // Locked cannot do this job. Locked stops *mode* keys, but F1-F11 come from
    // a `shared` block, and `shared` reaches every mode including Locked, so a
    // locked Zellij still swallows every function key. Zellij offers no "forward
    // everything" mode, so one of its InputModes has to be emptied out to become
    // one. `tmux` is the only mode this config never otherwise uses.
    //
    // The one key that cannot be forwarded is the one that gets you back, so F12
    // stays. An inner Zellij is therefore driven by `Ctrl+;`, which is exactly
    // what F12 is the fallback for — a fair trade, since the inner one only ever
    // needs the fallback if the outer has already given up the key.
    //
    // Ctrl+hjkl and the pane-cycling pair are excluded from this mode in the
    // `shared_except` block above for the same reason.
    tmux {
        bind "F12" { SwitchToMode "Normal"; }
    }

    // Ctrl+hjkl is the only context-sensitive layer. autolock decides who owns
    // it: a plain shell or agent pane hands it to Zellij, Neovim keeps it and
    // hands back at the edge. Note that a shell therefore loses Ctrl+h as an
    // alias for Backspace; the Backspace key itself is unaffected.
    // "tmux" is excluded here for the same reason it is excluded from `shared`
    // below: it is this config's pass-through layer, and a pass-through layer
    // that keeps six bindings for itself is not one. See the `tmux` block.
    shared_except "locked" "tmux" {
        bind "Ctrl h" { MoveFocusOrTab "Left"; }
        bind "Ctrl l" { MoveFocusOrTab "Right"; }
        bind "Ctrl j" { MoveFocus "Down"; }
        bind "Ctrl k" { MoveFocus "Up"; }

        // Cycle panes, not tabs: tabs already cycle on F3/F4 and jump by name on
        // F9, whereas nothing cycles panes at all.
        //
        // Ctrl+, / Ctrl+. rather than the obvious Ctrl+Tab. Zellij accepts a
        // "Ctrl Tab" binding — the parser is strict and rejects a bad key name —
        // but never fires it here: Tab is ASCII 0x09, indistinguishable from
        // Ctrl+I in legacy encoding, and Zellij's handling of modified special
        // keys is incomplete even with the Kitty protocol on (compare
        // zellij-org/zellij#3852, Ctrl+Backspace collapsing to Ctrl+H).
        //
        // Ctrl with punctuation is the same class as Ctrl+;, which this config
        // already depends on, so it resolves for exactly the same reason. The Tab
        // pair is kept as an alias in case a later Zellij delivers it.
        bind "Ctrl ." { FocusNextPane; }
        bind "Ctrl ," { FocusPreviousPane; }
        bind "Ctrl Tab" { FocusNextPane; }
        bind "Ctrl Shift Tab" { FocusPreviousPane; }
    }

    // Bare function keys are the hot path, in the spirit of byobu: F2/F3/F4 keep
    // their byobu meanings exactly — new window, previous window, next window.
    // No modifier is ever required, and these are bound in every mode including
    // Locked, so they work identically from a shell, from Neovim, and from an
    // agent pane. F12 stays the gateway.
    //
    // Everything else is ordered by how often it is reached for, against how
    // easily the key is reached. F1 and F8-F11 anchor off the ends of their
    // groups; F5/F6/F7 sit in the middle of the row with nothing to find them
    // by, so they hold the three lowest-frequency actions. That is a cost worth
    // paying twice, because the actions that land there are also the ones a
    // mis-hit hurts most.
    //
    // The cost is that applications inside Zellij no longer see F1-F11. That
    // matters for htop, Midnight Commander, and any nested Zellij reached over
    // SSH; `Ctrl+; d` hands them over via the `tmux` pass-through block.
    //
    // `shared_except "tmux"` rather than `shared`, and the distinction is not
    // cosmetic. A bare `shared` block is parsed as `shared_except` with an empty
    // exclusion list and applied to every InputMode there is, Locked included
    // (zellij-utils/src/kdl/mod.rs, `if kdl_name!(block) == "shared_except" ||
    // kdl_name!(block) == "shared"`). Locked therefore does NOT pass function
    // keys through, which is why this config needs a second, genuinely empty
    // mode to do that job.
    shared_except "tmux" {
        bind "F1" {
            Run "lazygit" {
                floating true
                x "5%"
                y "5%"
                width "90%"
                height "90%"
                close_on_exit true
                name "lazygit"
            }
        }
        // Byobu's three: create a tab, then cycle. Tab cycling is the highest-rate
        // action there is, so it gets the two keys that byobu already trained and
        // that sit at the near end of the row.
        bind "F2" { NewTab; }
        bind "F3" { GoToPreviousTab; }
        bind "F4" { GoToNextTab; }

        // F5/F6/F7 are the awkward middle. Switching projects is a context switch
        // measured in a few times a day, not a few times a minute, so it pays the
        // reach; the two ways of leaving a session pay it because they should be
        // deliberate.
        //
        // Leap between projects. The session target lists every session,
        // resurrectable ones included, so this both switches to another project
        // and gets back to the one just left — the previous session is simply one
        // of the candidates, reachable by typing a character of its name.
        //
        // This is a real client-level switch. Zellij refuses to switch sessions
        // from the CLI on purpose (several clients can share a session, so a
        // command cannot know whose view to move), which is why a plugin is the
        // only way to do it and why `zj` in a pane cannot. `zj` therefore stays
        // on Ctrl+; w, where it does the thing leap cannot: create a session
        // from a project directory or Git worktree.
        bind "F5" {
            LaunchOrFocusPlugin "leap" {
                floating true
                move_to_focused_tab true
                leap_target "session"
                leap_on_no_match "reset"
                leap_on_pane_unfocus "close"
                leap_on_escape "close"
            }
        }
        // Quit takes the one slot with a cold key on either side. Ending a session
        // needs *a* bare key — without one the only one-keystroke way out was
        // Detach, which is why sessions accumulated: every "I'm done here" was
        // really a bookmark. But F6 is the slot where a fumbled reach cannot land
        // on it, since the hot keys are F4 and below and F8 and above.
        //
        // Quit rather than zjkill. Session serialization means Quit is
        // recoverable — it costs the running processes but leaves the session
        // resurrectable, so `zellij attach` gets the layout back. zjkill deletes
        // the record too and stays three keystrokes deep at `Ctrl+; o X`, on the
        // same reasoning that put Quit itself there rather than next to `q`.
        bind "F6" { Quit; }
        // The pair, adjacent but with the escalation running right-to-left: F7
        // leaves for now, F6 leaves for good. Detach is the safer of the two to
        // have next to a warm key — nothing is lost — so it takes the slot beside
        // F8. Over SSH it also ends the connection.
        bind "F7" { Detach; }

        // Panes: create on F8, destroy on F10, with the tab jump between them.
        // Both are per-minute actions and both anchor off a group edge.
        //
        // NewPane rather than a split direction, since Zellij picks the better
        // axis for the space available. CloseFocus is deliberately not on F4 any
        // more: it used to borrow Alt+F4's meaning from the desktop, but that put
        // an unconfirmed destroy inside the tab-cycling run of keys.
        bind "F8" { NewPane; }

        // Cycling stops scaling somewhere around four tabs, which is exactly the
        // point of running several projects in one window. F9 jumps straight to a
        // tab by name instead. Floating panes keep their toggle at Ctrl+; f,
        // being both lower frequency and already reachable.
        bind "F9" {
            LaunchOrFocusPlugin "leap" {
                floating true
                move_to_focused_tab true
                leap_target "tab"
                leap_on_no_match "reset"
                leap_on_pane_unfocus "close"
                leap_on_escape "close"
            }
        }
        // The destroy half of the pane pair on F8. No confirmation, and worth
        // knowing what it closes: see the CloseFocus note in README.md, since a
        // floating pane or the last pane in a tab make it do more than it looks.
        bind "F10" { CloseFocus; }
        bind "F11" {
            Run "zja" {
                close_on_exit true
                name "agent"
            }
        }
    }

    // The main control layer. Layout-changing actions stay in this mode so they
    // can be repeated; interactive tools return immediately to application input.
    pane {
        bind "Ctrl ;" "F12" "Esc" "Space" { SwitchToMode "Normal"; }

        bind "h" "Left" { MoveFocus "Left"; }
        bind "j" "Down" { MoveFocus "Down"; }
        bind "k" "Up" { MoveFocus "Up"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "H" { MovePane "Left"; }
        bind "J" { MovePane "Down"; }
        bind "K" { MovePane "Up"; }
        bind "L" { MovePane "Right"; }

        bind "n" { NewPane; }
        bind "s" { NewPane "Down"; }
        bind "S" { NewPane "stacked"; }
        bind "v" { NewPane "Right"; }
        // Lowercase closes the pane, uppercase the whole tab — the same shape as
        // hjkl moving focus and HJKL moving the pane. `t x` still closes a tab
        // and is what Tab mode's own vocabulary calls it; this is the two-key
        // form, because F4 cascading into a tab close is the case worth having a
        // deliberate key for rather than discovering by accident.
        bind "x" { CloseFocus; }
        bind "X" { CloseTab; }
        bind "z" { ToggleFocusFullscreen; }

        // Descend: stop intercepting, and let the thing inside this pane have
        // every key. Named for going one level down into a nested Zellij over
        // SSH, which is the case that needs it; F12 comes back up.
        bind "d" { SwitchToMode "Tmux"; }
        bind "f" { ToggleFloatingPanes; }
        bind "e" { TogglePaneEmbedOrFloating; }
        bind "i" { TogglePanePinned; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "]" { NextSwapLayout; }
        bind "[" { SwitchToMode "Scroll"; }

        // Same jump-by-name as F9, scoped to panes in this tab. Modal rather than
        // a bare key because Ctrl+Tab and Ctrl+hjkl already cover the small
        // counts; this is for a tab holding a deep pane stack.
        bind "p" {
            LaunchOrFocusPlugin "leap" {
                floating true
                move_to_focused_tab true
                leap_target "pane_in_active_tab"
                leap_on_no_match "reset"
                leap_on_pane_unfocus "close"
                leap_on_escape "close"
            }
            SwitchToMode "Normal";
        }

        // The searchable full list, for when the auto popup is not enough.
        bind "?" {
            LaunchOrFocusPlugin "which-key" {
                floating true
                move_to_focused_tab true
                role "browser"
            }
            SwitchToMode "Normal";
        }

        bind "t" { SwitchToMode "Tab"; }
        bind "r" { SwitchToMode "Resize"; }
        bind "m" { SwitchToMode "Move"; }
        bind "o" { SwitchToMode "Session"; }
        bind "q" { SwitchToMode "Locked"; }

        bind "a" {
            Run "zja" {
                close_on_exit true
                name "agent"
            }
            SwitchToMode "Normal";
        }
        bind "b" {
            Run "bash" {
                floating true
                x "10%"
                y "10%"
                width "80%"
                height "80%"
                close_on_exit true
                name "scratch"
            }
            SwitchToMode "Normal";
        }
        bind "g" {
            Run "lazygit" {
                floating true
                x "5%"
                y "5%"
                width "90%"
                height "90%"
                close_on_exit true
                name "lazygit"
            }
            SwitchToMode "Normal";
        }
        bind "w" {
            Run "zj" {
                floating true
                x "10%"
                y "10%"
                width "80%"
                height "80%"
                close_on_exit true
                name "workspaces"
            }
            SwitchToMode "Normal";
        }
        bind "W" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal";
        }
    }

    tab {
        bind "Ctrl ;" "F12" "Esc" "Space" { SwitchToMode "Normal"; }
        bind "h" "k" "Left" "Up" { GoToPreviousTab; }
        bind "j" "l" "Right" "Down" { GoToNextTab; }
        bind "H" { MoveTab "Left"; }
        bind "L" { MoveTab "Right"; }
        bind "n" { NewTab; }
        bind "x" { CloseTab; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }

        // New sessions are a single bare pane now, so the Neovim/agents grid is
        // requested explicitly. Driven through the CLI rather than an inline
        // layout so layouts/workspace.kdl stays the only copy of it — zjsh
        // launches project sessions from the same file.
        bind "w" {
            Run "zellij" {
                args "action" "new-tab" "--layout" "workspace"
                floating true
                width "1"
                height "1"
                close_on_exit true
                name "new-workspace-tab"
            }
            SwitchToMode "Normal";
        }
        bind "s" { ToggleActiveSyncTab; }
        bind "b" { BreakPane; }
        bind "1" { GoToTab 1; }
        bind "2" { GoToTab 2; }
        bind "3" { GoToTab 3; }
        bind "4" { GoToTab 4; }
        bind "5" { GoToTab 5; }
        bind "6" { GoToTab 6; }
        bind "7" { GoToTab 7; }
        bind "8" { GoToTab 8; }
        bind "9" { GoToTab 9; }
    }

    resize {
        bind "Ctrl ;" "F12" "Esc" "Space" { SwitchToMode "Normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    move {
        bind "Ctrl ;" "F12" "Esc" "Space" { SwitchToMode "Normal"; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "n" "Tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
    }

    scroll {
        bind "Ctrl ;" "F12" "Esc" "Space" {
            ScrollToBottom;
            SwitchToMode "Normal";
        }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" "l" "Right" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "h" "Left" { PageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
    }

    entersearch {
        bind "Ctrl ;" "F12" "Esc" {
            ScrollToBottom;
            SwitchToMode "Normal";
        }
        bind "Enter" { SwitchToMode "Search"; }
    }

    search {
        bind "Ctrl ;" "F12" "Esc" "Space" {
            ScrollToBottom;
            SwitchToMode "Normal";
        }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" "l" "Right" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "h" "Left" { PageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
    }

    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
        bind "Ctrl ;" "F12" "Enter" { SwitchToMode "Normal"; }
    }

    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
        bind "Ctrl ;" "F12" "Enter" { SwitchToMode "Normal"; }
    }

    session {
        bind "Ctrl ;" "F12" "Esc" "Space" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "q" { SwitchToMode "Locked"; }

        // Ending the session outright, as opposed to `d` which leaves it running.
        // `x` rather than the tempting `Q`, both because x already means close in
        // pane and tab mode and because one Shift away from `q`/lock is the wrong
        // neighbour for the only irreversible key in the config. Three keystrokes
        // deep is deliberate; session_serialization means it stays resurrectable.
        bind "x" { Quit; }

        // Quit leaves a resurrectable corpse behind, because session
        // serialization is the whole reason a dropped connection costs nothing.
        // That is right for `x` and wrong for the case where a project is
        // genuinely finished, which is the case that was missing: without it the
        // session list only ever grows, and every entry in it looks equally
        // alive from the outside.
        //
        // Run rather than a Quit action because deleting a session's record is a
        // CLI operation and cannot be expressed as a keybinding action. zjkill
        // detaches itself before doing it, for reasons the script explains.
        bind "X" {
            Run "zjkill" {
                floating true
                width "1"
                height "1"
                close_on_exit true
                name "zjkill"
            }
        }

        // Hand every key back to the application, function keys included, for
        // the rare full-screen TUI that needs F1-F11 itself. `A` restores
        // automatic locking.
        //
        // Tmux rather than Locked, because Locked does not actually do this: the
        // function keys live in a `shared` block and `shared` covers every mode,
        // Locked included. This binding claimed otherwise for as long as it
        // pointed at Locked. Autolock is disabled first so that it cannot switch
        // the mode back out from under a long-lived full-screen application.
        //
        // `Ctrl+; d` is the same destination without touching autolock, and is
        // the one to use for a nested Zellij over SSH.
        bind "a" {
            MessagePlugin "autolock" { payload "disable"; };
            SwitchToMode "Tmux";
        }
        bind "A" {
            MessagePlugin "autolock" { payload "enable"; };
            SwitchToMode "Normal";
        }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal";
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal";
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal";
        }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal";
        }
    }
}
