layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        {{ template "zellij-status-bar.kdl" . }}
    }

    // The high-frequency loop stays visible: a shell left, two agents right.
    // Agents are suspended so opening many workspaces is cheap; Enter starts one.
    // The left pane used to run `nvim .` on open. It does not any more: a
    // workspace is opened far more often to run something than to edit, and an
    // editor that starts itself is one more process to quit before the pane is
    // usable. `nvim .` in that pane is the same keystrokes when it is wanted.
    tab name="work" split_direction="vertical" {
        pane size="58%" name="shell" focus=true
        pane size="42%" split_direction="horizontal" {
            pane name="codex" command="codex" start_suspended=true {
                args "--yolo"
            }
            pane name="claude" command="claude" start_suspended=true {
                args "--dangerously-skip-permissions"
            }
        }
    }

    // Keep long-running commands and ad-hoc shells out of the editing grid.
    tab name="terms" {
        pane name="shell"
    }
}
