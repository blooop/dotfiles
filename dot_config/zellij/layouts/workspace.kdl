layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // The high-frequency loop stays visible: editor left, two agents right.
    // Agents are suspended so opening many workspaces is cheap; Enter starts one.
    tab name="work" split_direction="vertical" {
        pane size="58%" name="nvim" command="nvim" focus=true {
            args "."
        }
        pane size="42%" split_direction="horizontal" {
            pane name="codex" command="codex" start_suspended=true {
                args "--yolo"
            }
            pane name="claude" command="claude" start_suspended=true {
                args "--dangerously-skip-permissions"
            }
        }
    }

    // Keep long-running commands and ad-hoc shells out of the editing grid.
    tab name="terms" {
        pane name="shell"
    }
}
