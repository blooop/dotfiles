# Repo docs/tooling — never applied to $HOME
README.md
install.sh
lazygit-guide.md
vim-cheatsheet.md
claude-settings.json
# Read in place from the ~/.local/share bind-mount by the container bootstrap,
# never installed into $HOME (on the host it would be dead weight; in a
# container ~/container is not where anything looks for it).
container

# Python bytecode artifacts — never track or deploy
**/__pycache__
**/*.pyc

{{/* Ownership gates. Each block skips a path because something OTHER than chezmoi
     owns it on this profile — never because the profile is "small". Anything not
     listed here IS applied in a container: that is how a fresh devcontainer gets
     the same shell, tools and config as the host. */}}
{{ if not .gitconfig -}}
# Skip .gitconfig — DevPod/devcontainer runtimes overwrite it with credential
# injection. Git aliases/settings live in .config/git/config (XDG fallback),
# which IS applied unless .xdg says the tree is host-mounted.
.gitconfig
{{ end -}}

{{ if not .claudecfg -}}
# devlaunch bind-mounts the host's ~/.claude into the container read-write (it
# lends the host's claude binary and credentials), so an apply from inside would
# write container content onto the host's real Claude config. The host apply owns
# it; the container inherits it through the mount.
.claude
{{ end -}}

{{ if not .xdg -}}
# Trees a kinisi dev container bind-mounts straight from the host. Applying to
# them from inside would write container-profile content back onto the host's
# real files — the mount makes "the container's ~/.config" and "the host's
# ~/.config" the same directory. The host apply owns these; the kinisi apply
# is left with exactly what is container-local and actually missing: .bashrc
# (modify_ appends the .bash_env source line to the image's ROS bashrc rather
# than replacing it), .bash_aliases, .bash_env, .vimrc, .terminfo, .local/bin.
#
# NOT skipped on DevPod: those paths are container-local there, and skipping them
# cost a devcontainer its git aliases, lazygit, zellij and broot config.
.cache
.config
.local/share
{{ end -}}

{{ if not .pixi -}}
# ~/.pixi belongs to the kinisi image: its entrypoint symlinks the manifest to a
# file inside the kinisi_ros checkout, so applying here would write through the
# symlink and dirty a shared work tree. Personal globals go to the private
# PIXI_HOME that .bash_env selects, populated from container/pixi-global.toml by
# container/bootstrap.sh.
#
# NOT skipped on DevPod: ~/.pixi is container-local there, and skipping it left
# the workspace with only the image's own pixi envs — no fzf, no zoxide, no rg —
# because `pixi global sync` then synced the image's manifest, not this repo's.
.pixi
{{ end -}}

{{ if not .heavy -}}
# No dev toolchains on this profile — skip the Neovim config tree too
.config/nvim
{{ end -}}

{{ if not .gui -}}
.config/uhk-agent
.config/kitty
.config/xfce4/helpers.rc
{{ end -}}

{{ if not .host -}}
# nvidia-upgrades edits /etc/apt/apt.conf.d to keep unattended-upgrades off the
# NVIDIA driver and the kernel. Pointless in a container (no kernel of its own)
# and unusable on a shared account (no write access to /etc).
.local/bin/nvidia-upgrades
{{ end -}}

{{/* .terminfo is deliberately NOT gated on .gui. Kitty runs locally, but
     TERM=xterm-kitty travels over SSH into headless shared/robot/container
     boxes, where ncurses needs the entry to initialise TUIs and tput —
     without it `tput setaf 1` fails and the colored PS1 never fires.
     Do not move it back into the block above. */}}
