{{- $profile := env "CHEZMOI_PROFILE" | default (ne (env "DEVPOD") "" | ternary "devpod" "full") -}}
#!/bin/bash
{{ if ne $profile "devpod" -}}
set -e

PIXI_NPM="$HOME/.pixi/envs/nodejs/bin/npm"

if [ ! -f "$PIXI_NPM" ]; then
    echo "⏭ pixi nodejs env not found, skipping pi installation"
    exit 0
fi

echo "Installing @mariozechner/pi-coding-agent..."
"$PIXI_NPM" install -g @mariozechner/pi-coding-agent

echo "✓ pi installed"
{{ else -}}
# Skipping pi installation (profile: {{ $profile }})
exit 0
{{ end -}}
