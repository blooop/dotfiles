#!/bin/bash
{{ if .gui -}}
# Install the current upstream Kitty binary and desktop integration.

set -euo pipefail

KITTY_APP="$HOME/.local/kitty.app"
LOCAL_BIN="$HOME/.local/bin"
APPLICATIONS="$HOME/.local/share/applications"

if [[ ! -x "$KITTY_APP/bin/kitty" ]]; then
    curl -L https://sw.kovidgoyal.net/kitty/installer.sh |
        sh /dev/stdin launch=n
fi

mkdir -p "$LOCAL_BIN" "$APPLICATIONS"
ln -sf "$KITTY_APP/bin/kitty" "$LOCAL_BIN/kitty"
ln -sf "$KITTY_APP/bin/kitten" "$LOCAL_BIN/kitten"

install -m 0644 \
    "$KITTY_APP/share/applications/kitty.desktop" \
    "$APPLICATIONS/kitty.desktop"
sed -i \
    -e "s|^Icon=kitty$|Icon=$KITTY_APP/share/icons/hicolor/256x256/apps/kitty.png|" \
    -e "s|^Exec=kitty|Exec=$KITTY_APP/bin/kitty|" \
    "$APPLICATIONS/kitty.desktop"

command -v update-desktop-database >/dev/null 2>&1 &&
    update-desktop-database "$APPLICATIONS" >/dev/null 2>&1 || true
{{ else -}}
# Skipping Kitty installation (profile: {{ .profile }}, no gui)
exit 0
{{ end -}}
