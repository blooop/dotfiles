#!/bin/bash
{{ if .toolbox -}}
# Installs herdr's Claude Code integration: ~/.claude/hooks/herdr-agent-state.sh
# plus a SessionStart entry in ~/.claude/settings.json.
#
# What the integration actually buys, because it is narrower than it sounds. For
# Claude Code on herdr 0.8.2 the hook reports one thing — the agent's *session
# id* (`pane.report_agent_session`) — and nothing else. It does not report
# lifecycle state, so `blocked` / `working` / `done` stay screen-manifest
# detection either way. What it enables is session resume: with the id on record,
# `session.resume_agents_on_restore` can bring a pane back as
# `claude --resume <id>` after the server restarts, instead of a bare shell in
# the right directory. That is the single biggest thing herdr does that Zellij's
# session_serialization could not, so it is worth the hook.
#
# The settings half lives in private_dot_claude/modify_settings.json rather than
# here, because that script enforces the whole `hooks` object on every apply and
# would otherwise delete whatever the installer had written. This script only
# has to make the hook file exist.
#
# Gated on .toolbox for the same reason as the server unit: that is where herdr
# comes from, and a container has none.
#
# Why this is keyed on a stat of the binary rather than a hand-bumped number.
#
# It used to carry `# integration version: N (bump to force a reinstall)`. That
# never worked, twice over. The comment did re-render and did change the
# run_onchange hash, so the script ran -- and then exited at the `[ -f "$hook" ]`
# guard below, because the hook file was already there. So the bump forced a
# re-run that could not reinstall anything. It also needed a human to notice a
# herdr release and edit this file, which is the kind of upkeep nobody does: the
# two machines here drifted to v7 and v8 against herdr's v9, silently, and the
# only visible symptom was agents failing to resume after a server restart.
#
# Statting the binary makes the trigger automatic -- a `pixi global update` that
# moves herdr changes the rendered output, so this re-runs on the apply that
# follows the upgrade. Same construct and same path choice as
# run_onchange_after_install-herdr-skill.sh.tmpl: the env path, never
# ~/.pixi/bin/herdr, which is a trampoline shared by every pixi global and would
# fingerprint pixi rather than herdr.
#
# herdr binary fingerprint (path, size, mtime) — the run_onchange hash key:
{{- $seen := list }}
{{- range concat (list (joinPath .chezmoi.homeDir ".pixi/envs/herdr/bin/herdr") (joinPath .chezmoi.homeDir ".local/bin/herdr")) (compact (list (lookPath "herdr"))) }}
{{-   $path := . }}
{{-   if not (has $path $seen) }}
{{-     $seen = append $seen $path }}
{{-     with stat $path }}
#   {{ $path }} {{ .size }} {{ .modTime }}
{{-     end }}
{{-   end }}
{{- end }}

set -euo pipefail

hook="$HOME/.claude/hooks/herdr-agent-state.sh"

if ! command -v herdr >/dev/null 2>&1; then
    echo "herdr not on PATH yet; skipping its Claude integration until the next apply"
    exit 0
fi

# Ask herdr, rather than testing for the file. A hook that exists is not a hook
# that is current, and "exists" was the old guard -- which is what let v7 and v8
# sit here against herdr's v9. `integration status` prints one line per agent:
# "current (vN)", "outdated (vN < vM)", or "not installed".
#
# Reinstalling appends a second identical SessionStart entry rather than noticing
# the first -- the installer is not idempotent about settings.json. That is
# tolerated, not ignored: private_dot_claude/modify_settings.json enforces the
# whole `hooks` object and normalises the duplicate away. It sorts before this
# script, so the duplicate lives until the *next* apply; both copies run the same
# hook and report the same session id, so the cost is one redundant hook call per
# session start in that window.
status=$(herdr integration status 2>/dev/null | grep '^claude:' || true)

case "$status" in
    *"not installed"*)
        echo "installing herdr Claude integration"
        herdr integration install claude
        ;;
    *outdated*)
        echo "upgrading herdr Claude integration (${status#claude: })"
        herdr integration install claude
        ;;
    *current*)
        echo "herdr Claude integration ${status#claude: }"
        ;;
    *)
        # An unrecognised line means a herdr that renamed or reformatted this
        # output. Install rather than guess: it is idempotent about the hook file
        # itself, and settings.json is normalised on the next apply either way.
        echo "herdr integration status unrecognised (${status:-empty}); installing"
        herdr integration install claude
        ;;
esac
{{ else -}}
# Skipping herdr Claude integration (profile: {{ .profile }}, no toolbox)
{{ end -}}
