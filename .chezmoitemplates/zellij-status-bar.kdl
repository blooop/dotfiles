// zjstatus bottom bar. Shared by every layout through a chezmoi template
// inclusion, because zjstatus can only be configured where it is instantiated —
// in a layout file, not in config.kdl — and a second copy would inevitably drift.
//
// It replaces zellij:status-bar, which cannot show any of this. That plugin
// renders a fixed vocabulary of mode-switch hints introspected from the config,
// so `keybinds clear-defaults=true` leaves it almost empty, and direct action
// bindings like F2 -> NewTab are outside its vocabulary entirely. The legend below
// is therefore written by hand and must be updated alongside the keybinds.
//
// One line rather than the two zellij:status-bar took, so the bar is cheaper than
// what it replaces. On a narrow window the centre legend truncates first.
pane size=1 borderless=true {
    plugin location="file:{{ .chezmoi.homeDir }}/.config/zellij/plugins/zjstatus.wasm" {
        // The mode alone, deliberately without {session}.
        //
        // A centred segment needs symmetric clearance, so zjstatus renders this
        // bar only above `2 * len(format_left) + len(format_center)` columns and
        // draws nothing at all below it — not a truncated legend, an empty line.
        // With the session name here that threshold rode on a name Zellij picks
        // at random: "main" needed 118 columns, "chatty-weasel" 136,
        // "gregarious-jellyfish" 150. The bar therefore vanished on some windows
        // and not others, with nothing on screen to say why, and narrowing the
        // window far enough brought it back because a different truncation path
        // takes over near 100. Dropping {session} makes the threshold a constant
        // ~110 columns that no session name can move.
        //
        // Nothing is lost: zellij:tab-bar already renders "Zellij (name)" one row
        // above, which is why that plugin is still in the layout at all.
        format_left   "{mode}"
        format_center "#[fg=#89B4FA,bold]F1#[fg=#6C7086] git  #[fg=#89B4FA,bold]F2#[fg=#6C7086] +tab  #[fg=#89B4FA,bold]F3#[fg=#6C7086] ◀  #[fg=#89B4FA,bold]F4#[fg=#6C7086] ▶  #[fg=#89B4FA,bold]F5#[fg=#6C7086] ws  #[fg=#89B4FA,bold]F6#[fg=#6C7086] detach  #[fg=#89B4FA,bold]F7#[fg=#6C7086] exit  #[fg=#89B4FA,bold]F8#[fg=#6C7086] +pane  #[fg=#89B4FA,bold]F9#[fg=#6C7086] leap  #[fg=#89B4FA,bold]F10#[fg=#6C7086] close  #[fg=#89B4FA,bold]F11#[fg=#6C7086] ai"
        format_right  ""
        format_space  ""

        // There is deliberately no command widget here, and that is a load-bearing
        // absence: this bar used to run zjcount as `command_sessions` on a "300"
        // second interval, and zjstatus does not honour that interval. It re-runs
        // the command as fast as the command can exit, measured at 571 invocations
        // per second across five servers — 34,000x the configured rate — and it
        // never reaps them, so the zombies pile up alongside. Output has nothing to
        // do with it; a script that printed nothing at all still span at 867/s.
        //
        // That turned a housekeeping number into the most expensive thing on the
        // machine twice over. zjcount's own `zellij list-sessions` connects to every
        // server in the list, so from inside a status bar it is O(sessions^2); once
        // sessions had accumulated it passed ten seconds, each invocation wedged on
        // a pipe its `timeout 3` could not close, and ~3300 stuck processes took the
        // load average to 880 on 8 cores. Rewriting zjcount to pure filesystem
        // counting only converted the pileup into a spin that still burned a full
        // core across the zellij servers.
        //
        // So the session-count signal cannot live in this bar until zjstatus honours
        // its own interval. zjcount itself went with the slot; `zjclean` is what
        // lists the accumulated sessions and acts on them.
        border_enabled "false"

        // Normal and Locked are the two states worth telling apart at a glance:
        // Locked means autolock has handed the keys to the application. Every
        // other mode is the Ctrl+; control layer and shares one look, which
        // mode_default_to_mode supplies without listing all twelve.
        mode_normal          "#[bg=#A6E3A1,fg=#181825,bold] {name} "
        mode_locked          "#[bg=#F38BA8,fg=#181825,bold] {name} "
        mode_pane            "#[bg=#F9E2AF,fg=#181825,bold] {name} "

        // The pass-through layer. Labelled by hand because {name} renders the
        // InputMode's own name, "TMUX", which says nothing about what the mode
        // does here and invites the guess that tmux is somehow involved. Its own
        // colour because this is the one mode where the keys you press are not
        // going to Zellij at all, and F12 is the only way back.
        mode_tmux            "#[bg=#CBA6F7,fg=#181825,bold] PASS "

        mode_default_to_mode "pane"
    }
}
