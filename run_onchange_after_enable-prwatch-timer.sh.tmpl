#!/bin/bash
{{ if .toolbox -}}
# Enables prwatch.timer once the unit files are in place. `after_` because the
# units have to exist before `enable` can read them; `onchange` on their hashes
# so an edited unit is reloaded and re-enabled without a manual daemon-reload.
#
# Gated on .toolbox: that is where gh, jq and herdr come from, and a container
# has no systemd user session to hold a timer anyway (the guard below makes it
# a no-op there too, belt and braces).
#
# `enable --now` starts the timer, not the service, so the first poll happens
# at OnBootSec after the timer starts rather than during the apply.
#
# prwatch.service hash: {{ include "dot_config/systemd/user/prwatch.service" | sha256sum }}
# prwatch.timer hash:   {{ include "dot_config/systemd/user/prwatch.timer" | sha256sum }}

set -euo pipefail

if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "no systemd user session; skipping prwatch.timer"
    exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now prwatch.timer
echo "prwatch.timer enabled: $(systemctl --user list-timers prwatch.timer --no-pager --no-legend | head -1)"
{{ else -}}
# Skipping prwatch.timer (profile: {{ .profile }}, no toolbox)
{{ end -}}
