{{/* Config template — chezmoi init generates ~/.config/chezmoi/chezmoi.toml from this.
     The profile is resolved ONCE per machine (persisted in the generated config);
     `chezmoi apply` never depends on ambient env vars after that.

     Profiles (invasivity levels):
       personal  — your own machine: identity, GUI tools, full dev toolchains
       shared    — shared account (ags isolated shells, lab PCs): minimal, NO git identity
       robot     — robots/appliances: host CLI tools, no identity, no GUI, no toolchains
       container — devcontainers/DevPod: minimal; identity kept (DevPod injects git creds)
       kinisi    — kinisi_ros dev containers: container, but with $HOME trees bind-mounted
                   from the host and ~/.pixi owned by the image, so chezmoi must stay off
                   both. Selected only by container/bootstrap.sh (kbash), never prompted.

     Non-interactive selection: CHEZMOI_PROFILE=robot chezmoi init --apply <repo>
     Change an existing machine: CHEZMOI_PROFILE=<profile> chezmoi init --apply

     The fall-through is `shared`, deliberately, and it is the answer to "nothing
     here identifies this machine". It used to be `personal`, which is the worst
     available answer to that question: `personal` is the only profile with
     identity, gui, heavy AND host all on, so an unrecognised environment got the
     most invasive install in the matrix.

     Which default governs where, because the two paths differ: `promptChoiceOnce`
     does NOT quietly fall back without a tty -- it fails outright ("could not open
     a new TTY"), and yields this default only under `--promptDefaults`. So this
     default covers a hand-run interactive `chezmoi init`. Every scripted path goes
     through install.sh, which resolves a profile itself and passes it as
     `CHEZMOI_PROFILE=<profile> chezmoi init --apply --force`, bypassing the prompt
     entirely -- so install.sh's own fall-through is the one that actually fired,
     and it is fixed there too. Both now land on `shared`.

     What that cost, concretely: a kinisi dev container entered by any route other
     than kbash gets no KINISI_INSTANCE handshake, so it never reaches the `kinisi`
     row. It fell through to `personal`, and because the compose files bind-mount
     ~/.config, ~/.cache and ~/.local/share from the host, "the container's
     ~/.config" and "the host's ~/.config" are one directory -- so it wrote a
     kitty.conf rendered for /home/kinisi onto the host, and put 79 /home/kinisi
     keys in the host's shared chezmoi state DB.

     `shared` closes the capability half of that: identity, gui, heavy and host all
     go off, so no git identity is written, and the GUI and toolchain trees
     (.config/kitty, .config/nvim) are not touched. It does NOT close the ownership
     half -- pixi, xdg, gitconfig and claudecfg are all still on for `shared`, so on
     these flags alone an unidentified container may still write host-mounted trees.

     That half is closed in install.sh, not here, and it has to be: this template
     generates ~/.config/chezmoi/chezmoi.toml, so in a container whose ~/.config is
     the host's, the file carrying these flags is itself one of the casualties -- no
     value set below can protect it. install.sh therefore refuses to run at all when
     $HOME's config trees are on a different filesystem from $HOME *and* findmnt
     names their source subpath under some other home. See "Refusing a home that is
     not this machine's" in the README. */}}
{{- $choices := list "personal" "shared" "robot" "container" "kinisi" -}}
{{- $profile := env "CHEZMOI_PROFILE" -}}
{{- if not $profile -}}
{{-   if env "AGS_SHELL" -}}
{{-     $profile = "shared" -}}
{{-   else if env "DEVPOD" -}}
{{-     $profile = "container" -}}
{{-   else -}}
{{-     $profile = promptChoiceOnce . "profile" "Machine profile" $choices "shared" -}}
{{-   end -}}
{{- end -}}
{{/* backward compat with pre-profile-matrix names */}}
{{- if eq $profile "full" }}{{ $profile = "personal" }}{{ end -}}
{{- if eq $profile "devpod" }}{{ $profile = "container" }}{{ end -}}
{{- if not (has $profile $choices) -}}
{{-   fail (printf "unknown profile %q (want one of %s)" $profile (join ", " $choices)) -}}
{{- end -}}
{{- $personal := eq $profile "personal" -}}
{{/* Container classes: DevPod/devcontainer workspaces and kinisi containers. Both have
     ~/.gitconfig and ~/.claude supplied by the runtime (DevPod injects git credentials;
     devlaunch bind-mounts the host's ~/.claude rw), so chezmoi must not write either. */}}
{{- $containerish := has $profile (list "container" "kinisi") -}}

[data]
    profile  = {{ $profile | quote }}
    # Capability matrix — the ONLY place profile names are interpreted.
    # Templates gate on these flags, never on profile names.
    identity  = {{ or $personal (eq $profile "container") }}  # git user name/email
    gui       = {{ $personal }}                               # nerd fonts, uhk-agent, nvtop
    heavy     = {{ $personal }}                               # rust, neovim, nodejs, devpod, ccache
    host      = {{ or $personal (eq $profile "robot") }}      # git, openssh, curl, unzip
    monitor   = {{ not $containerish }}                       # htop, btop
    agents    = {{ or $personal (eq $profile "shared") }}     # codex, opencode CLI agents
    # Ownership flags — which parts of $HOME chezmoi is allowed to write. False where
    # something else owns the path: a host bind-mount, the image, or the container runtime.
    pixi      = {{ ne $profile "kinisi" }}                    # ~/.pixi/manifests/pixi-global.toml
    xdg       = {{ ne $profile "kinisi" }}                    # ~/.config, ~/.cache, ~/.local/share
    gitconfig = {{ not $containerish }}                       # ~/.gitconfig
    claudecfg = {{ not $containerish }}                       # ~/.claude

[git]
    # Disable autoCommit to avoid prompts in non-interactive environments
    autoCommit = false

[template]
    options = ["missingkey=error"]
