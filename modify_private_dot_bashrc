#!/bin/bash
# Chezmoi modify script for .bashrc
# Adds the .bash_env hook and cleans up manual additions.
#
# Where the hook goes depends on the .bashrc being modified, because the two
# .bashrc files this repo meets have their non-interactive `return` in different
# places relative to what we need:
#
#   Ubuntu's       returns near the top; everything personal belongs after it,
#                  and specifically after its PS1 block, which would otherwise
#                  overwrite the color decision .bash_env makes.
#   kinisi's ROS   opens with a section it declares runs in "BOTH interactive and
#                  non-interactive login shells ... so LLM agents can execute
#                  commands with full environment loaded", then returns. A hook
#                  after that return is unreachable to `dl -- <command>` and to
#                  `aid`, which is how `aid` sessions came up with no personal
#                  PATH and so no claude-statusline.
#
# So: hook into that pre-return section when the file declares one, and keep the
# late placement otherwise. Matching the image's own declared contract rather
# than the container's name means any image offering the same guarantee gets the
# same treatment. .bash_env returns early when non-interactive, so the early
# position costs a one-command shell only the environment it actually wants.

bashrc_content=$(cat)

# Strip manual pixi/PATH/broot additions, and any hook already placed by an
# earlier version of this script -- the hook is re-inserted below, so removing it
# first is what lets it *move* when this script's placement rules change.
strip() {
    sed '/^export PATH=".*\.pixi\/bin.*"$/d' |
        sed '/^eval "$(pixi completion/d' |
        sed '/^export PATH="\$HOME\/\.local\/bin:\$PATH"$/d' |
        sed '/broot\/launcher\/bash\/br/d' |
        # An old install.sh wrote this naming a variable it never set, so it
        # prepended an EMPTY element -- which bash reads as the current
        # directory, putting cwd ahead of everything on PATH. Dead and unsafe;
        # the pixi bin dir it was reaching for comes from .bash_env now.
        sed '/^export PATH="\$DEVCONTAINER_CLI_PATH:\$PATH"$/d' |
        sed '/^# Added by dotfiles setup$/d' |
        awk '
            # Blank lines are held back one line, so the one that precedes the
            # hook block goes with it instead of accumulating on every re-run.
            /^$/ && !skip { held = held "\n"; next }
            /^# Source environment configuration \(managed by chezmoi\)$/ ||
            /^# Environment only \(managed by chezmoi\)/ ||
            /^# One-command PATH \(managed by chezmoi\)/ ||
            /^# Collapse PATH \(managed by chezmoi\)/ {
                held = ""
                skip = 1
                next
            }
            skip && /^fi$/ { skip = 0; next }
            skip { next }
            { printf "%s", held; held = ""; print }
            END { printf "%s", held }
        '
}

hook() {
    echo "# Source environment configuration (managed by chezmoi)"
    echo "if [ -f ~/.bash_env ]; then"
    echo "    . ~/.bash_env"
    echo "fi"
}

# Deduplicate PATH after every block in the file, not just after ours.
#
# .bash_env deduplicates when it is sourced, but it cannot be last: on this host
# a generated KINISI_ENVIRONMENT block sits below the hook and sources a work
# repo's .env, which prepends ~/.pixi/bin and ~/.local/bin unconditionally. That
# block is regenerated by someone else's script, so it is not ours to guard --
# running once more, here at the end, is. _path_dedupe comes from .bash_env, so
# this is a no-op in a shell that never sourced it.
tail_block() {
    echo ""
    echo "# Collapse PATH (managed by chezmoi) — see .bash_env's _path_dedupe."
    echo "# Last position in the file, so it catches blocks written below ours."
    echo 'if [ "$(type -t _path_dedupe)" = function ]; then'
    echo "    _path_dedupe"
    echo "    _path_promote \"\$PIXI_HOME/bin\""
    echo "    export PATH"
    echo "fi"
}

# The smallest thing that fixes a one-command shell: PATH, and nothing else.
#
# `ssh host <cmd>` is a non-login, non-interactive bash. It reads .bashrc -- the
# sshd special case -- and returns at the interactive guard, which on Ubuntu is
# line 8, long before the .bash_env hook this script writes further down. So every
# pixi tool was invisible to a remote command. Measured on one host: of 93 binaries
# pixi exposes, 55 did not resolve at all, and the 38 that did resolved to older
# system copies -- git 2.43.0 instead of 2.55.0, ripgrep 14.1.0 instead of 15.2.0.
# Nothing announced this. A missing command is loud; a silently older git is not.
#
# It broke two things that resolve a binary by name, both of them correctly: herdr's
# remote bootstrap probes `command -v herdr` over exactly this kind of shell, and
# devlaunch's dl-herdr-shell guards on `command -v dl` before exec'ing the pane
# shell. herdr closed it as expected behavior (herdrdev/herdr#3950): the
# non-interactive PATH is the contract, and pixi is not one of its fallbacks. Fair
# enough -- that makes the PATH ours to set.
#
# PATH only, and emphatically not the .bash_env env half, which case 1 below uses.
# That half also runs _ssh_agent_setup, which probes with `timeout 2 ssh-add -l`
# and on a miss starts an agent daemon and may spend `timeout 5 ssh-add` on a key.
# Every scp, rsync and git-upload-pack would pay that, and spawning a daemon from
# inside an rsync's remote shell is its own bug. Case 1 accepts the cost because a
# kinisi container's agent socket is bind-mounted and already answers.
#
# Guarded on the directory, not on a profile: this script is not a template, and
# "is there a pixi here" is the honest question anyway.
early_path_stub() {
    awk '
        BEGIN { done = 0 }
        !done && /^# If not running interactively/ {
            print "# One-command PATH (managed by chezmoi) --- before the non-interactive"
            print "# return below, so `ssh host <cmd>` can resolve a pixi tool by name."
            print "if [ -d \"$HOME/.pixi/bin\" ]; then"
            print "    case \":$PATH:\" in"
            print "        *\":$HOME/.pixi/bin:\"*) ;;"
            print "        *) PATH=\"$HOME/.pixi/bin:$PATH\"; export PATH ;;"
            print "    esac"
            print "fi"
            print ""
            done = 1
        }
        { print }
    '
}

stripped=$(echo "$bashrc_content" | strip)

# Case 1: the file reserves a pre-return section for non-interactive shells.
# It gets TWO hooks, because the two halves of .bash_env want opposite positions.
# The environment has to land before the return, or a non-interactive shell never
# sees it. The interactive half has to land after the image's prompt block, which
# sits between the two and would otherwise overwrite the PS1 this repo sets. So:
# env-only early, everything else late, at the same .bash_aliases anchor Ubuntu
# uses. Falls through to case 2 if either anchor is missing.
if echo "$stripped" | grep -q 'runs in BOTH interactive and non-interactive' &&
    echo "$stripped" | grep -q '^# If not running interactively' &&
    echo "$stripped" | grep -q 'if \[ -f ~/\.bash_aliases \]; then'; then
    echo "$stripped" | awk '
        BEGIN { early = 0; late = 0 }
        !early && /^# If not running interactively/ {
            print "# Environment only (managed by chezmoi) — before the"
            print "# non-interactive return below, so agents running one command get PATH."
            print "if [ -f ~/.bash_env ]; then"
            print "    _BASH_ENV_ENV_ONLY=1 . ~/.bash_env"
            print "    unset _BASH_ENV_ENV_ONLY"
            print "fi"
            print ""
            early = 1
        }
        !late && /if \[ -f ~\/\.bash_aliases \]; then/ {
            print
            getline; print  # the ". ~/.bash_aliases" line
            getline; print  # the "fi" line
            print ""
            print "# Source environment configuration (managed by chezmoi)"
            print "if [ -f ~/.bash_env ]; then"
            print "    . ~/.bash_env"
            print "fi"
            late = 1
            next
        }
        { print }
    '
    tail_block
    exit 0
fi

# Case 1 returned above. Everything else gets the PATH stub before its guard.
stripped=$(echo "$stripped" | early_path_stub)

# Case 2: hook in after the .bash_aliases block, the late position Ubuntu wants.
result=$(echo "$stripped" | awk '
    BEGIN { found = 0 }
    /if \[ -f ~\/\.bash_aliases \]; then/ {
        found = 1
        print
        getline; print  # the ". ~/.bash_aliases" line
        getline; print  # the "fi" line
        print ""
        print "# Source environment configuration (managed by chezmoi)"
        print "if [ -f ~/.bash_env ]; then"
        print "    . ~/.bash_env"
        print "fi"
        next
    }
    { print }
    END { if (!found) exit 1 }
')

if [[ $? -eq 0 ]]; then
    echo "$result"
else
    # Case 3: neither anchor present — append at the end.
    echo "$stripped"
    echo ""
    hook
fi
tail_block
