#!/bin/bash
# Chezmoi modify script for .bashrc
# Adds the .bash_env hook and cleans up manual additions.
#
# Where the hook goes depends on the .bashrc being modified, because the two
# .bashrc files this repo meets have their non-interactive `return` in different
# places relative to what we need:
#
#   Ubuntu's       returns near the top; everything personal belongs after it,
#                  and specifically after its PS1 block, which would otherwise
#                  overwrite the color decision .bash_env makes.
#   kinisi's ROS   opens with a section it declares runs in "BOTH interactive and
#                  non-interactive login shells ... so LLM agents can execute
#                  commands with full environment loaded", then returns. A hook
#                  after that return is unreachable to `dl -- <command>` and to
#                  `aid`, which is how `aid` sessions came up with no personal
#                  PATH and so no claude-statusline.
#
# So: hook into that pre-return section when the file declares one, and keep the
# late placement otherwise. Matching the image's own declared contract rather
# than the container's name means any image offering the same guarantee gets the
# same treatment. .bash_env returns early when non-interactive, so the early
# position costs a one-command shell only the environment it actually wants.

bashrc_content=$(cat)

# Strip manual pixi/PATH/broot additions, and any hook already placed by an
# earlier version of this script -- the hook is re-inserted below, so removing it
# first is what lets it *move* when this script's placement rules change.
strip() {
    sed '/^export PATH=".*\.pixi\/bin.*"$/d' |
        sed '/^eval "$(pixi completion/d' |
        sed '/^export PATH="\$HOME\/\.local\/bin:\$PATH"$/d' |
        sed '/broot\/launcher\/bash\/br/d' |
        awk '
            # Blank lines are held back one line, so the one that precedes the
            # hook block goes with it instead of accumulating on every re-run.
            /^$/ && !skip { held = held "\n"; next }
            /^# Source environment configuration \(managed by chezmoi\)$/ ||
            /^# Environment only \(managed by chezmoi\)/ {
                held = ""
                skip = 1
                next
            }
            skip && /^fi$/ { skip = 0; next }
            skip { next }
            { printf "%s", held; held = ""; print }
            END { printf "%s", held }
        '
}

hook() {
    echo "# Source environment configuration (managed by chezmoi)"
    echo "if [ -f ~/.bash_env ]; then"
    echo "    . ~/.bash_env"
    echo "fi"
}

stripped=$(echo "$bashrc_content" | strip)

# Case 1: the file reserves a pre-return section for non-interactive shells.
# It gets TWO hooks, because the two halves of .bash_env want opposite positions.
# The environment has to land before the return, or a non-interactive shell never
# sees it. The interactive half has to land after the image's prompt block, which
# sits between the two and would otherwise overwrite the PS1 this repo sets. So:
# env-only early, everything else late, at the same .bash_aliases anchor Ubuntu
# uses. Falls through to case 2 if either anchor is missing.
if echo "$stripped" | grep -q 'runs in BOTH interactive and non-interactive' &&
    echo "$stripped" | grep -q '^# If not running interactively' &&
    echo "$stripped" | grep -q 'if \[ -f ~/\.bash_aliases \]; then'; then
    echo "$stripped" | awk '
        BEGIN { early = 0; late = 0 }
        !early && /^# If not running interactively/ {
            print "# Environment only (managed by chezmoi) — before the"
            print "# non-interactive return below, so agents running one command get PATH."
            print "if [ -f ~/.bash_env ]; then"
            print "    _BASH_ENV_ENV_ONLY=1 . ~/.bash_env"
            print "    unset _BASH_ENV_ENV_ONLY"
            print "fi"
            print ""
            early = 1
        }
        !late && /if \[ -f ~\/\.bash_aliases \]; then/ {
            print
            getline; print  # the ". ~/.bash_aliases" line
            getline; print  # the "fi" line
            print ""
            print "# Source environment configuration (managed by chezmoi)"
            print "if [ -f ~/.bash_env ]; then"
            print "    . ~/.bash_env"
            print "fi"
            late = 1
            next
        }
        { print }
    '
    exit 0
fi

# Case 2: hook in after the .bash_aliases block, the late position Ubuntu wants.
result=$(echo "$stripped" | awk '
    BEGIN { found = 0 }
    /if \[ -f ~\/\.bash_aliases \]; then/ {
        found = 1
        print
        getline; print  # the ". ~/.bash_aliases" line
        getline; print  # the "fi" line
        print ""
        print "# Source environment configuration (managed by chezmoi)"
        print "if [ -f ~/.bash_env ]; then"
        print "    . ~/.bash_env"
        print "fi"
        next
    }
    { print }
    END { if (!found) exit 1 }
')

if [[ $? -eq 0 ]]; then
    echo "$result"
else
    # Case 3: neither anchor present — append at the end.
    echo "$stripped"
    echo ""
    hook
fi
