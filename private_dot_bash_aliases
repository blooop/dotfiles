# Kinisi dev containers: enter one with personal dotfiles freshly applied.
#
# kinisi_ros containers are launched by `kinisi_env start` — it already handles
# X11, NVIDIA, privileged mode and the per-clone mounts, which is why these are
# not DevPod/`dl` workspaces. What it does not do is install anyone's dotfiles,
# so this runs the bootstrap over the ~/.local/share bind-mount before dropping
# into a shell. Entirely host-side; kinisi_ros is untouched.
#
# The bootstrap is idempotent and cheap after the first run, so it runs on every
# entry — that keeps a rapidly-changing dotfiles repo actually applied, and makes
# re-entering the container the fix for whatever the last change broke.
function kbash {
    local clone="${1:?usage: kbash <clone>   e.g. kbash k1}"
    local container="kinisi_${ROS_DISTRO:-jazzy}_${clone}"

    if [ -z "$(docker ps -q -f "name=^${container}$")" ]; then
        echo "kbash: $container is not running — start it with: kinisi_env start" >&2
        return 1
    fi

    # Path is inside the container, resolved from its own HOME: the source dir
    # arrives via the ~/.local/share mount, and the container's HOME is not the
    # host's. Single-quoted so the container's shell expands $HOME, not this one.
    docker exec "$container" bash -c \
        'bash "$HOME/.local/share/chezmoi/container/bootstrap.sh"' || return 1

    # Plain `bash`, matching kinisi_env's own exec: an interactive non-login
    # shell sources the image's ROS .bashrc, which sources ~/.bash_aliases and
    # ~/.bash_env from there. Not `-l` — that routes through .profile, and the
    # ROS .bashrc returns early on the non-interactive path before reaching the
    # personal hooks. TERM survives so the prompt and TUIs get color; docker
    # exec otherwise forces a plain xterm.
    docker exec -it -e TERM="${TERM:-xterm-256color}" "$container" bash
}

# Run a devlaunch build against throwaway state instead of the real thing.
#
# `dl` keeps everything it knows in one place — metadata.json, the bare clones,
# config.toml — and resolves all of it through XDG_CACHE_HOME and
# XDG_CONFIG_HOME, so pointing those at a scratch directory is the whole
# sandbox. Nothing here touches the real workspace list, which is what makes a
# half-finished `dl-next` safe to run.
#
# Not a container: dl drives devpod and docker on the host, so the isolation
# that matters is the state, not the machine. The workspaces it creates are
# still real — `devpod list` shows them, and they need deleting like any other.
#
# Defaults to dl-next (the working copy) since that is what needs sandboxing;
# set DL_SANDBOX_BIN=dl to run the released build the same way.
function dl-sandbox {
    local root="${DL_SANDBOX_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/dl-sandbox}"
    local bin="${DL_SANDBOX_BIN:-dl-next}"

    if ! command -v "$bin" >/dev/null; then
        echo "dl-sandbox: $bin is not on PATH — build it with devlaunch's dev.sh" >&2
        return 1
    fi

    XDG_CACHE_HOME="$root/cache" XDG_CONFIG_HOME="$root/config" "$bin" "$@"
}

# Review a branch in a throwaway container, with the zellij tab named for its PR.
#
# Two things `aid` alone does not do. It leaves the workspace behind, which is
# why every review in shell history is followed by the same line again with
# `--rm --force` appended; `--autorm` (devlaunch >= 0.3.3) keeps it only for the
# life of the session, so the retry disappears.
#
# And the tab ends up called "Review this PR". Claude generates the session
# title from the first prompt, before any lookup has happened, and never revises
# it, so a screenful of review sessions is unnavigable. The PR number is what
# tells them apart. It has to be resolved out here: the agent runs in a
# container with no socket to the host zellij, so a rename from inside is a
# no-op no matter which skill asks for it.
#
# The prompt defaults to an adversarial third-party review of the branch, which
# is what this is for. Anything else passes straight through, so
# `aidre owner/repo@br '/review1st br'` and `'/respond br'` work the same way.
function aidre {
    local spec="$1"
    if [ -z "$spec" ]; then
        echo "aidre: usage: aidre <owner/repo>[@<branch>] [prompt...]" >&2
        return 2
    fi
    shift

    local repo="${spec%@*}" branch=""
    [ "$spec" != "$repo" ] && branch="${spec#*@}"

    # Empty when the branch has no PR yet (or gh is unauthenticated) — the tab
    # says `new` and the launch goes ahead regardless. A tab name is not worth
    # failing a review over.
    local pr=""
    if [ -n "$branch" ]; then
        pr=$(gh pr list --repo "$repo" --head "$branch" --json number \
             -q '.[0].number' 2>/dev/null)
    fi

    # No branch means the repo's default branch, where a PR number is not a
    # thing — name the tab after the repo instead of leaving a dangling "#new ".
    if [ -n "$ZELLIJ" ]; then
        if [ -n "$branch" ]; then
            zellij action rename-tab "#${pr:-new} ${branch##*/}" >/dev/null 2>&1
        else
            zellij action rename-tab "${repo##*/}" >/dev/null 2>&1
        fi
    fi

    if [ "$#" -eq 0 ]; then
        set -- "/review3rd ${branch}"
    fi

    aid "$spec" "$@" --autorm
}

# A tuios session for the current directory, tiled from the start.
#
# tuios has no config option for a default layout: tiling is per-session state
# that the daemon persists once set, but every new session starts floating. So it
# is switched on through the remote-control CLI as soon as the daemon answers.
#
# A retry loop rather than a fixed sleep, because how long the daemon takes to
# accept commands varies (~1.2s measured, longer on a cold start) and a timer that
# fires early silently leaves the session floating. rc=0 is the whole test: the
# setting sticks from then on. Note that `session-info` reports `floating` on a
# session with no windows even after this succeeds — the mode only shows up once
# there is a window to tile, so an empty session is not evidence it failed.
#
# `tuios new` rather than plain `tuios`, because only a daemon-backed session
# answers run-command, which is how the tiling below is switched on. (It was also
# what the F2/F3/F4 keys in kitty.conf needed, before Zellij took that row back.)
# Existence is tested against `tuios ls`, with its table colours stripped; probing
# with `tuios attach` also works but is slow to fail when no daemon is up yet, and
# that delay is charged to every fresh session.
function tui {
    local name="${1:-$(basename "$PWD")}"

    if tuios ls 2>/dev/null | sed -e 's/\x1b\[[0-9;]*m//g' | grep -qw -- "$name"; then
        tuios attach "$name"
        return
    fi

    (
        for _ in $(seq 40); do
            tuios run-command EnableTiling >/dev/null 2>&1 && break
            sleep 0.25
        done
    ) &

    tuios new "$name"
}
