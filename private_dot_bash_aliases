# Shell Aliases
# This file is managed by chezmoi

# Add cargo binaries to PATH
export PATH="$HOME/.cargo/bin:$PATH"

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# List files
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Git shortcuts (non-forgit)
alias gs='git status'
alias gp='git push'
alias lg='lazygit'
alias gg='glo --all'   # fuzzy all-branches graph (forgit log, remote-friendly)

# forgit provides these fzf-powered git aliases (sourced via .bash_env):
#   ga  - interactive add        gd  - interactive diff
#   gcb - checkout branch        gcf - checkout file
#   gco - checkout commit        gct - checkout tag
#   glo - interactive log        gbl - blame
#   grb - rebase                 grh - reset head
#   gss - stash show             gsp - stash push
#   gbd - branch delete          gclean - clean
#   gfu - fixup                  gsq - squash
#   gcp - cherry pick            grc - revert commit
#   grl - reflog                 grw - reword
#   gsw - switch branch          gso - show
#   gi  - gitignore              gat - attributes

# Safety
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Utilities
alias grep='grep --color=auto'
alias mkdir='mkdir -pv'
alias df='df -h'
alias du='du -h'
alias free='free -h'

