# Claude CLI
alias cld="claude --dangerously-skip-permissions"
alias cldr="claude --dangerously-skip-permissions --resume"

# Claude accounts: `ck` (kinisi) and `cb` (bear) pick the login for this shell.
# Both only set CLAUDE_CONFIG_DIR, which host `claude` reads for its login and
# `dl`/`aid` read for the token they forward, so one choice covers both.
#
# kinisi is ~/.claude itself. bear is ~/.claude-profiles/bear: its own
# .credentials.json and .claude.json (the account, and org-managed settings and
# caches), and a symlink back to ~/.claude for everything else, so settings,
# skills, hooks, memory and history stay one set. ~/.claude-profiles is the
# root `dl --claude-profile` reads, so `dl --claude-profiles` lists both.
CLAUDE_PROFILES_ROOT="${CLAUDE_PROFILES_DIR:-$HOME/.claude-profiles}"

_claude_profile_link() {
    local dir="$1" main="$HOME/.claude" entry name
    (umask 077 && command mkdir -p "$dir")
    for entry in "$main"/* "$main"/.[!.]*; do
        [[ -e "$entry" ]] || continue
        name="${entry##*/}"
        case "$name" in
            .credentials.json|.claude.json|.claude.json.*|*.tmp.*|*.lock|daemon*) continue ;;
            remote-settings.json|policy-limits.json*|mcp-needs-auth-cache.json|.last-update-result.json) continue ;;
        esac
        [[ -e "$dir/$name" || -L "$dir/$name" ]] || ln -s "$entry" "$dir/$name"
    done
    # Seed the state file so a new profile skips onboarding and keeps project
    # trust; drop the account and every account-scoped cache.
    if [[ ! -e "$dir/.claude.json" && -f "$main/.claude.json" ]]; then
        (umask 077 && jq 'del(.oauthAccount)
            | with_entries(select(.key | test("[Cc]ache|^claudeAiMcp|^mcpNeedsAuth|^metricsStatus") | not))' \
            "$main/.claude.json" > "$dir/.claude.json")
    fi
}

_claude_use() {
    local name="$1" dir="$2" acct
    [[ -e "$CLAUDE_PROFILES_ROOT/kinisi" ]] || { (umask 077 && command mkdir -p "$CLAUDE_PROFILES_ROOT") && ln -s "$HOME/.claude" "$CLAUDE_PROFILES_ROOT/kinisi"; }
    export CLAUDE_PROFILE="$name" CLAUDE_CONFIG_DIR="$dir"
    if [[ -f "$dir/.credentials.json" ]]; then
        acct=$(jq -r '.oauthAccount | "\(.emailAddress) · \(.organizationName)"' "$dir/.claude.json" 2>/dev/null)
        echo "claude: $name (${acct:-account unknown})"
    else
        echo "claude: $name is not signed in. Run 'claude', then /login."
    fi
}
ck() { _claude_use kinisi "$HOME/.claude"; }
cb() { _claude_profile_link "$CLAUDE_PROFILES_ROOT/bear" && _claude_use bear "$CLAUDE_PROFILES_ROOT/bear"; }

# dl forwards only the short-lived access token, and only a host `claude` on that
# config dir refreshes it. A profile used only through dl would forward a dead
# token, so spend one tiny request (~4 s) to refresh it. `claude` refreshes only
# inside its own last few minutes: with 48 min left the request ran and left the
# token alone, so a wider window here costs 4 s per launch and refreshes nothing.
_claude_token_fresh() {
    local cred="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json" exp
    [[ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}${DEVLAUNCH_NO_CLAUDE_TOKEN:-}" && -f "$cred" ]] || return 0
    exp=$(jq -r '.claudeAiOauth.expiresAt // 0' "$cred" 2>/dev/null) || return 0
    (( exp - $(date +%s%3N) > 300000 )) && return 0
    echo "claude: refreshing the ${CLAUDE_PROFILE:-kinisi} token" >&2
    claude -p --model haiku --no-session-persistence "Reply ok." </dev/null >/dev/null 2>&1 \
        || echo "claude: refresh failed; run 'claude' and /login for ${CLAUDE_PROFILE:-kinisi}" >&2
}
dl() { _claude_token_fresh; command dl "$@"; }
aid() { _claude_token_fresh; command aid "$@"; }

