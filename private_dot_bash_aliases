# Add cargo binaries to PATH
export PATH="$HOME/.cargo/bin:$PATH"

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# List files
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Git shortcuts (non-forgit)
alias gs='git status'
alias gp='git push'
alias lg='lazygit'

