#!/bin/bash
{{ if .toolbox -}}
# Enables the herdr server unit (dot_config/systemd/user/herdr-server.service).
#
# Gated on .toolbox because that is where herdr itself comes from: a container
# has no herdr and no systemd user session, so the unit would be dead weight.
#
# unit hash: {{ include "dot_config/systemd/user/herdr-server.service" | sha256sum }}

set -euo pipefail

# Where herdr actually is, in the order the unit's own Environment=PATH searches.
# There is no single answer: pixi installs it to ~/.pixi/bin from the toolbox
# manifest, and herdr's own remote bootstrap installs to ~/.local/bin, which is
# all a box first reached by `herdr --remote` has. The running-server guard below
# probed only the pixi path, so on such a box it saw nothing, concluded the
# socket was free, and started a unit that then failed 203/EXEC on the same wrong
# path -- twice wrong, and the second one loops.
herdr_bin() {
    local candidate

    for candidate in "$HOME/.pixi/bin/herdr" "$HOME/.local/bin/herdr"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    command -v herdr 2>/dev/null || true
}

herdr=$(herdr_bin)

# No systemd user session — a container, or a box booted without one. Not an
# error: `herdr` still works, it just spawns its own server the old way.
if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "No systemd --user session; skipping herdr-server.service"
    exit 0
fi

# Enabling a unit whose ExecStart cannot resolve buys a failed job at every
# login. `pixi global sync` has not necessarily run yet on a machine whose
# manifest only just gained herdr, so this is a real state, not a defensive one.
if [ -z "$herdr" ]; then
    echo "No herdr binary found (checked ~/.pixi/bin, ~/.local/bin, PATH);"
    echo "skipping herdr-server.service until one is installed."
    exit 0
fi

systemctl --user daemon-reload

# DISPLAY and XAUTHORITY are not in the systemd --user environment on XFCE/X11
# unless the session imports them, and panes inherit the server's environment —
# so without this, xclip and `clip` fail inside every pane while working fine in
# a plain terminal. Imported here so the unit picks them up on first start; a
# desktop session that already imports them makes this a no-op.
if [ -n "${DISPLAY:-}" ]; then
    systemctl --user import-environment DISPLAY XAUTHORITY || true
fi

systemctl --user enable herdr-server.service

if systemctl --user is-active --quiet herdr-server.service; then
    # Deliberately not restarted: that kills every pane, and this script runs on
    # any unit edit. Changing the unit is rare and losing a session of agents to
    # a `chezmoi apply` would not be.
    echo "herdr-server.service is running. To pick up unit changes (ends all panes):"
    echo "  systemctl --user restart herdr-server.service"
    exit 0
fi

# A server started the old way — as a child of whichever terminal ran `herdr`
# first — still holds the socket, and the unit would fail to bind it and then
# loop on Restart=on-failure. That server is exactly what this unit exists to
# replace, but killing it here would take a live session with it, so say so and
# leave it running.
if "$herdr" status server 2>/dev/null | grep -q '^status: running'; then
    echo "A herdr server is already running outside systemd; the unit is enabled"
    echo "but not started. It is still in the cgroup of the terminal that spawned"
    echo "it, so it dies with that window. When the session is expendable:"
    echo "  herdr server stop && systemctl --user start herdr-server.service"
    exit 0
fi

# --now equivalent, so a first apply does not need a logout.
systemctl --user start herdr-server.service
{{ else -}}
# Skipping herdr server unit (profile: {{ .profile }}, no toolbox)
{{ end -}}
