{{- /* Packages are gated on capability flags (.toolbox/.host/.heavy/.gui) set
       by .chezmoi.toml.tmpl — see the profile matrix there. */ -}}
version = 1

# === FLOOR (always installed, containers included) ===
#
# The eight envs every profile gets, containers included: what `claude` and `gh`
# need to be usable, and what chezmoi itself needs to keep applying. Everything
# else — the whole interactive toolbox — sits behind .toolbox below, because a
# devlaunch workspace was paying to install ~25 envs / ~1.27GB per create to run
# two of them. Adding an env here is adding it to every container, so the bar is
# "the floor stops working without it".
#
# fzf and git-delta are here rather than in the toolbox because private_dot_bash_env
# and dot_gitconfig.tmpl wire them in unconditionally; delta in particular is
# git's configured pager, so a container without it gets a broken `git diff`.
#
# forgit is here for exactly that reason and arrived late: private_dot_bash_env
# sources its plugin with no gate, and private_dot_bash_aliases defines `gg` on
# top of it, so while it sat in .toolbox a container silently lost `ga`, `gd`,
# `glo`, `gcb`, `gss` and `gg` — six aliases the README cheatsheet still listed.
# Moving it costs the profiles that already had it nothing. It is 248MB, almost
# none of it forgit: the package pulls its own full `git` and fzf as conda
# dependencies, so a container gets a second git beside the image's.

[envs.fzf]
channels = ["conda-forge"]
dependencies = { fzf = "*" }
exposed = { fzf = "fzf" }

[envs.git-delta]
channels = ["conda-forge"]
dependencies = { git-delta = "*" }
exposed = { delta = "delta" }

[envs.forgit]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { forgit = "*" }
exposed = { git-forgit = "git-forgit" }

[envs.chezmoi]
channels = ["conda-forge"]
dependencies = { chezmoi = "*" }
exposed = { chezmoi = "chezmoi" }

[envs.gh]
channels = ["conda-forge"]
dependencies = { gh = "*" }
exposed = { gh = "gh" }

[envs.jq]
channels = ["conda-forge"]
dependencies = { jq = "*" }
exposed = { jq = "jq" }

[envs.claude-shim]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { claude-shim = ">=0.3.0" }
exposed = { claude = "claude", cld = "cld", cldr = "cldr" }

# claude-statusline — the status line ~/.claude/settings.json points at
# (blooop/claude-statusline, built by blooop-feedstock). It clears the floor bar
# because settings.json travels into every container on the ~/.claude bind mount,
# so any machine that runs `claude` runs this — and containers have no python3
# for the script it replaced.
[envs.claude-statusline]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { claude-statusline = "*" }
exposed = { claude-statusline = "claude-statusline" }

{{- if .monitor }}

# === SYSTEM MONITORS (.monitor — everywhere except containers) ===

[envs.htop]
channels = ["conda-forge"]
dependencies = { htop = "*" }
exposed = { htop = "htop" }

[envs.btop]
channels = ["conda-forge"]
dependencies = { btop = "*" }
exposed = { btop = "btop" }
{{- end }}

{{- if .agents }}

# === AI CODING AGENTS (.agents — personal and shared machines) ===

[envs.codex]
channels = ["conda-forge"]
dependencies = { codex = "*" }
exposed = { codex = "codex" }

[envs.opencode-shim]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { opencode-shim = "*" }
exposed = { opencode = "opencode" }
{{- end }}

{{- if .editor }}

# === EDITOR (.editor — personal machines and containers) ===
#
# Kept out of the floor and out of .toolbox, and 1.1GB explains why: 18 of this
# env's 20 packages are the gcc/gxx toolchain, not neovim (~50MB). nvim-treesitter
# builds its parsers from source — dot_config/nvim/lua/plugins/private_treesitter.lua
# sets auto_install = true on top of six ensure_installed languages, and one of
# them (cpp) has a C++ scanner — so dropping the compiler does not give a smaller
# nvim, it gives an nvim that fails a parser build on first launch and retries on
# every buffer after. A container therefore pays full price or gets nothing, and
# this flag is where that choice is made.
#
# .editor is on for `personal` and `container`, so this reads the same on a
# personal machine as it did under .heavy. `shared` and `robot` deliberately stay
# on vim from the toolbox: neither had nvim before, and a lab PC or an appliance
# is the last place to want a compiler toolchain.
#
# The config tree travels with it: .chezmoiignore.tmpl gates .config/nvim on this
# flag, so nvim never comes up bare with LazyVim missing.
[envs.neovim]
channels = ["https://prefix.dev/github-releases", "conda-forge"]
dependencies = { neovim = "*", gcc = "*", gxx = "*" }
exposed = { nvim = "nvim" }
{{- end }}

{{- if .host }}

# === HOST TOOLS (.host — personal machines and robots) ===

[envs.git-lfs]
channels = ["conda-forge"]
dependencies = { git-lfs = "*" }
exposed = { git-lfs = "git-lfs" }

[envs.git]
channels = ["conda-forge"]
dependencies = { git = "*" }
exposed = { git = "git", git-cvsserver = "git-cvsserver", git-receive-pack = "git-receive-pack", git-shell = "git-shell", git-upload-archive = "git-upload-archive", git-upload-pack = "git-upload-pack", gitk = "gitk", scalar = "scalar" }

[envs.openssh]
channels = ["conda-forge"]
dependencies = { openssh = "*" }
exposed = { scp = "scp", sftp = "sftp", ssh = "ssh", ssh-add = "ssh-add", ssh-agent = "ssh-agent", ssh-keygen = "ssh-keygen", ssh-keyscan = "ssh-keyscan", sshd = "sshd" }

[envs.curl]
channels = ["conda-forge"]
dependencies = { curl = "*" }
exposed = { curl = "curl" }

[envs.unzip]
channels = ["conda-forge"]
dependencies = { unzip = "*" }
exposed = { unzip = "unzip" }

[envs.speedtest-go]
channels = ["https://prefix.dev/blooop"]
dependencies = { speedtest-go = "*" }
exposed = { speedtest-go = "speedtest-go" }
{{- end }}

{{- if .heavy }}

# === DEV TOOLCHAINS (.heavy — personal machines) ===
#
# neovim used to be here. It is under .editor now (below), because a container
# wants the editor without wanting the rest of this section.

[envs.ccache]
channels = ["conda-forge"]
dependencies = { ccache = "*" }
exposed = { ccache = "ccache" }

[envs.nodejs]
channels = ["conda-forge"]
dependencies = { nodejs = "*" }
exposed = { node = "node", npm = "npm", npx = "npx" }

[envs.pi]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { pi = "*" }
exposed = { pi = "pi" }

[envs.yq]
channels = ["conda-forge"]
dependencies = { yq = "*" }
exposed = { tomlq = "tomlq", yq = "yq", xq = "xq" }

# devpod alone. `dl` and `aid` come from the devlaunch env in the .toolbox
# section below, which is their single owner — exposing them from here as well is
# what the comment down there calls a sync error, because two environments would
# claim one executable name. (.heavy implies .toolbox in every row of the matrix,
# so that env is always there when this one is.)
[envs.devpod]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { devpod = "*" }
exposed = { devpod = "devpod" }

[envs.lazydocker]
channels = ["conda-forge"]
dependencies = { lazydocker = "*" }
exposed = { lazydocker = "lazydocker" }

[envs.rust]
channels = ["conda-forge"]
dependencies = { rust = "*", rust-analyzer = "*" }
exposed = { cargo = "cargo", cargo-clippy = "cargo-clippy", cargo-fmt = "cargo-fmt", clippy-driver = "clippy-driver", rust-analyzer = "rust-analyzer", rust-gdb = "rust-gdb", rust-gdbgui = "rust-gdbgui", rust-lldb = "rust-lldb", rustc = "rustc", rustdoc = "rustdoc", rustfmt = "rustfmt" }
{{- end }}

{{- if .gui }}

# === DESKTOP / GUI (.gui — personal machines) ===

[envs.nvtop]
channels = ["conda-forge"]
dependencies = { nvtop = "*" }
exposed = { nvtop = "nvtop" }

[envs.uhk-agent]
channels = ["https://prefix.dev/blooop"]
dependencies = { uhk-agent = "*" }
exposed = { uhk-agent = "uhk-agent" }

# kitty-bin, not kitty: conda-forge's kitty is a stale 0.23.1 source build, so the
# blooop feedstock repackages upstream's current Linux binary under a distinct name.
# conda-forge is required here — kitty-bin depends on fontconfig.
[envs.kitty-bin]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { kitty-bin = "*" }
exposed = { kitty = "kitty", kitten = "kitten" }
{{- end }}

{{- if .toolbox }}

# === TOOLBOX (.toolbox — everywhere except containers) ===
#
# Everything beyond the claude/gh floor: the interactive tools a person drives at
# a terminal, plus the launchers (wf, devlaunch) that open work elsewhere. Off in
# the container classes, where the only things ever run are `claude` and `gh` and
# nothing here would be typed — a multiplexer inside a workspace shell, a second
# devlaunch inside a devlaunch container, an editor nobody opens. That is ~19 of
# the ~25 envs and the great majority of the bytes, re-downloaded on every
# container create because a fresh container starts with an empty package cache.
#
# These are not "optional" on a real machine: on every profile with .toolbox they
# install exactly as before, which is every profile a human logs into.

[envs.zoxide]
channels = ["conda-forge"]
dependencies = { zoxide = "*" }
exposed = { zoxide = "zoxide" }

# forgit is NOT here — it moved to the floor above, because .bash_env sources it
# unconditionally and containers were left with dead git aliases. Do not re-add.

[envs.fd-find]
channels = ["conda-forge"]
dependencies = { fd-find = "*" }
exposed = { fd = "fd" }

[envs.ripgrep]
channels = ["conda-forge"]
dependencies = { ripgrep = "*" }
exposed = { rg = "rg" }

[envs.prek]
channels = ["conda-forge"]
dependencies = { prek = "*" }
exposed = { prek = "prek" }

[envs.xclip]
channels = ["conda-forge"]
dependencies = { xclip = "*" }
exposed = { xclip = "xclip", xclip-copyfile = "xclip-copyfile", xclip-cutfile = "xclip-cutfile", xclip-pastefile = "xclip-pastefile" }

[envs.zellij]
channels = ["conda-forge"]
dependencies = { zellij = "*" }
exposed = { zellij = "zellij" }

# tuios — a terminal window manager trialled as the replacement for Zellij
# (blooop/dotfiles) and not adopted; Zellij's autostart is back on both ends.
# Kept installed and dormant rather than removed: `tui` still starts a session by
# hand, and the next look at it costs nothing. Its only config is the leader key
# (dot_config/tuios/config.toml); it is otherwise on its own defaults.
[envs.tuios]
channels = ["conda-forge"]
dependencies = { tuios = "*" }
exposed = { tuios = "tuios", tuios-web = "tuios-web" }

# herdr — a terminal workspace manager for coding agents (herdrdev/herdr): each
# agent gets a real terminal on a server that outlives the client, so sessions
# survive a closed laptop and can be reattached over ssh. Sits beside zellij and
# tuios rather than replacing either — those multiplex a person's shells, this
# multiplexes agents.
#
# Deliberately unconfigured: no dot_config/herdr here, so it runs on its own
# defaults until using it says what is worth setting.
#
# `herdr update` and `herdr channel set` self-update the binary in place, which
# would fight pixi for ownership of it — let `pixi global sync` do upgrades and
# leave those two alone.
[envs.herdr]
channels = ["conda-forge"]
dependencies = { herdr = "*" }
exposed = { herdr = "herdr" }

[envs.lazygit]
channels = ["conda-forge"]
dependencies = { lazygit = "*" }
exposed = { lazygit = "lazygit" }

[envs.vim]
channels = ["conda-forge"]
dependencies = { vim = "*" }
exposed = { ex = "ex", rview = "rview", rvim = "rvim", view = "view", vim = "vim", vimdiff = "vimdiff", vimtutor = "vimtutor", xxd = "xxd" }

[envs.zjsh]
channels = ["https://prefix.dev/blooop"]
dependencies = { zjsh = "*" }
exposed = { zjsh = "zjsh" }

# wf — the wayfinder manager TUI (blooop/wayfinder): picks a ticket from any
# project's map and launches its agent tab. In the toolbox alongside the tools it
# drives (zellij and zjsh are here too; gh and claude-shim are floor), because any
# machine a person runs an agent session on can use wf to find one — and a
# container, which has no toolbox, is where wf *sends* work rather than a place it
# is ever run.
#
# Live since wf 0.1.0 published to prefix.dev/blooop (blooop/wayfinder#22).
#
# Isolated launches need `dl`, which the `.heavy` devpod env above installs and
# exposes — so on a machine without it every launch runs on the host, and wf 0.15
# says which in its launch notice rather than failing. That release also declares
# `devlaunch >=0.0.24` in its own package, so `wf` pulls a copy into this env
# whatever this manifest says; what the devpod env decides is whether you also
# get `dl` and `aid` as commands of your own.
[envs.wf]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { wf = "*" }
exposed = { wf = "wf" }

# devlaunch — the devcontainer front-end wf launches through (blooop/devlaunch):
# `dl <owner/repo@branch>` clones and containerises one branch, which is how wf
# runs N tickets in N containers without them sharing a tree.
#
# In the toolbox beside wf rather than beside devpod under .heavy, and the
# dependency is why that is safe: the package requires devpod >=0.26.1, so pixi installs
# devpod into this environment whatever the machine's flags say. The two cannot
# come apart — which matters, because wf decides to isolate a launch by testing
# whether `dl` is on PATH. A `dl` present without a working devpod would turn a
# graceful degradation to host launches into a failing one.
# This env is the single owner of `dl` and `aid`: two environments claiming one
# executable name is a sync error, so the .heavy devpod env above deliberately
# exposes neither.
#
# The bare names are the *released* build. devlaunch's AGENTS.md reserves them for
# that and puts a working copy on `dl-next`/`aid-next` (its dev.sh), so a
# half-finished edit cannot be what opens a real workspace — or what `wf` finds
# on PATH and holds to its version floor.
[envs.devlaunch]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { devlaunch = "*" }
{{- if .heavy }}
# The devpod command comes from the env above, which is the one pinned by this
# manifest rather than by devlaunch's own dependency range.
exposed = { dl = "dl", aid = "aid" }
{{- else }}
# Off .heavy there is no other devpod, so this env exposes the one it pulled in.
# Otherwise a machine could have dl and no devpod command at all — and, worse,
# `pixi global sync` would silently take away a devpod installed by hand.
exposed = { dl = "dl", aid = "aid", devpod = "devpod" }
{{- end }}

[envs.sshpass]
channels = ["conda-forge"]
dependencies = { sshpass = "*" }
exposed = { sshpass = "sshpass" }

[envs.broot]
channels = ["conda-forge"]
dependencies = { broot = "*" }
exposed = { broot = "broot" }

[envs.go]
channels = ["conda-forge"]
dependencies = { go = "*" }
exposed = { go = "go", gofmt = "gofmt" }

[envs.topgrade]
channels = ["conda-forge"]
dependencies = { topgrade = "*" }
exposed = { topgrade = "topgrade" }

[envs.isd]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { isd = "*" }
exposed = { isd = "isd", isd-tui = "isd-tui" }
{{- end }}
