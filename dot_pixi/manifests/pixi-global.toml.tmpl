[envs.uhk-agent]
channels = ["https://prefix.dev/blooop"]
dependencies = { uhk-agent = "*" }
exposed = { uhk-agent = "uhk-agent" }

# kitty-bin, not kitty: conda-forge's kitty is a stale 0.23.1 source build, so the
# blooop feedstock repackages upstream's current Linux binary under a distinct name.
# conda-forge is required here — kitty-bin depends on fontconfig.
[envs.kitty-bin]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { kitty-bin = "*" }
exposed = { kitty = "kitty", kitten = "kitten" }
{{- end }}

[envs.zellij]
channels = ["conda-forge"]
dependencies = { zellij = "*" }
exposed = { zellij = "zellij" }

# tuios — a terminal window manager trialled as the replacement for Zellij
# (blooop/dotfiles) and not adopted; Zellij's autostart is back on both ends.
# Kept installed and dormant rather than removed: `tui` still starts a session by
# hand, and the next look at it costs nothing. Its only config is the leader key
# (dot_config/tuios/config.toml); it is otherwise on its own defaults.
[envs.tuios]
channels = ["conda-forge"]
dependencies = { tuios = "*" }
exposed = { tuios = "tuios", tuios-web = "tuios-web" }

# herdr — a terminal workspace manager for coding agents (herdrdev/herdr): each
# agent gets a real terminal on a server that outlives the client, so sessions
# survive a closed laptop and can be reattached over ssh. Sits beside zellij and
# tuios rather than replacing either — those multiplex a person's shells, this
# multiplexes agents.
#
# Deliberately unconfigured: no dot_config/herdr here, so it runs on its own
# defaults until using it says what is worth setting.
#
# `herdr update` and `herdr channel set` self-update the binary in place, which
# would fight pixi for ownership of it — let `pixi global sync` do upgrades and
# leave those two alone.
[envs.herdr]
channels = ["conda-forge"]
dependencies = { herdr = "*" }
exposed = { herdr = "herdr" }

[envs.lazygit]
channels = ["conda-forge"]
dependencies = { lazygit = "*" }
exposed = { lazygit = "lazygit" }

[envs.vim]
channels = ["conda-forge"]
dependencies = { vim = "*" }
exposed = { ex = "ex", rview = "rview", rvim = "rvim", view = "view", vim = "vim", vimdiff = "vimdiff", vimtutor = "vimtutor", xxd = "xxd" }

[envs.zjsh]
channels = ["https://prefix.dev/blooop"]
dependencies = { zjsh = "*" }
exposed = { zjsh = "zjsh" }

# wf — the wayfinder manager TUI (blooop/wayfinder): picks a ticket from any
# project's map and launches its agent tab. Ungated like the tools it drives
# (zellij, gh, claude-shim, zjsh are all core), because a machine that can run
# an agent session can use wf to find one.
#
# Live since wf 0.1.0 published to prefix.dev/blooop (blooop/wayfinder#22).
#
# Isolated launches need `dl`, which the `.heavy` devpod env above installs and
# exposes — so on a machine without it every launch runs on the host, and wf 0.15
# says which in its launch notice rather than failing. That release also declares
# `devlaunch >=0.0.24` in its own package, so `wf` pulls a copy into this env
# whatever this manifest says; what the devpod env decides is whether you also
# get `dl` and `aid` as commands of your own.
[envs.wf]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { wf = "*" }
exposed = { wf = "wf" }

# devlaunch — the devcontainer front-end wf launches through (blooop/devlaunch):
# `dl <owner/repo@branch>` clones and containerises one branch, which is how wf
# runs N tickets in N containers without them sharing a tree.
#
# Ungated, beside wf rather than beside devpod under .heavy, and the dependency
# is why that is safe: the package requires devpod >=0.26.1, so pixi installs
# devpod into this environment whatever the machine's flags say. The two cannot
# come apart — which matters, because wf decides to isolate a launch by testing
# whether `dl` is on PATH. A `dl` present without a working devpod would turn a
# graceful degradation to host launches into a failing one.
# This env is the single owner of `dl` and `aid`: two environments claiming one
# executable name is a sync error, so the .heavy devpod env above deliberately
# exposes neither.
#
# The bare names are the *released* build. devlaunch's AGENTS.md reserves them for
# that and puts a working copy on `dl-next`/`aid-next` (its dev.sh), so a
# half-finished edit cannot be what opens a real workspace — or what `wf` finds
# on PATH and holds to its version floor.
[envs.devlaunch]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { devlaunch = "*" }
{{- if .heavy }}
# The devpod command comes from the env above, which is the one pinned by this
# manifest rather than by devlaunch's own dependency range.
exposed = { dl = "dl", aid = "aid" }
{{- else }}
# Off .heavy there is no other devpod, so this env exposes the one it pulled in.
# Otherwise a machine could have dl and no devpod command at all — and, worse,
# `pixi global sync` would silently take away a devpod installed by hand.
exposed = { dl = "dl", aid = "aid", devpod = "devpod" }
{{- end }}

