{{- /* Packages are gated on capability flags (.host/.heavy/.gui) set by
       .chezmoi.toml.tmpl — see the profile matrix there. */ -}}
version = 1

# === CORE TOOLS (always installed) ===

[envs.fzf]
channels = ["conda-forge"]
dependencies = { fzf = "*" }
exposed = { fzf = "fzf" }

[envs.zoxide]
channels = ["conda-forge"]
dependencies = { zoxide = "*" }
exposed = { zoxide = "zoxide" }

[envs.forgit]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { forgit = "*" }
exposed = { git-forgit = "git-forgit" }

[envs.git-delta]
channels = ["conda-forge"]
dependencies = { git-delta = "*" }
exposed = { delta = "delta" }

[envs.fd-find]
channels = ["conda-forge"]
dependencies = { fd-find = "*" }
exposed = { fd = "fd" }

[envs.ripgrep]
channels = ["conda-forge"]
dependencies = { ripgrep = "*" }
exposed = { rg = "rg" }

[envs.chezmoi]
channels = ["conda-forge"]
dependencies = { chezmoi = "*" }
exposed = { chezmoi = "chezmoi" }

[envs.gh]
channels = ["conda-forge"]
dependencies = { gh = "*" }
exposed = { gh = "gh" }

[envs.prek]
channels = ["conda-forge"]
dependencies = { prek = "*" }
exposed = { prek = "prek" }

[envs.xclip]
channels = ["conda-forge"]
dependencies = { xclip = "*" }
exposed = { xclip = "xclip", xclip-copyfile = "xclip-copyfile", xclip-cutfile = "xclip-cutfile", xclip-pastefile = "xclip-pastefile" }

[envs.jq]
channels = ["conda-forge"]
dependencies = { jq = "*" }
exposed = { jq = "jq" }

[envs.claude-shim]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { claude-shim = ">=0.3.0" }
exposed = { claude = "claude", cld = "cld", cldr = "cldr" }

{{- if .monitor }}

# === SYSTEM MONITORS (.monitor — everywhere except containers) ===

[envs.htop]
channels = ["conda-forge"]
dependencies = { htop = "*" }
exposed = { htop = "htop" }

[envs.btop]
channels = ["conda-forge"]
dependencies = { btop = "*" }
exposed = { btop = "btop" }
{{- end }}

{{- if .agents }}

# === AI CODING AGENTS (.agents — personal and shared machines) ===

[envs.codex]
channels = ["conda-forge"]
dependencies = { codex = "*" }
exposed = { codex = "codex" }

[envs.opencode-shim]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { opencode-shim = "*" }
exposed = { opencode = "opencode" }
{{- end }}

{{- if .host }}

# === HOST TOOLS (.host — personal machines and robots) ===

[envs.git-lfs]
channels = ["conda-forge"]
dependencies = { git-lfs = "*" }
exposed = { git-lfs = "git-lfs" }

[envs.git]
channels = ["conda-forge"]
dependencies = { git = "*" }
exposed = { git = "git", git-cvsserver = "git-cvsserver", git-receive-pack = "git-receive-pack", git-shell = "git-shell", git-upload-archive = "git-upload-archive", git-upload-pack = "git-upload-pack", gitk = "gitk", scalar = "scalar" }

[envs.openssh]
channels = ["conda-forge"]
dependencies = { openssh = "*" }
exposed = { scp = "scp", sftp = "sftp", ssh = "ssh", ssh-add = "ssh-add", ssh-agent = "ssh-agent", ssh-keygen = "ssh-keygen", ssh-keyscan = "ssh-keyscan", sshd = "sshd" }

[envs.curl]
channels = ["conda-forge"]
dependencies = { curl = "*" }
exposed = { curl = "curl" }

[envs.unzip]
channels = ["conda-forge"]
dependencies = { unzip = "*" }
exposed = { unzip = "unzip" }

[envs.speedtest-go]
channels = ["https://prefix.dev/blooop"]
dependencies = { speedtest-go = "*" }
exposed = { speedtest-go = "speedtest-go" }
{{- end }}

{{- if .heavy }}

# === DEV TOOLCHAINS (.heavy — personal machines) ===

[envs.ccache]
channels = ["conda-forge"]
dependencies = { ccache = "*" }
exposed = { ccache = "ccache" }

[envs.neovim]
channels = ["https://prefix.dev/github-releases", "conda-forge"]
dependencies = { neovim = "*", gcc = "*", gxx = "*" }
exposed = { nvim = "nvim" }

[envs.nodejs]
channels = ["conda-forge"]
dependencies = { nodejs = "*" }
exposed = { node = "node", npm = "npm", npx = "npx" }

[envs.pi]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { pi = "*" }
exposed = { pi = "pi" }

[envs.yq]
channels = ["conda-forge"]
dependencies = { yq = "*" }
exposed = { tomlq = "tomlq", yq = "yq", xq = "xq" }

[envs.devpod]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { devpod = "*" }
exposed = { devpod = "devpod" }

[envs.lazydocker]
channels = ["conda-forge"]
dependencies = { lazydocker = "*" }
exposed = { lazydocker = "lazydocker" }

[envs.rust]
channels = ["conda-forge"]
dependencies = { rust = "*", rust-analyzer = "*" }
exposed = { cargo = "cargo", cargo-clippy = "cargo-clippy", cargo-fmt = "cargo-fmt", clippy-driver = "clippy-driver", rust-analyzer = "rust-analyzer", rust-gdb = "rust-gdb", rust-gdbgui = "rust-gdbgui", rust-lldb = "rust-lldb", rustc = "rustc", rustdoc = "rustdoc", rustfmt = "rustfmt" }
{{- end }}

{{- if .gui }}

# === DESKTOP / GUI (.gui — personal machines) ===

[envs.nvtop]
channels = ["conda-forge"]
dependencies = { nvtop = "*" }
exposed = { nvtop = "nvtop" }

[envs.uhk-agent]
channels = ["https://prefix.dev/blooop"]
dependencies = { uhk-agent = "*" }
exposed = { uhk-agent = "uhk-agent" }

# kitty-bin, not kitty: conda-forge's kitty is a stale 0.23.1 source build, so the
# blooop feedstock repackages upstream's current Linux binary under a distinct name.
# conda-forge is required here — kitty-bin depends on fontconfig.
[envs.kitty-bin]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { kitty-bin = "*" }
exposed = { kitty = "kitty", kitten = "kitten" }
{{- end }}

[envs.zellij]
channels = ["conda-forge"]
dependencies = { zellij = "*" }
exposed = { zellij = "zellij" }

[envs.lazygit]
channels = ["conda-forge"]
dependencies = { lazygit = "*" }
exposed = { lazygit = "lazygit" }

[envs.vim]
channels = ["conda-forge"]
dependencies = { vim = "*" }
exposed = { ex = "ex", rview = "rview", rvim = "rvim", view = "view", vim = "vim", vimdiff = "vimdiff", vimtutor = "vimtutor", xxd = "xxd" }

[envs.zjsh]
channels = ["https://prefix.dev/blooop"]
dependencies = { zjsh = "*" }
exposed = { zjsh = "zjsh" }

# wf — the wayfinder manager TUI (blooop/wayfinder): picks a ticket from any
# project's map and launches its agent tab. Ungated like the tools it drives
# (zellij, gh, claude-shim, zjsh are all core), because a machine that can run
# an agent session can use wf to find one.
#
# Live since wf 0.1.0 published to prefix.dev/blooop (blooop/wayfinder#22).
[envs.wf]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { wf = "*" }
exposed = { wf = "wf" }

[envs.sshpass]
channels = ["conda-forge"]
dependencies = { sshpass = "*" }
exposed = { sshpass = "sshpass" }

[envs.broot]
channels = ["conda-forge"]
dependencies = { broot = "*" }
exposed = { broot = "broot" }

[envs.go]
channels = ["conda-forge"]
dependencies = { go = "*" }
exposed = { go = "go", gofmt = "gofmt" }

[envs.topgrade]
channels = ["conda-forge"]
dependencies = { topgrade = "*" }
exposed = { topgrade = "topgrade" }

[envs.isd]
channels = ["https://prefix.dev/blooop", "conda-forge"]
dependencies = { isd = "*" }
exposed = { isd = "isd", isd-tui = "isd-tui" }
