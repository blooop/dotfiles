# Git configuration - safe for any repository
# Always applies personal settings for DevPod, can be overridden per-repo
# Identity is gated on the .identity profile flag (see .chezmoi.toml.tmpl) and
# nothing else. An env "AGS_SHELL" guard used to sit alongside it "additionally
# protecting ags shells at apply time", and it was worse than redundant: ags
# already forces the shared profile at init (where identity is off), the guard
# made the render depend on the environment of whoever ran apply (the drift the
# profile system exists to end), and ags exports AGS_SHELL *empty* on its docker
# path, so the guard failed open exactly where it claimed to protect.
{{- if .identity }}

[user]
	name = Austin Gregg-Smith
	email = blooop@gmail.com
{{- end }}

{{- if .identity }}

# Clone github.com over SSH even when the URL says HTTPS.
#
# The problem this closes is not a preference. GitHub refuses a push that
# touches `.github/workflows/**` when the credential is an OAuth token without
# the `workflow` scope, and `gh auth login`'s default token does not have it --
# so an HTTPS remote turns "edit a workflow file" into a push that is rejected
# by the server, on a repo you own, with a message about scopes rather than
# about the file. SSH has no scope model: the key authenticates and the
# restriction does not apply.
#
# Measured 2026-09-09: two repositories cloned by hand as
# `https://github.com/blooop/...` were the only HTTPS remotes on this machine.
# Everything `dl` manages was already SSH, and `gh repo clone` honours
# `git_protocol = ssh` -- so the only way back in is a hand-typed
# `git clone https://...`, which this rewrite absorbs. It is the fix for the
# cause; repointing the two remotes was the fix for the symptom.
#
# Scoped to `personal` hosts, and by two independent gates rather than the one
# it looks like. `.identity` is also true for the `container` profile, but
# `.chezmoiignore.tmpl` skips `.gitconfig` entirely when `.gitconfig` is false
# -- which is exactly the containerish profiles -- so a container never reads
# this file at all. Within what is left, `.identity` is true only for
# `personal`, which keeps it off `shared` and `robot`, where there may be no key
# to authenticate with.
#
# DO NOT copy this block into `dot_config/git/config.tmpl`. That file is the
# container-facing fallback, deliberately applied where `~/.gitconfig` is not,
# and neither gate above protects it: DevPod injects an *HTTPS* credential as
# the intended auth path in there, so rewriting HTTPS to SSH would discard the
# credential the runtime supplied and leave the clone depending on an agent
# socket that a container is not guaranteed to have.
[url "git@github.com:"]
	insteadOf = https://github.com/
{{- end }}

[push]
	autoSetupRemote = true
	default = simple

[init]
	defaultBranch = main

[alias]
	com = checkout main
	pom = !git pull origin main --no-edit
	cam = commit -am
	pomp = !git pull origin main --no-edit && git push
	pushf = push --force-with-lease

[pull]
	rebase = false

[rebase]
	updateRefs = true

[rerere]
	enabled = true
	autoupdate = true

[submodule]
	recurse = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[lfs]
	fetchrecentalways = true
	fetchinclude = *
[safe]
	# Absolute rather than ~-relative: git does not tilde-expand safe.directory,
	# so this is rendered at apply time for whichever user is applying.
	directory = {{ .chezmoi.homeDir }}/kinisi/kinisi_ros

# Machine-specific git config (gh credential helper, etc.) lives here.
# This file is NOT tracked by chezmoi; entries here override the above.
#
# This split is load-bearing, not tidiness. `chezmoi apply --force` — which
# /sync runs on every machine — rewrites ~/.gitconfig wholesale from this
# template, so anything written directly into ~/.gitconfig is destroyed on the
# next sync with no warning (chezmoi status is clean afterwards, because the
# file then matches the source). `gh auth setup-git` writes its credential
# helper into ~/.gitconfig by default, which is exactly that trap. Point it at
# ~/.gitconfig.local instead:
#
#   git config --file ~/.gitconfig.local --add \
#     "credential.https://github.com.helper" "!$(command -v gh) auth git-credential"
#
# See "git stops authenticating over HTTPS after a /sync" in README.md.
[include]
	path = ~/.gitconfig.local
